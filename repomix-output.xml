import { useState } from "react";
import { useNavigate } from "react-router-dom";
import { Box } from "@chakra-ui/react";

import { useEquipos } from "../../../equipo/hooks/useEquipos";
import { usePlanesCalibracionMantenimientoPaginados } from "../../hooks/usePlanesCalibracionMantenimientoPaginados";
import { usePlanCalibracionMantenimientoABM } from "../../hooks/usePlanCalibracionMantenimientoABM";
import { PlanCalibracionMantenimientoTable } from "../PlanCalibracionMantenimientoTable";
import { ConfirmDialog } from "../../../../common/components/ConfirmDialog";
import type {
  PlanCalibracionMantenimiento,
  TipoPlanCalibracionMantenimiento,
} from "../../types/planCalibracionMantenimiento";
import type { ColumnaOrdenPlanCalibracion } from "../../services/planCalibracionMantenimientoService";
import { useOrdenTabla } from "../../../../common/hooks/useOrdenTabla";
import { useValorDebounced } from "../../../../common/hooks/useValorDebounced";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../../components/ui/filtros";
import {
  BannerError,
  BotonAgregar,
  EstadoCargando,
  PageHeader,
  Paginacion,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

const TIPOS_PLAN: {
  value: TipoPlanCalibracionMantenimiento;
  label: string;
}[] = [
  { value: "calibracion", label: "Calibración" },
  { value: "mantenimiento", label: "Mantenimiento" },
];

const ETIQUETAS_ORDEN: Record<ColumnaOrdenPlanCalibracion, string> = {
  equipo: "Equipo",
  tipo: "Tipo",
  intervencion: "Última intervención",
  periodicidad: "Periodicidad",
  vencimiento: "Próximo vencimiento",
};

export function PlanCalibracionMantenimientoPage() {
  const navigate = useNavigate();

  const [busqueda, setBusqueda] = useState("");
  const busquedaAplicada = useValorDebounced(busqueda);
  const [tipo, setTipo] = useState<TipoPlanCalibracionMantenimiento | "">("");
  const [equipoId, setEquipoId] = useState("");
  const orden = useOrdenTabla<
    ColumnaOrdenPlanCalibracion,
    "vencimiento_asc"
  >("vencimiento_asc", "vencimiento");

  const {
    planes,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading: cargandoPlanes,
    error: errorPlanes,
    cargarPlanes,
  } = usePlanesCalibracionMantenimientoPaginados(
    {
      buscar: busquedaAplicada,
      tipo,
      equipoId: equipoId ? Number(equipoId) : undefined,
      orden: orden.orden,
    },
    PAGE_SIZE
  );
  // Solo para resolver el nombre de equipo de cada fila: la lista completa de
  // equipos es chiquita y el backend no la incluye en cada plan.
  const {
    equipos,
    loading: cargandoEquipos,
    error: errorEquipos,
  } = useEquipos(true);
  const { borrar, loading: procesando } = usePlanCalibracionMantenimientoABM();

  const [planAEliminar, setPlanAEliminar] =
    useState<PlanCalibracionMantenimiento | null>(null);

  const nombresEquipos = new Map(
    equipos.map((equipo) => [equipo.id, equipo.nombre]),
  );

  const limpiarTodo = () => {
    setBusqueda("");
    setTipo("");
    setEquipoId("");
    orden.reiniciar();
  };

  const hayFiltros =
    busqueda.trim() !== "" ||
    tipo !== "" ||
    equipoId !== "" ||
    !orden.esPorDefecto;

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "tipo",
      etiqueta: "Tipo",
      valor: TIPOS_PLAN.find((t) => t.value === tipo)?.label ?? tipo,
      onQuitar: () => setTipo(""),
    },
    {
      clave: "equipo",
      etiqueta: "Equipo",
      valor: equipos.find((e) => String(e.id) === equipoId)?.nombre ?? equipoId,
      onQuitar: () => setEquipoId(""),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: !orden.esPorDefecto && orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  const handleEdit = (plan: PlanCalibracionMantenimiento) => {
    navigate(`/planes-calibracion-mantenimiento/${plan.id}/editar`);
  };

  const handleCloseDialog = () => {
    if (!procesando) setPlanAEliminar(null);
  };

  const handleConfirmDelete = async () => {
    if (!planAEliminar) return;
    try {
      await borrar(planAEliminar.id);
      setPlanAEliminar(null);
      await cargarPlanes();
    } catch {
      // El hook de mutación expone el estado de error a esta página.
    }
  };

  const loading = cargandoPlanes || cargandoEquipos;
  const error = errorPlanes || errorEquipos;

  return (
    <Box p="5">
      <PageHeader
        title="Planes de calibración y mantenimiento"
        description="Periodicidad de calibración y de mantenimiento por equipo, con su próximo vencimiento."
        actions={
          <BotonAgregar
            onClick={() => navigate("/planes-calibracion-mantenimiento/nuevo")}
          >
            Agregar
          </BotonAgregar>
        }
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por equipo o tipo..."
          />
        }
        filtros={
          <>
            <FiltroSelect
              label="Tipo"
              valor={tipo}
              onCambio={(valor) =>
                setTipo(valor as TipoPlanCalibracionMantenimiento | "")
              }
              opciones={TIPOS_PLAN.map((t) => ({
                valor: t.value,
                etiqueta: t.label,
              }))}
              todos="Todos"
              minW="170px"
            />
            <FiltroSelect
              label="Equipo"
              valor={equipoId}
              onCambio={setEquipoId}
              opciones={equipos.map((equipo) => ({
                valor: String(equipo.id),
                etiqueta: equipo.nombre,
              }))}
            />
          </>
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {error && <BannerError>{error}</BannerError>}
      {loading && <EstadoCargando>Cargando planes...</EstadoCargando>}
      {!loading && !error && (
        <>
          {hayFiltros && planes.length === 0 ? (
            <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
              No hay planes que coincidan con los filtros aplicados.
            </EstadoVacioFiltrado>
          ) : (
            <PlanCalibracionMantenimientoTable
              planes={planes}
              nombresEquipos={nombresEquipos}
              orden={orden}
              onEdit={handleEdit}
              onDelete={setPlanAEliminar}
            />
          )}

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}

      <ConfirmDialog
        isOpen={planAEliminar !== null}
        titulo="Eliminar plan"
        mensaje={
          planAEliminar
            ? `¿Está seguro que desea eliminar el plan ${planAEliminar.tipo === "calibracion" ? "de calibración" : "de mantenimiento"}?`
            : ""
        }
        textoConfirmar="Sí, eliminar"
        isLoading={procesando}
        onCancel={handleCloseDialog}
        onConfirm={handleConfirmDelete}
      />
    </Box>
  );
}
</file>

<file path="frontend/src/features/planCalibracionMantenimiento/components/PlanCalibracionMantenimientoItem.tsx">
import { formatoFecha } from "../../../common/utils/fechas";
import { Badge, HStack, Table } from "@chakra-ui/react";
import type { PlanCalibracionMantenimiento } from "../types/planCalibracionMantenimiento";
import { BotonAccion, Celda, TextoTruncado } from "../../../components/ui/patrones";

interface PlanCalibracionMantenimientoItemProps {
  plan: PlanCalibracionMantenimiento;
  nombreEquipo: string;
  onEdit: (plan: PlanCalibracionMantenimiento) => void;
  onDelete: (plan: PlanCalibracionMantenimiento) => void;
}

function obtenerEstado(diasRestantes: number) {
  if (diasRestantes <= 0) {
    return { etiqueta: "Vencido", color: "red" };
  }
  if (diasRestantes <= 3) {
    return { etiqueta: "Próximo a vencer", color: "orange" };
  }
  return { etiqueta: "Vigente", color: "green" };
}

export function PlanCalibracionMantenimientoItem({
  plan,
  nombreEquipo,
  onEdit,
  onDelete,
}: PlanCalibracionMantenimientoItemProps) {
  const estado = obtenerEstado(plan.dias_restantes);

  return (
    <Table.Row>
      <Celda p="3">
        <TextoTruncado texto={nombreEquipo} />
      </Celda>
      <Celda p="3">
        {plan.tipo === "calibracion" ? "Calibración" : "Mantenimiento"}
      </Celda>
      <Celda p="3">{formatoFecha(plan.fecha_ultima_intervencion)}</Celda>
      <Celda p="3">
        Cada {plan.periodicidad_dias}{" "}
        {plan.periodicidad_dias === 1 ? "día" : "días"}
      </Celda>
      <Celda p="3">{formatoFecha(plan.proxima_fecha_vencimiento)}</Celda>
      <Celda p="3" center>
        {plan.dias_restantes}
      </Celda>
      <Celda p="3" center>
        <Badge colorPalette={estado.color} rounded="md" px="2" py="1">
          {estado.etiqueta}
        </Badge>
      </Celda>
      <Celda p="3" center>
        <HStack justify="center" gap="2" flexWrap="wrap" rowGap="2">
          <BotonAccion accion="editar" label="Modificar" onClick={() => onEdit(plan)} />
          <BotonAccion accion="eliminar" label="Eliminar" onClick={() => onDelete(plan)} />
        </HStack>
      </Celda>
    </Table.Row>
  );
}
</file>

<file path="frontend/src/features/planLimpieza/components/pages/PlanLimpiezaEditPage.tsx">
import { useState } from "react";
import { useNavigate, useParams } from "react-router-dom";
import { Box } from "@chakra-ui/react";
import { PlanLimpiezaForm } from "../PlanLimpiezaForm";
import { usePlanLimpieza } from "../../hooks/usePlanLimpieza";
import { usePlanLimpiezaABM } from "../../hooks/usePlanLimpiezaABM";
import { useDelayedNavigate } from "../../../../common/hooks/useDelayedNavigate";
import type { PlanLimpiezaInput } from "../../services/planLimpiezaService";
import {
  BannerError,
  BannerExito,
  EstadoCargando,
  PageHeader,
} from "../../../../components/ui/patrones";

export function PlanLimpiezaEditPage() {
  const navigate = useNavigate();
  const delayedNavigate = useDelayedNavigate();
  const { id } = useParams<{ id: string }>();
  const planId = Number(id);

  const {
    plan,
    loading: cargando,
    error: errorCarga,
  } = usePlanLimpieza(Number.isFinite(planId) ? planId : null);
  const {
    modificar,
    loading: guardando,
    error: errorGuardado,
  } = usePlanLimpiezaABM();
  // Un solo aviso de éxito, no dos: el `DialogoExito` es modal y sin salida,
// así que el `BannerExito` de abajo quedaba oculto detrás de él durante los
// 4 segundos de la redirección y el usuario nunca leía la advertencia
// importante sobre el checklist del día.
  const [mostrarAviso, setMostrarAviso] = useState(false);

  const handleSubmit = async (values: PlanLimpiezaInput) => {
    try {
      await modificar(planId, values);
      setMostrarAviso(true);
      delayedNavigate("/planes-limpieza", 4000);
    } catch {
      // The mutation hook exposes the failure state to this page.
    }
  };

  return (
    <Box p="5" maxW="600px" mx="auto">
      <PageHeader
        title="Editar Plan de Limpieza"
        description="Los cambios rigen para los checklists que se generen desde mañana."
      />

      {mostrarAviso && (
        <BannerExito>
          Plan actualizado. Tené en cuenta que el checklist de hoy es una foto
          del plan al momento de generarse: los cambios se aplican a los
          checklists que se generen desde mañana, así los operarios no vean
          cambiar sus tareas mientras las siguen.
        </BannerExito>
      )}

      {!cargando && errorCarga && <BannerError>{errorCarga}</BannerError>}
      {cargando && <EstadoCargando>Cargando datos del plan...</EstadoCargando>}

      {!cargando && !errorCarga && plan && (
        <>
          {errorGuardado && <BannerError>{errorGuardado}</BannerError>}

          <PlanLimpiezaForm
            key={plan.id}
            initialValues={{
              nombre: plan.nombre,
              tareas: plan.tareas
                .filter((tarea) => tarea.activo)
                .map((tarea) => ({
                  id: tarea.id,
                  nombre: tarea.nombre,
                  frecuencia: tarea.frecuencia,
                  tipo: tarea.tipo,
                  descripcion: tarea.descripcion ?? "",
                  observaciones: tarea.observaciones ?? "",
                })),
              equipo_id: plan.equipo_id,
              autor_id: plan.autor_id,
            }}
            onSubmit={handleSubmit}
            isLoading={guardando}
            title="Modificar Plan de Limpieza"
            submitLabel="Guardar cambios"
            onCancel={() => navigate("/planes-limpieza")}
          />
        </>
      )}
    </Box>
  );
}
</file>

<file path="frontend/src/features/planLimpieza/components/PlanLimpiezaForm.tsx">
import { useMemo, useState } from "react";
import { Button, HStack, Stack, Textarea } from "@chakra-ui/react";
import { LuPlus, LuTrash2 } from "react-icons/lu";
import type { PlanLimpiezaInput } from "../services/planLimpiezaService";
import { TIPOS_TAREA, type TipoTarea } from "../types/planLimpieza";
import { useOpcionesPlanLimpieza } from "../hooks/useOpcionesPlanLimpieza";
import { useAuth } from "../../../common/context/useAuth";
import {
  AccionesFormulario,
  BannerError,
  BotonCancelar,
  BotonGuardar,
  FormField,
  FormInput,
  FormNativeSelect,
  MensajeError,
  SelectPlaceholder,
  TarjetaFormulario,
  TituloFormulario,
} from "../../../components/ui/patrones";
import type { SectorResumen } from "../../sector/types/sector";
interface PlanLimpiezaFormProps {
  initialValues?: PlanLimpiezaInput;
  onSubmit: (values: PlanLimpiezaInput) => Promise<void> | void;
  isLoading?: boolean;
  submitLabel?: string;
  title?: string;
  onCancel?: () => void;
}

const emptyValues: PlanLimpiezaInput = {
  nombre: "",
  tareas: [
    {
      nombre: "",
      frecuencia: 1,
      tipo: "operacional",
      descripcion: "",
      observaciones: "",
    },
  ],
  equipo_id: 0,
  autor_id: 0,
};

/**
 * El aspecto de los controles lo dan `FormInput` y `FormNativeSelect`: este
 * último arma el `NativeSelect.Root`/`Indicator` para que el desplegable
 * tenga el mismo lenguaje visual que los inputs.
 */
export function PlanLimpiezaForm({
  initialValues = emptyValues,
  onSubmit,
  isLoading = false,
  submitLabel = "Guardar",
  title = "Alta de Plan de Limpieza",
  onCancel,
}: PlanLimpiezaFormProps) {
  const { user } = useAuth();
  const [values, setValues] = useState<PlanLimpiezaInput>({
    ...initialValues,
    /*
     * El autor arranca en quien tiene la sesión abierta. Antes se pedía a
     * mano (el helper decía "el sistema todavía no tiene sesión", que ya no
     * es cierto): quedaba un select en "Seleccioná quién crea el plan" que
     * nadie notaba, y el botón de guardar deshabilitado sin explicación.
     */
    autor_id: initialValues.autor_id || user?.id || 0,
  });
  const {
    equipos,
    personal,
    loading: cargandoOpciones,
    error: errorOpciones,
  } = useOpcionesPlanLimpieza();


  const [sectorElegido, setSectorElegido] = useState<number | null>(null);

  const equipoSeleccionado = equipos.find((e) => e.id === values.equipo_id);
  const sectorId = sectorElegido ?? equipoSeleccionado?.sector_id ?? 0;

  // Sectores que realmente tienen equipos, sin repetir y ordenados.
  const sectoresDisponibles = useMemo(() => {
    const porId = new Map<number, SectorResumen>();
    equipos.forEach((equipo) => porId.set(equipo.sector.id, equipo.sector));
    return [...porId.values()].sort((a, b) => a.nombre.localeCompare(b.nombre));
  }, [equipos]);

  const equiposDelSector = equipos.filter((e) => e.sector_id === sectorId);

  const handleNombreChange = (e: React.ChangeEvent<HTMLInputElement>) =>
    setValues((prev) => ({ ...prev, nombre: e.target.value }));

  const handleEquipoChange = (e: React.ChangeEvent<HTMLSelectElement>) =>
    setValues((prev) => ({ ...prev, equipo_id: Number(e.target.value) }));

  const handleSectorChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setSectorElegido(Number(e.target.value));
    // El equipo anterior puede no pertenecer al sector nuevo.
    setValues((prev) => ({ ...prev, equipo_id: 0 }));
  };
  const handleAutorChange = (e: React.ChangeEvent<HTMLSelectElement>) =>
    setValues((prev) => ({ ...prev, autor_id: Number(e.target.value) }));

  // Las tareas ahora son propias de este plan: se cargan como una lista
  // editable, no como un <select> sobre un catálogo compartido. Cada una
  // tiene su propio nombre y su propia frecuencia (en días).
  const handleTareaNombreChange = (index: number, nombre: string) =>
    setValues((prev) => ({
      ...prev,
      tareas: prev.tareas.map((t, i) => (i === index ? { ...t, nombre } : t)),
    }));

  const handleTareaDescripcionChange = (index: number, descripcion: string) =>
    setValues((prev) => ({
      ...prev,
      tareas: prev.tareas.map((t, i) =>
        i === index ? { ...t, descripcion } : t,
      ),
    }));

  const handleTareaFrecuenciaChange = (index: number, frecuencia: number) =>
    setValues((prev) => ({
      ...prev,
      tareas: prev.tareas.map((t, i) =>
        i === index ? { ...t, frecuencia } : t,
      ),
    }));

  const handleTareaTipoChange = (index: number, tipo: TipoTarea) =>
    setValues((prev) => ({
      ...prev,
      tareas: prev.tareas.map((t, i) => (i === index ? { ...t, tipo } : t)),
    }));

  const handleTareaObservacionesChange = (index: number, observaciones: string) =>
    setValues((prev) => ({
      ...prev,
      tareas: prev.tareas.map((t, i) =>
        i === index ? { ...t, observaciones } : t,
      ),
    }));

  const handleAgregarTarea = () =>
    setValues((prev) => ({
      ...prev,
      tareas: [
        ...prev.tareas,
        {
          nombre: "",
          frecuencia: 1,
          tipo: "operacional",
          descripcion: "",
          observaciones: "",
        },
      ],
    }));

  const handleQuitarTarea = (index: number) =>
    setValues((prev) => ({
      ...prev,
      tareas:
        prev.tareas.length > 1
          ? prev.tareas.filter((_, i) => i !== index)
          : prev.tareas,
    }));

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSubmit(values);
  };

  /*
   * Lo que falta para poder guardar, en una sola fuente de verdad: el botón
   * se deshabilita con esta lista y el mensaje de abajo la muestra. Antes
   * el botón quedaba grisado sin decir por qué, y no se entendía qué
   * faltaba completar.
   */
  const faltantes: string[] = [];
  if (!values.nombre.trim()) faltantes.push("el nombre del plan");
  values.tareas.forEach((tarea, indice) => {
    if (!tarea.nombre.trim()) faltantes.push(`el nombre de la tarea ${indice + 1}`);
    if (!tarea.frecuencia || tarea.frecuencia <= 0)
      faltantes.push(`la frecuencia de la tarea ${indice + 1}`);
  });
  if (!sectorId) faltantes.push("el sector");
  else if (!values.equipo_id) faltantes.push("el equipo");
  if (!values.autor_id) faltantes.push("el autor");

  return (
    <TarjetaFormulario as="form" onSubmit={handleSubmit}>
      <TituloFormulario>{title}</TituloFormulario>

      {errorOpciones && <BannerError>{errorOpciones}</BannerError>}

      <FormField label="Nombre" required mb="4">
        <FormInput
          value={values.nombre}
          onChange={handleNombreChange}
          placeholder="Ej: Limpieza diaria de heladeras"
          maxW="500px"
        />
      </FormField>

      {/*
        Tareas, cada una con su propia frecuencia.

        Los controles de cada tarea ocupan todo el ancho del recuadro. Antes
        venían con `maxW="500px"`, que es el ancho pensado para un campo de
        formulario suelto: como acá cada tarea ya es un recuadro anidado,
        quedaban pegados al borde izquierdo con medio recuadro de aire a la
        derecha.
      */}
      <FormField label="Tareas" required mb="4">
        {/*
          `w="100%"` explícito: `Field.Root` usa `align-items: flex-start`, así
          que un `Stack` sin ancho se ajusta al contenido y las tareas quedan
          angostas contra el borde izquierdo.
        */}
        <Stack gap="4" w="100%">
          {values.tareas.map((tarea, index) => (
            <Stack
              key={index}
              gap="4"
              p="4"
              w="100%"
              bg="bg.subtle"
              borderWidth="1px"
              borderColor="border.subtle"
              rounded="lg"
            >
              <FormField label="Nombre de la tarea" mb="0">
                <FormInput
                  value={tarea.nombre}
                  onChange={(e) =>
                    handleTareaNombreChange(index, e.target.value)
                  }
                  placeholder={`Ej: Limpiar bandeja ${index + 1}`}
                />
              </FormField>

              <FormField
                label="Frecuencia en días"
                helper="Cada cuántos días se repite."
                mb="0"
              >
                <FormInput
                  type="number"
                  min={1}
                  value={tarea.frecuencia}
                  onChange={(e) =>
                    handleTareaFrecuenciaChange(index, Number(e.target.value))
                  }
                  placeholder="Frecuencia (días)"
                  title="Frecuencia en días"
                />
              </FormField>

              {/*
                El tipo y las observaciones se editan junto al resto de la
                tarea: son parte de la definición, no un dato derivado.
              */}
              <FormField
                label="Tipo de tarea"
                helper="Define en qué momento del proceso se ejecuta."
                mb="0"
              >
                <FormNativeSelect
                  value={tarea.tipo}
                  onChange={(e) =>
                    handleTareaTipoChange(index, e.target.value as TipoTarea)
                  }
                  maxW="300px"
                >
                  {TIPOS_TAREA.map((opcion) => (
                    <option key={opcion.value} value={opcion.value}>
                      {opcion.label}
                    </option>
                  ))}
                </FormNativeSelect>
              </FormField>

              <FormField label="Procedimiento (opcional)" mb="0">
                <Textarea
                  value={tarea.descripcion ?? ""}
                  onChange={(e) =>
                    handleTareaDescripcionChange(index, e.target.value)
                  }
                  placeholder={
                    "Ej:\n1. Desconectar la energía eléctrica.\n2. Retirar residuos..."
                  }
                  rows={4}
                  resize="vertical"
                />
              </FormField>

              <FormField
                label="Observaciones (opcional)"
                helper="Se muestran al lado de la tarea en el checklist del día."
                mb="0"
              >
                <Textarea
                  value={tarea.observaciones ?? ""}
                  onChange={(e) =>
                    handleTareaObservacionesChange(index, e.target.value)
                  }
                  placeholder="Ej: Usar guantes y verificar la temperatura antes de empezar."
                  rows={2}
                  resize="vertical"
                />
              </FormField>

              <HStack justify="flex-end">
                <BotonCancelar
                  aria-label={`Quitar tarea ${index + 1}`}
                  onClick={() => handleQuitarTarea(index)}
                  disabled={values.tareas.length === 1}
                >
                  <LuTrash2 aria-hidden />
                  Quitar tarea
                </BotonCancelar>
              </HStack>
            </Stack>
          ))}
        </Stack>
      </FormField>

      <Button
        type="button"
        variant="outline"
        colorPalette="brand"
        size="sm"
        mb="6"
        onClick={handleAgregarTarea}
      >
        <LuPlus aria-hidden />
        Agregar tarea
      </Button>

            <FormField label="Sector" required mb="4">
        <FormNativeSelect
          value={sectorId}
          onChange={handleSectorChange}
          disabled={cargandoOpciones}
          maxW="500px"
        >
          <SelectPlaceholder value={0}>
            {cargandoOpciones ? "Cargando..." : "Seleccioná un sector"}
          </SelectPlaceholder>
          {sectoresDisponibles.map((sector) => (
            <option key={sector.id} value={sector.id}>
              {sector.nombre}
            </option>
          ))}
        </FormNativeSelect>
      </FormField>

      <FormField
        label="Equipo"
        required
        helper="Solo se muestran los equipos del sector elegido."
        mb="4"
      >
        <FormNativeSelect
          value={values.equipo_id}
          onChange={handleEquipoChange}
          disabled={cargandoOpciones || !sectorId}
          maxW="500px"
        >
          <SelectPlaceholder value={0}>
            {cargandoOpciones
              ? "Cargando..."
              : !sectorId
                ? "Primero elegí un sector"
                : equiposDelSector.length === 0
                  ? "Este sector no tiene equipos"
                  : "Seleccioná un equipo"}
          </SelectPlaceholder>
          {equiposDelSector.map((equipo) => (
            <option key={equipo.id} value={equipo.id}>
              {equipo.nombre}
            </option>
          ))}
        </FormNativeSelect>
      </FormField>

      <FormField
        label="Autor"
        required
        helper="Arranca en quien tiene la sesión abierta; podés cambiarlo si el plan lo firma otra persona."
        mb="0"
      >
        <FormNativeSelect
          value={values.autor_id}
          onChange={handleAutorChange}
          disabled={cargandoOpciones}
          maxW="500px"
        >
          <SelectPlaceholder value={0}>
            {cargandoOpciones ? "Cargando..." : "Seleccioná quién crea el plan"}
          </SelectPlaceholder>
          {/*
            Solo se ofrecen quienes pueden administrar: el backend rechaza
            a cualquier otro como autor (`AUTOR_SIN_PERMISO_DE_ADMINISTRAR`,
            "Se requiere permiso de administrar..."). Antes la lista traía a
            todo el personal, se podía elegir a un operador, y el rechazo
            aparecía recién al guardar.
          */}
          {personal
            .filter(
              (persona) => persona.puede_administrar || persona.es_super_admin,
            )
            .map((persona) => (
              <option key={persona.id} value={persona.id}>
                {persona.nombre} {persona.apellido || ""}
              </option>
            ))}
        </FormNativeSelect>
      </FormField>

      {/*
       * El aviso de qué falta va pegado a los botones: es lo que explica
       * un "Guardar" deshabilitado, que por sí solo no dice nada.
       */}
      {faltantes.length > 0 && (
        <MensajeError mb="4">
          Para guardar falta completar: {faltantes.join(", ")}.
        </MensajeError>
      )}

      <AccionesFormulario>
        <BotonGuardar
          loading={isLoading}
          disabled={faltantes.length > 0}
        >
          {submitLabel}
        </BotonGuardar>
        {onCancel && <BotonCancelar onClick={onCancel}>Cancelar</BotonCancelar>}
      </AccionesFormulario>
    </TarjetaFormulario>
  );
}
</file>

<file path="frontend/src/features/planLimpieza/components/PlanLimpiezaItem.tsx">
import { HStack, Table } from "@chakra-ui/react";
import type { PlanLimpieza } from "../types/planLimpieza";
import { BotonAccion, Celda, TextoTruncado } from "../../../components/ui/patrones";

interface PlanLimpiezaItemProps {
  plan: PlanLimpieza;
  nombreEquipo: string;
  nombreSector: string;
  onEdit: (plan: PlanLimpieza) => void;
  onDelete: (plan: PlanLimpieza) => void;
  onReactivar: (plan: PlanLimpieza) => void;
}

export function PlanLimpiezaItem({
  plan,
  nombreEquipo,
  nombreSector,
  onEdit,
  onDelete,
  onReactivar,
}: PlanLimpiezaItemProps) {
  return (
    <Table.Row opacity={plan.activo ? 1 : 0.65}>
      <Celda p="3">
        <TextoTruncado texto={plan.nombre} />
      </Celda>
      <Celda p="3">
        {/*
         * La lista de tareas concatenadas puede pasar los 200 caracteres: sin
         * tope, esta celda era la que más engordaba la fila.
         */}
        <TextoTruncado
          max={60}
          texto={plan.tareas
            .map(
              (tarea) =>
                `${tarea.nombre} (cada ${tarea.frecuencia} ${tarea.frecuencia === 1 ? "día" : "días"})`,
            )
            .join(", ")}
        />
      </Celda>
      <Celda p="3">
        <TextoTruncado texto={nombreSector} />
      </Celda>
      <Celda p="3">
        <TextoTruncado texto={nombreEquipo} />
      </Celda>
      <Celda p="3" center>
        <HStack justify="center" gap="2" flexWrap="wrap" rowGap="2">
          {plan.activo ? (
            <>
              <BotonAccion accion="editar" label="Modificar" onClick={() => onEdit(plan)} />
              <BotonAccion accion="eliminar" label="Eliminar" onClick={() => onDelete(plan)} />
            </>
          ) : (
            <BotonAccion accion="reactivar" label="Reactivar" onClick={() => onReactivar(plan)} />
          )}
        </HStack>
      </Celda>
    </Table.Row>
  );
}
</file>

<file path="frontend/src/features/planLimpieza/components/PlanLimpiezaTable.tsx">
import { Table } from "@chakra-ui/react";
import { PlanLimpiezaItem } from "./PlanLimpiezaItem";
import type { EquipoOption, PlanLimpieza } from "../types/planLimpieza";
import type { ColumnaOrdenPlanLimpieza } from "../services/planLimpiezaService";
import type { OrdenTabla } from "../../../common/hooks/useOrdenTabla";
import { EncabezadoOrdenable } from "../../../components/ui/filtros";
import {
  EncabezadoOscuro,
  EstadoVacio,
  FilaEncabezado,
  Tarjeta,
} from "../../../components/ui/patrones";

interface PlanLimpiezaTableProps {
  planes: PlanLimpieza[];
  equipos: EquipoOption[];
  orden: OrdenTabla<ColumnaOrdenPlanLimpieza, string>;
  onEdit: (plan: PlanLimpieza) => void;
  onDelete: (plan: PlanLimpieza) => void;
  onReactivar: (plan: PlanLimpieza) => void;
}

export function PlanLimpiezaTable({
  planes,
  equipos,
  orden,
  onEdit,
  onDelete,
  onReactivar,
}: PlanLimpiezaTableProps) {
  if (planes.length === 0) {
    return <EstadoVacio>No hay planes de limpieza cargados.</EstadoVacio>;
  }

  const nombreEquipo = (id: number) =>
    equipos.find((e) => e.id === id)?.nombre || `#${id}`;

  // El sector del plan es el del equipo al que pertenece.
  const nombreSector = (id: number) =>
    equipos.find((e) => e.id === id)?.sector.nombre || "—";

  return (
    <Tarjeta overflowX="auto">
      <Table.Root variant="outline" w="100%" minW="860px">
        <Table.Header>
          <FilaEncabezado>
            <EncabezadoOrdenable columna="nombre" orden={orden}>
              Nombre
            </EncabezadoOrdenable>
            <EncabezadoOscuro ancho="amplia">Tareas (frecuencia)</EncabezadoOscuro>
            <EncabezadoOscuro ancho="media">Sector</EncabezadoOscuro>
            <EncabezadoOrdenable columna="equipo" orden={orden} ancho="media">
              Equipo
            </EncabezadoOrdenable>
            <EncabezadoOscuro center ancho="accionesAnchas">Acciones</EncabezadoOscuro>
          </FilaEncabezado>
        </Table.Header>
        <Table.Body>
          {planes.map((plan) => (
            <PlanLimpiezaItem
              key={plan.id}
              plan={plan}
              nombreSector={nombreSector(plan.equipo_id)}
              nombreEquipo={nombreEquipo(plan.equipo_id)}
              onEdit={onEdit}
              onDelete={onDelete}
              onReactivar={onReactivar}
            />
          ))}
        </Table.Body>
      </Table.Root>
    </Tarjeta>
  );
}
</file>

<file path="backend/src/checklist/router.py">
import logging
from datetime import date
from typing import Optional, List, Literal, Union

from fastapi import APIRouter, Depends, Query, File, UploadFile, Form, HTTPException
from sqlalchemy.orm import Session

from src.common.paginacion import PAGE_SIZE_MAXIMO, PAGE_SIZE_POR_DEFECTO
from src.common.archivos import guardar_archivo
from src.database import get_db
from src.auth.dependencies import require_operador, require_admin
from src.checklist import schemas, services
from src.tareas.models import Tarea
from src.personal.models import Personal


logger = logging.getLogger(__name__)

router = APIRouter(prefix="/checklist", tags=["checklist"])

# Ver el checklist del día y el historial de una tarea: requiere poder operar
# (HU "Ver checklist del día", "Marcar tarea con evidencia", "Registrar autoría").
_DEP_OPERAR = [Depends(require_operador)]

# Historial de checklists y consumo acumulado: solo quien administra
# (HU "Consultar historial de checklists" y "Registrar consumo de productos").
_DEP_ADMIN = [Depends(require_admin)]

# Extensiones y tamaño máximo permitido para la evidencia fotográfica.
EXTENSIONES_EVIDENCIA = {".jpg", ".jpeg", ".png", ".webp", ".gif"}
TAMANO_MAX_EVIDENCIA = 5 * 1024 * 1024  # 5 MB


@router.get("/tareas-del-dia", response_model=schemas.TareasDelDiaResponse, dependencies=_DEP_OPERAR)
def listar_tareas_del_dia(

    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
):
    """Lista plana de las tareas de todos los equipos activos para una fecha,
    con el nombre del plan al que pertenece cada una. Reemplaza el patrón de
    pedir /checklist/hoy una vez por equipo desde el frontend."""
    logger.info(f"Consultando tareas del día para fecha {fecha}")
    return services.listar_tareas_del_dia(db, fecha)


@router.get("/equipo/{equipo_id}", response_model=List[schemas.ChecklistResponse], dependencies=_DEP_OPERAR)
def obtener_checklists_del_equipo(
    equipo_id: int,
    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
):
    """Uno o varios checklists (uno por plan vigente) para un equipo/máquina
    en una fecha puntual."""
    return services.obtener_o_crear_checklists_del_dia(db, equipo_id, fecha)

@router.patch("/tarea/{tarea_id}", response_model=schemas.RegistroTareaResponse, dependencies=_DEP_OPERAR)
def marcar_tarea(
    tarea_id: int,
    completado: bool = Form(...),
    evidencia: Optional[UploadFile] = File(None),

    # NUEVOS CAMPOS PARA EL CONSUMO
    insumo_quimico_id: Optional[int] = Form(None),
    cantidad_consumida: Optional[float] = Form(None, gt=0),
    elemento_limpieza_id: Optional[int] = Form(None),
    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
    # La autoría se toma del token: nunca del cuerpo de la request, para que
    # no se pueda atribuir una tarea a otro usuario (HU "Registrar autoría").
    current_user: Personal = Depends(require_operador),
):
    # Validar existencia de tarea antes de guardar archivo
    tarea = db.get(Tarea, tarea_id)
    if not tarea:
        raise HTTPException(status_code=404, detail="Tarea no encontrada")

    ruta_evidencia = None
    if evidencia is not None and evidencia.filename:
        prefijo = f"tarea_{tarea_id}"
        ruta_evidencia = guardar_archivo(
            evidencia,
            EXTENSIONES_EVIDENCIA,
            TAMANO_MAX_EVIDENCIA,
            prefijo,
            "evidencias"
        )

    try:
        return services.marcar_tarea(
            db=db,
            tarea_id=tarea_id,
            completado=completado,
            usuario_id=current_user.id,
            usuario_nombre=f"{current_user.nombre} {current_user.apellido or ''}".strip(),
            evidencia_url=ruta_evidencia,
            fecha=fecha,
            insumo_quimico_id=insumo_quimico_id,
            cantidad_consumida=cantidad_consumida,
            elemento_limpieza_id=elemento_limpieza_id,
        )
    except Exception:
        # Eliminar archivo huérfano si el servicio falla
        if ruta_evidencia:
            from src.config import CARPETA_UPLOADS
            ruta_abs = CARPETA_UPLOADS / ruta_evidencia.removeprefix("uploads/")
            try:
                ruta_abs.unlink(missing_ok=True)
            except Exception:
                pass
        raise


@router.get("/registro/{registro_id}/historial", response_model=schemas.HistorialRegistroTareaResponse, dependencies=_DEP_OPERAR)
def obtener_historial_registro(registro_id: int, db: Session = Depends(get_db)):
    return services.obtener_historial_registro(db, registro_id)

@router.get(
    "/historial",
    response_model=Union[schemas.HistorialChecklistResponse, schemas.HistorialChecklistPagina],
