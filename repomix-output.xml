    fecha: date
    equipo_id: int
    equipo_nombre: str
    estado: EstadoChecklist
    total_tareas: int
    tareas_completadas: int
    porcentaje_cumplimiento: float
    tareas: List[DetalleChecklistTareaItem]


class ConsumoInsumoItem(BaseModel):
