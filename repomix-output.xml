import type { Sector } from "../types/sector";
import { pedir } from "../../../common/api/errors";
import { apiFetch, API_URL } from "../../../common/api/apiClient";
import { queryPagina, type Pagina } from "../../../common/api/paginacion";

export async function listarSectores(incluirInactivos = false): Promise<Sector[]> {
  const query = incluirInactivos ? "?incluir_inactivos=true" : "";
  const response = await apiFetch(`${API_URL}/sectores${query}`);

  return pedir<Sector[]>(response, "Error al obtener los sectores");
}

/**
 * Página de sectores para la tabla (paginación server-side). La lista
 * completa (`listarSectores`) sigue existiendo para los dropdowns de
 * formularios, que necesitan todas las opciones de una vez.
 */

export type ColumnaOrdenSector = "nombre" | "descripcion";
export type OrdenSector =
  | `${ColumnaOrdenSector}_asc`
  | `${ColumnaOrdenSector}_desc`;

export interface FiltrosSectores {
  incluirInactivos?: boolean;
  buscar?: string;
  orden?: OrdenSector;
}

export async function listarSectoresPaginados(
  page: number,
  pageSize: number,
  filtros: FiltrosSectores = {}
): Promise<Pagina<Sector>> {
  const query = queryPagina(page, pageSize, {
    incluir_inactivos: filtros.incluirInactivos || undefined,
    buscar: filtros.buscar?.trim() || undefined,
    orden: filtros.orden,
  });
  const response = await apiFetch(`${API_URL}/sectores${query}`);

  return pedir<Pagina<Sector>>(response, "Error al obtener los sectores");
}

export async function crearSector(
  datos: Omit<Sector, "id" | "activo">
): Promise<Sector> {
  const response = await apiFetch(`${API_URL}/sectores`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(datos),
  });

  return pedir<Sector>(response, "Error al crear el sector");
}

export async function modificarSector(
  id: number,
  datos: Partial<Omit<Sector, "id">>
): Promise<Sector> {
  const response = await apiFetch(`${API_URL}/sectores/${id}`, {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(datos),
  });

  return pedir<Sector>(response, "Error al modificar el sector");
}

export async function eliminarSector(id: number): Promise<Sector> {
  const response = await apiFetch(`${API_URL}/sectores/${id}`, {
    method: "DELETE",
  });

  return pedir<Sector>(response, "Error al eliminar el sector");
}

export async function reactivarSector(
  id: number,
  datos: Omit<Sector, "id" | "activo">
): Promise<Sector> {
  return modificarSector(id, { ...datos, activo: true });
}

export async function obtenerSector(id: number): Promise<Sector> {
  const response = await apiFetch(`${API_URL}/sectores/${id}`);
  return pedir<Sector>(response, "Error al obtener el sector");
}
</file>

<file path="frontend/src/features/vencimientoPersonal/hooks/useVencimientosPersonal.ts">
import { useState, useEffect, useCallback } from "react";
import {
  listarVencimientosDePersona,
  crearVencimiento,
  actualizarVencimiento,
  eliminarVencimiento,
} from "../services/vencimientoPersonalService";
import type { VencimientoPersonal } from "../types/vencimientoPersonal";

// Clave = aptitud_id, valor = fecha de vencimiento ("YYYY-MM-DD")
export type VencimientosPorAptitud = Record<number, string>;

export function useVencimientosPersonal(personaId: number | null) {
  const [vencimientos, setVencimientos] = useState<VencimientoPersonal[]>([]);
  const [loading, setLoading] = useState(false);
  const [guardando, setGuardando] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const cargar = useCallback(async () => {
    if (!personaId) {
      setVencimientos([]);
      return;
    }
    try {
      setLoading(true);
      setError(null);
      const datos = await listarVencimientosDePersona(personaId);
      setVencimientos(datos);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Error al cargar vencimientos");
    } finally {
      setLoading(false);
    }
  }, [personaId]);

  useEffect(() => {
    const timeoutId = window.setTimeout(cargar, 0);
    return () => window.clearTimeout(timeoutId);
  }, [cargar]);

  const guardarVencimientos = async (
    idPersona: number,
    valores: VencimientosPorAptitud
  ) => {
    try {
      setGuardando(true);
      setError(null);

      const aptitudesEnValores = new Set(Object.keys(valores).map(Number));

      // Las que estaban cargadas antes pero ya no están en "valores" -> se dan de baja
      const aEliminar = vencimientos.filter(
        (v) => !aptitudesEnValores.has(v.aptitud_id)
      );

      // Las que están presentes (con fecha) -> se crean o actualizan
      const operaciones = Object.entries(valores)
        .filter(([, fecha]) => fecha)
        .flatMap(([aptitudIdStr, fecha]) => {
          const aptitudId = Number(aptitudIdStr);
          const existente = vencimientos.find((v) => v.aptitud_id === aptitudId);

          if (!existente) {
            return [
              crearVencimiento({
                persona_id: idPersona,
                aptitud_id: aptitudId,
                fecha_vencimiento: fecha,
              }),
            ];
          }

          // Si la fecha no cambió no se manda nada (el backend rechaza fechas pasadas).
          if (existente.fecha_vencimiento === fecha) return [];

          return [actualizarVencimiento(existente.id, { fecha_vencimiento: fecha })];
        });

      await Promise.all([
        ...operaciones,
        ...aEliminar.map((v) => eliminarVencimiento(v.id)),
      ]);

      await cargar();
    } catch (err) {
      await cargar(); // OPCIONAL: vuelve a leer lo que realmente quedó guardado
      setError(err instanceof Error ? err.message : "Error al guardar los vencimientos");
      throw err;
    } finally {
      setGuardando(false);
    }
  };

  return { vencimientos, loading, guardando, error, guardarVencimientos, recargar: cargar };
}
