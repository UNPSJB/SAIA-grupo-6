 */
export const estiloInputCompacto: CSSProperties = {
  backgroundColor: BLANCO,
  padding: "10px 14px",
  borderRadius: "8px",
  border: `2px solid ${TEAL_CLARO}`,
  fontSize: "15px",
  color: TEXTO_PRIMARIO,
};

/** Label de formulario. */
export const estiloLabel: CSSProperties = {
  display: "block",
  fontSize: "14px",
  fontWeight: "bold",
  marginBottom: "8px",
  color: TEXTO_SECUNDARIO,
};
