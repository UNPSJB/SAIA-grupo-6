def _principal(sentencias):
    """La consulta principal del listado: SELECT sobre `checklists` con LIMIT."""
    return [
        (s, p) for s, p in sentencias
        if re.search(r"\bFROM checklists\b", s)
        and "LIMIT" in s
        and "count(" not in s.lower()
    ]


