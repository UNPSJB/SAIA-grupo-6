               * pantalla. `inline-block` es lo que deja aplicar elipsis a
               * un span dentro del encabezado.
               */}
              Historial:{" "}
              <TextoTruncado
                as="span"
                display="inline-block"
                verticalAlign="bottom"
                texto={historial.nombre}
                max={40}
              />
            </>
          ) : (
            "Historial"
          )
