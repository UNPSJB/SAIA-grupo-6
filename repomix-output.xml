    }
  };

  return (
    <Box p="5" maxW="600px" mx="auto">
      <PageHeader
        title="Editar sector"
        actions={
          <BotonVolver onClick={() => navigate("/sectores")}>
            Volver a la lista
          </BotonVolver>
        }
      />

      {!cargando && errorCarga && <BannerError>{errorCarga}</BannerError>}
      {cargando && (
