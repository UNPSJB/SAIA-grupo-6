def check(desc, cond):
    if cond:
        print(f"  ok  {desc}")
    else:
        fallos.append(desc)
        print(f"  FALLA {desc}")


def check_raises(desc, fn, exc):
    try:
        fn()
    except exc:
        check(desc, True)
        return
    except Exception as e:  # noqa: BLE001
        check(desc, False)
        print(f"        (lanzó {type(e).__name__}: {e})")
        return
    check(desc, False)
    print("        (no lanzó)")


