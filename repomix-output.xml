import { useCallback, useEffect, useRef, useState } from "react";

import type { Pagina } from "../api/paginacion";

/**
 * Carga de un listado con la paginación resuelta en el SERVIDOR.
 *
 * Es la contraparte paginada de `useLista`: en vez de traer todo y recortar
 * en el navegador (`usePaginas`), le pasa `page`/`page_size` al service y
 * solo guarda las filas de la página más el total. Para el usuario se ve
 * igual que antes (mismo componente `Paginacion`), pero la tabla ya no pide
 * miles de filas para mostrar 10.
 *
 * Contrato igual al de `useLista`: `cargar` tiene que venir memoizada con
 * `useCallback`, porque su identidad es dependencia del efecto que pide los
 * datos. Y el `setTimeout(..., 0)` de siempre: sin él, con `React.StrictMode`
 * el montaje de desarrollo dispara el efecto dos veces seguidas.
 *
 * Cuando cambia cualquier `dependencia` (un filtro, el switch de inactivos)
 * se vuelve a la página 1. Es el mismo "ajustar estado durante el render"
 * de `usePaginas`: así el efecto dispara una sola vez, ya con la página
 * correcta, sin renders con la tabla vacía de por medio.
 *
 * ```
 * const { items, total, page, setPage, hayVariasPaginas, loading, error } =
 *   useListaPaginada({
 *     cargar: listarInsumosPaginados,
 *     dependencias: [verInactivos],
 *     valorInicial: [],
 *     mensajeError: "No se pudieron cargar los insumos",
 *   });
 * ```
 */
export interface OpcionesListaPaginada<T> {
  /** Pide una página al backend: recibe (page, pageSize) y devuelve el sobre `Pagina`. */
  cargar: (page: number, pageSize: number) => Promise<Pagina<T>>;
  /** Lo que hay que mirar para volver a pedir desde la página 1 (filtros, fechas, ...). */
  dependencias: readonly unknown[];
  /** Con qué se arma `items` mientras llega la primera respuesta. */
  valorInicial: T[];
  /** Qué se le muestra al usuario si el listado falla. */
  mensajeError: string;
  /** Filas por página. */
  pageSize?: number;
}

export function useListaPaginada<T>(opciones: OpcionesListaPaginada<T>) {
  const { cargar, dependencias, valorInicial, mensajeError, pageSize = 10 } =
    opciones;

  const [items, setItems] = useState<T[]>(valorInicial);
  const [total, setTotal] = useState(0);
  const [paginaPedida, setPaginaPedida] = useState(1);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Carrera de respuestas (misma idea que `useLista`): si se pide la página 2
  // y enseguida la 3, y la 3 resuelve primero, la respuesta tardía de la 2 no
  // puede pisar `items` ni `total` ni apagar `loading`.
  const ultimoPedido = useRef(0);

  const resetKey = JSON.stringify(dependencias);
  const [resetKeyVisto, setResetKeyVisto] = useState(resetKey);
  if (resetKey !== resetKeyVisto) {
    setResetKeyVisto(resetKey);
    setPaginaPedida(1);
  }

  /*
   * La página pedida se recorta contra el total de la última respuesta en vez
   * de corregir el estado: si el filtro se acotó (o se borró la última fila
   * de la última página) y la página actual quedó afuera, `page` baja solo al
   * último valor válido y el efecto de abajo vuelve a pedir. Es el mismo
   * "recortar, no corregir" que hace `usePaginas`.
   *
   * Esto también recupera la página fuera de rango: con `total > 0` el
   * backend responde `items` vacíos, `totalPaginas` baja, `page` se ajusta
   * y el efecto re-fetch dispara la última página válida — el usuario nunca
   * queda mirando una tabla vacía sin paginación.
   */
  const totalPaginas = Math.max(1, Math.ceil(total / pageSize));
  const page = Math.min(paginaPedida, totalPaginas);

  const recargar = useCallback(
    async (pagina?: number) => {
      const pedido = ++ultimoPedido.current;
      try {
        setLoading(true);
        setError(null);

        const respuesta = await cargar(pagina ?? page, pageSize);
        if (pedido !== ultimoPedido.current) return; // llegó tarde: se descarta
        setItems(respuesta.items);
        setTotal(respuesta.total);
      } catch (err) {
        if (pedido !== ultimoPedido.current) return;
        // Igual que `useABM`: si el backend explicó el fallo, ese mensaje es
        // el que sirve; el texto genérico es la red de seguridad.
        setError(
          err instanceof Error ? err.message : mensajeError
        );
      } finally {
        // Solo el último pedido apaga el spinner (ver `useLista`).
        if (pedido === ultimoPedido.current) setLoading(false);
      }
    },
    [cargar, mensajeError, pageSize, page]
  );

  useEffect(() => {
    const timeoutId = window.setTimeout(() => {
      void recargar();
    }, 0);

    return () => window.clearTimeout(timeoutId);
    // `dependencias` son los filtros que declara el hook que llama a este,
    // no una constante: eslint no los puede verificar.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [recargar, ...dependencias]);

  const setPage = useCallback((nueva: number) => setPaginaPedida(nueva), []);
  const primeraPagina = useCallback(() => setPaginaPedida(1), []);

  return {
    items,
    /** Total de filas del filtrado completo: es el `count` de `Paginacion`. */
    total,
    page,
    setPage,
    /** Alias de `setPage` para los call sites que usan el nombre de la acción. */
    irAPagina: setPage,
    primeraPagina,
    totalPaginas,
    hayVariasPaginas: totalPaginas > 1,
    loading,
    error,
    /** Re-pide la página actual (para después de una mutación). */
    recargar,
  };
}
</file>

<file path="frontend/src/common/hooks/useOrdenTabla.ts">
import { useCallback, useEffect, useRef, useState } from "react";

export type DireccionOrden = "asc" | "desc";

export type ClaveOrden<C extends string> = `${C}_asc` | `${C}_desc`;

export interface OrdenTabla<
  C extends string,
  D extends string = ClaveOrden<C>,
> {
  columna: C | null;
  direccion: DireccionOrden;
  orden: ClaveOrden<C> | D;
  esPorDefecto: boolean;
  ordenar: (columna: C) => void;
  reiniciar: () => void;
}

/**
 * Orden por columna para listados del servidor.
 * `columnaPorDefecto` marca el header activo al abrir (p. ej. próximo vencimiento).
 * `alCambiar` suele ser `() => setPage(1)` cuando la página maneja el page a mano.
 */
export function useOrdenTabla<
  C extends string,
  D extends string = ClaveOrden<C>,
>(
  porDefecto: D,
  columnaPorDefecto?: C,
  alCambiar?: () => void,
): OrdenTabla<C, D> {
  const direccionPorDefecto: DireccionOrden = porDefecto.endsWith("_desc")
    ? "desc"
    : "asc";

  const alCambiarRef = useRef(alCambiar);
  useEffect(() => {
    alCambiarRef.current = alCambiar;
  }, [alCambiar]);

  const [estado, setEstado] = useState<{
    columna: C | null;
    direccion: DireccionOrden;
  }>(() => ({
    columna: columnaPorDefecto ?? null,
    direccion: direccionPorDefecto,
  }));

  const ordenar = useCallback((nueva: C) => {
    setEstado((actual) =>
      actual.columna === nueva
        ? {
            columna: nueva,
            direccion: actual.direccion === "asc" ? "desc" : "asc",
          }
        : { columna: nueva, direccion: "asc" },
    );
    alCambiarRef.current?.();
  }, []);

  const reiniciar = useCallback(() => {
    setEstado({
      columna: columnaPorDefecto ?? null,
      direccion: direccionPorDefecto,
    });
    alCambiarRef.current?.();
  }, [columnaPorDefecto, direccionPorDefecto]);

  return {
    columna: estado.columna,
    direccion: estado.direccion,
    orden: estado.columna
      ? (`${estado.columna}_${estado.direccion}` as ClaveOrden<C>)
      : porDefecto,
    esPorDefecto:
      estado.columna === (columnaPorDefecto ?? null) &&
      estado.direccion === direccionPorDefecto,
    ordenar,
    reiniciar,
  };
}
</file>

<file path="frontend/src/common/hooks/usePaginas.ts">
import { useCallback, useMemo, useState } from "react";

/**
 * Pagina una lista que ya viene filtrada.
 *
 * Es la base de toda la paginación de la app. No sabe nada de `activo`: la
 * lista que recibe ya viene filtrada por el hook o el servicio de la feature.
 * Para el caso de los catálogos que además filtran por baja lógica está
 * `usePaginacion`, queenvuelve a esta.
 *
 * `resetKey` es lo que hace que la paginación no se rompa al cambiar un filtro:
 * si el contenido se acota (por ejemplo, de 12 equipos a 1) y seguís en la
 * página 3, la tabla queda vacía sin explicación. El key es una cadena con los
 * filtros que apliquen; al cambiar, se vuelve a la primera página.
 *
 * ```
 * const { paginados, page, setPage, totalPaginas, hayVariasPaginas } =
 *   usePaginas(items, 10, `${desde}|${hasta}|${equipo}`);
 * ```
 */
export function usePaginas<T>(
  items: T[],
  pageSize = 10,
  resetKey?: string,
) {
  const [paginaPedida, setPaginaPedida] = useState(1);

  /*
   * Volver a la primera se ajusta durante el render, no en un `useEffect`: con
   * el efecto hay un render en el que la tabla ya se pintó vacía (página 3 de
   * una lista que ahora tiene 1) antes de corregirla. Es el patrón que
   * documenta React para "ajustar estado cuando cambia una prop", y evita el
   * render de más.
   */
  const [resetKeyVisto, setResetKeyVisto] = useState(resetKey);
  if (resetKey !== resetKeyVisto) {
    setResetKeyVisto(resetKey);
    setPaginaPedida(1);
  }

  const totalPaginas = Math.max(1, Math.ceil(items.length / pageSize));

  /*
   * La página pedida se recorta al rango válido en vez de corregir el estado:
   * si el filtro se acota desde la página 5 a una lista de 1 página, `page`
   * devuelve 1 y la tabla muestra algo, sin importar cuántas veces más se
   * escriba el 1.
   */
  const page = Math.min(paginaPedida, totalPaginas);

  const paginados = useMemo(() => {
    const inicio = (page - 1) * pageSize;
    return items.slice(inicio, inicio + pageSize);
  }, [items, page, pageSize]);

  const setPage = useCallback((nueva: number) => setPaginaPedida(nueva), []);
  const primeraPagina = useCallback(() => setPaginaPedida(1), []);

  return {
    paginados,
    page,
    setPage,
    /** Alias de `setPage` para los call sites que usan el nombre de la acción. */
    irAPagina: setPage,
    primeraPagina,
    totalPaginas,
    total: items.length,
    hayVariasPaginas: totalPaginas > 1,
  };
}
</file>

<file path="frontend/src/common/hooks/useRegistro.ts">
import { useCallback, useEffect, useState } from "react";

/**
 * Carga de un registro único por id, genérica.
 *
 * Reemplaza el `useEffect` + `useState` + `try/catch` que estaba repetido en los
 * nueve hooks de detalle (`useInsumo`, `useEquipo`, `usePersonal`, ...).
 *
 * A diferencia de los hooks de listado, estos hooks NO tienen guarda de
 * cancelación: si el usuario abre el registro A y enseguida el B, la respuesta
 * más lenta (la de A) podía llegar última y dejar la página mostrando el
 * registro equivocado. El flag `vigente` es el mismo patrón que ya usaban
 * `useIncidente` y `useImagenAutenticada`.
 *
 * `cargar` tiene que ser la función del service importada (o sea, de identidad
 * estable entre renders): si cambia en cada render, el efecto de abajo se
 * vuelve a disparar en loop.
 */
export interface OpcionesRegistro<T> {
  /** GET del registro por id. */
  cargar: (id: number) => Promise<T>;
  /** Id a cargar, o `null`/`undefined` si todavía no hay uno válido. */
  id: number | null | undefined;
  /** Cómo se llama la entidad en el mensaje de error, con artículo: "el insumo". */
  etiqueta: string;
}

/** Estado del registro. `registro` mantiene el valor anterior mientras se recarga. */
export interface Registro<T> {
  registro: T | null;
  loading: boolean;
  error: string | null;
  /** Vuelve a pedir el registro (el que se llama después de cerrarlo, etc.). */
  recargar: () => Promise<void>;
}

export function useRegistro<T>(opciones: OpcionesRegistro<T>): Registro<T> {
  const { cargar, id, etiqueta } = opciones;

  const [registro, setRegistro] = useState<T | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const pedir = useCallback(
    async (vigente: () => boolean) => {
      // El `Number.isNaN` no es un detalle: `Number(id)` de una URL como
      // "/personal/abc" da NaN, y sin esta guarda se disparaba un GET /personal/NaN.
      if (id == null || Number.isNaN(id)) return;

      try {
        setLoading(true);
        setError(null);

        const datos = await cargar(id);

        if (!vigente()) return;
        setRegistro(datos);
      } catch (err) {
        if (!vigente()) return;
        // Mismo criterio que `useABM`: el mensaje del servidor explica mejor el
        // fallo que un texto genérico ("No se pudo cargar el equipo").
        setError(err instanceof Error ? err.message : `No se pudo cargar ${etiqueta}`);
        console.error(err);
      } finally {
        if (vigente()) setLoading(false);
      }
    },
    [cargar, id, etiqueta],
  );

  useEffect(() => {
    let vigente = true;

    // Mismo `setTimeout(..., 0)` que usa `useLista`: setear estado de forma
    // síncrona dentro del efecto provoca un render en cascada, y con
    // `React.StrictMode` el montaje de desarrollo además dispararía el pedido
    // dos veces (la primera sin poder cancelarse).
    const timeoutId = window.setTimeout(() => {
      void pedir(() => vigente);
    }, 0);

    return () => {
      vigente = false;
      window.clearTimeout(timeoutId);
    };
  }, [pedir]);

  const recargar = useCallback(async () => {
    // Una recarga manual la dispara el usuario desde un click: no compite con
    // otro pedido por el mismo registro, así que siempre "sigue vigente".
    await pedir(() => true);
  }, [pedir]);

  return { registro, loading, error, recargar };
}
</file>

<file path="frontend/src/common/hooks/useValorDebounced.ts">
import { useEffect, useState } from "react";

/**
 * Copia con demora de un valor que cambia mientras se escribe.
 *
 * El buscador actualiza el valor con cada tecla; el fetch quiere la versión
 * "terminada". Con este hook, la recarga espera a que el usuario deje de
 * escribir (300 ms por defecto) en vez de disparar un pedido por tecla. El
 * patrón venía inline en `useDocumentosVigentes`; acá queda reutilizable
 * para todos los buscadores.
 *
 * ```
 * const [busqueda, setBusqueda] = useState("");
 * const busquedaAplicada = useValorDebounced(busqueda);
 * // el input actualiza `busqueda`; el efecto de carga depende de `busquedaAplicada`
 * ```
 */
export function useValorDebounced<T>(valor: T, demoraMs = 300): T {
  const [valorDebounced, setValorDebounced] = useState(valor);

  useEffect(() => {
    // La primera pasada no arma timer: `valor` ya es el estado inicial, y
    // demorar el primer fetch solo suma latencia a la carga de la página.
    // Tampoco lo arma si el usuario borró y volvió al valor ya aplicado:
    // la tabla ya muestra exactamente esos resultados.
    if (valor === valorDebounced) return;

    const timer = window.setTimeout(() => setValorDebounced(valor), demoraMs);
    return () => window.clearTimeout(timer);
  }, [valor, demoraMs, valorDebounced]);

  return valorDebounced;
}
</file>

