ENV="DEVELOPMENT"
ROOT_PATH_DEVELOPMENT=""
ROOT_PATH_PRODUCTION=""
DB_URL="sqlite:///db.sqlite3"
DB_URL_TEST="sqlite://"
LOG_LEVEL="INFO"
# Generá una propia con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Máximo de intentos fallidos de login por combinación IP + DNI
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=5
# Orígenes permitidos por CORS (separados por coma). Para probar desde un
# celular/tablet en la misma red, agregar la IP local, ej:
# CORS_ORIGINS="http://localhost:5173,http://192.168.0.10:5173"
CORS_ORIGINS="http://localhost:5173"
# URL canónica del frontend para los enlaces y QR de la vista pública. En
# desarrollo puede ser http://localhost:5173; en producción debe ser pública.
PUBLIC_APP_URL=""
# Zona horaria con la que se interpretan los días filtrados en la UI (la bitácora se guarda en UTC)
ZONA_HORARIA="America/Argentina/Buenos_Aires"
# Poner TRUSTED_PROXY=true solo detrás de un proxy inverso de confianza
TRUSTED_PROXY=false
TRUSTED_PROXY_HOPS=1
# Tamaño máximo de subida de archivos, en bytes (10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
# Solo SQLite está soportado hoy (ver DB_URL)
