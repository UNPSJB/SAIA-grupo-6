<file path="frontend/src/features/notificaciones/services/notificacionService.ts">
import type { CriticidadDashboard, Notificacion } from "../types/notificacion";

import { pedir } from "../../../common/api/errors";
import { apiFetch, API_URL } from "../../../common/api/apiClient";
import { queryPagina, type Pagina } from "../../../common/api/paginacion";

/** Contadores de los dropdowns de filtro, calculados en el backend. */
export interface ContadoresNotificaciones {
  urgencia: {
    todas: number;
    vencidas: number;
    proximas: number;
    stock_bajo: number;
  };
  origen: {
    todas: number;
    ELEMENTO_LIMPIEZA: number;
    VENCIMIENTO_PERSONAL: number;
    PLAN_CALIBRACION: number;
    PLAN_MANTENIMIENTO: number;
    STOCK_BAJO: number;
  };
}

export interface NotificacionPagina extends Pagina<Notificacion> {
  contadores: ContadoresNotificaciones;
}

export type ColumnaOrdenNotificacion = "estado" | "vencimiento" | "origen";

/**
 * Claves de orden del backend. `urgencia` es el default histórico (VENCIDOS
 * arriba); la tabla manda `estado_asc` —equivalente— y las claves de columna
 * al hacer clic en el encabezado.
 */
export type OrdenNotificacion =
  | "urgencia"
  | `${ColumnaOrdenNotificacion}_asc`
  | `${ColumnaOrdenNotificacion}_desc`;

/** Filtros del centro de notificaciones. El valor vacío significa "sin filtro". */
export type UrgenciaNotificacion = "" | "vencidas" | "proximas" | "stock_bajo";
export type OrigenNotificacion =
  | ""
  | "ELEMENTO_LIMPIEZA"
  | "VENCIMIENTO_PERSONAL"
  | "PLAN_CALIBRACION"
  | "PLAN_MANTENIMIENTO"
  | "STOCK_BAJO";

/** El listado completo (lo usa la campana del navbar, no la tabla). */
export async function obtenerNotificaciones(): Promise<Notificacion[]> {
  const response = await apiFetch(`${API_URL}/notificaciones`);
  return pedir<Notificacion[]>(response, "Error al obtener las notificaciones del sistema");
}

/**
 * Una página de notificaciones, con filtros + orden + contadores calculados
 * en el servidor. `orden` replica las columnas clickeables de la tabla:
 * estado (default), vencimiento y origen.
 */
export async function obtenerNotificacionesPaginadas(
  page: number,
  pageSize: number,
  filtros: {
    buscar?: string;
    urgencia?: UrgenciaNotificacion;
    origen?: OrigenNotificacion;
    orden?: OrdenNotificacion;
  } = {}
): Promise<NotificacionPagina> {
  const query = queryPagina(page, pageSize, {
    buscar: filtros.buscar?.trim() || undefined,
    urgencia: filtros.urgencia || undefined,
    origen: filtros.origen || undefined,
    orden: filtros.orden && filtros.orden !== "urgencia" ? filtros.orden : undefined,
  });
  const response = await apiFetch(`${API_URL}/notificaciones${query}`);
  return pedir<NotificacionPagina>(response, "Error al obtener las notificaciones del sistema");
}

export async function obtenerConfiguracionAlertas(): Promise<{
  dias_alerta_vencimiento_personal: number;
}> {
  const response = await apiFetch(`${API_URL}/notificaciones/configuracion`);
  return pedir<{ dias_alerta_vencimiento_personal: number }>(
    response,
    "Error al obtener la configuración de alertas"
  );
}

export async function actualizarConfiguracionAlertas(dias: number): Promise<{
  dias_alerta_vencimiento_personal: number;
}> {
  const response = await apiFetch(`${API_URL}/notificaciones/configuracion`, {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ dias_alerta_vencimiento_personal: dias }),
  });
  return pedir<{ dias_alerta_vencimiento_personal: number }>(
    response,
    "No se pudo guardar la configuración"
  );
}
export async function obtenerCriticidadDashboard(): Promise<CriticidadDashboard> {
  const response = await apiFetch(`${API_URL}/notificaciones/criticidad`);
  return pedir<CriticidadDashboard>(
    response,
    "Error al obtener el nivel de criticidad"
  );
}
</file>

<file path="frontend/src/features/personal/components/pages/PersonalPage.tsx">
import { useState } from "react";
import { useNavigate } from "react-router-dom";
import { Box, Button, Spinner } from "@chakra-ui/react";
import { PersonalTable } from "../PersonalTable";
import { ConfirmDialog } from "../../../../common/components/ConfirmDialog";
import { ConfirmarReactivacionDialog } from "../../../../common/components/ConfirmarReactivacionDialog";
import { usePersonales } from "../../hooks/usePersonales";
import { usePersonalABM } from "../../hooks/usePersonalABM";
import {
  ROLES_PERSONAL,
  type Persona,
  type RolPersonal,
} from "../../types/personal";
import type { ColumnaOrdenPersonal } from "../../services/personalService";
import { useOrdenTabla } from "../../../../common/hooks/useOrdenTabla";
import { useValorDebounced } from "../../../../common/hooks/useValorDebounced";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../../components/ui/filtros";
import {
  BannerError,
  PageHeader,
  Paginacion,
  ToggleInactivos,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

export function PersonalPage() {
  const navigate = useNavigate();
  const [verInactivos, setVerInactivos] = useState(false);

  const [busqueda, setBusqueda] = useState("");
  const busquedaAplicada = useValorDebounced(busqueda);
  const [rol, setRol] = useState("");
  const orden = useOrdenTabla<ColumnaOrdenPersonal, "nombre_asc">("nombre_asc");

  const {
    personales,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading,
    error,
    cargarPersonales,
  } = usePersonales(
    {
      incluirInactivos: verInactivos,
      buscar: busquedaAplicada,
      rol: rol ? (rol as RolPersonal) : undefined,
      orden: orden.orden,
    },
    PAGE_SIZE
  );
  const {
    borrar,
    reactivar,
    loading: procesando,
    error: errorReactivar,
  } = usePersonalABM();

  const [personaAEliminar, setPersonaAEliminar] = useState<Persona | null>(null);
  const [personaAReactivar, setPersonaAReactivar] = useState<Persona | null>(null);


  const handleToggleInactivos = (checked: boolean) => {
    // El hook de listado vuelve solo a la página 1 cuando cambia el filtro.
    setVerInactivos(checked);
  };

  const limpiarTodo = () => {
    setBusqueda("");
    setRol("");
    orden.reiniciar();
  };

  const hayFiltros = busqueda.trim() !== "" || rol !== "";

  const ETIQUETAS_ORDEN: Record<ColumnaOrdenPersonal, string> = {
    nombre: "Nombre",
    dni: "DNI",
  };

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "rol",
      etiqueta: "Rol",
      valor: ROLES_PERSONAL.find((opcion) => opcion.value === rol)?.label ?? rol,
      onQuitar: () => setRol(""),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  const handleEdit = (persona: Persona) => navigate(`/personal/${persona.id}/editar`);
  
  const handleDeleteRequest = (persona: Persona) => setPersonaAEliminar(persona);
  const handleCloseDeleteDialog = () => { if (!procesando) setPersonaAEliminar(null); };
  const handleConfirmDelete = async () => {
    if (!personaAEliminar) return;
    try {
      await borrar(personaAEliminar.id);
      setPersonaAEliminar(null);
      await cargarPersonales();
    } catch (error) {
      console.error(error);
    }
  };

  const handleReactivarRequest = (persona: Persona) => setPersonaAReactivar(persona);
  const handleCloseReactivarDialog = () => { if (!procesando) setPersonaAReactivar(null); };
  const handleConfirmReactivar = async () => {
    if (!personaAReactivar) return;
    try {
      // `es_super_admin` se reenvía explícitamente: el backend solo lo modifica
      // si viene en el cuerpo (usa `exclude_unset`), así que omitirlo en la
      // reactivación degradaba al super admin a un administrador común.
      await reactivar(personaAReactivar.id, {
        nombre: personaAReactivar.nombre,
        apellido: personaAReactivar.apellido || null,
        dni: personaAReactivar.dni,
        email: personaAReactivar.email,
        telefono: personaAReactivar.telefono || null,
        puede_operar: personaAReactivar.puede_operar,
        puede_administrar: personaAReactivar.puede_administrar,
        es_super_admin: personaAReactivar.es_super_admin,
      });
      setPersonaAReactivar(null);
      await cargarPersonales();
    } catch {
      // El hook expone el error en `errorReactivar`.
    }
  };

  return (
    <Box p="5">
      <PageHeader
        title={verInactivos ? "Personal dado de baja" : "Gestión de personal"}
        description="Alta, modificación y baja del personal del laboratorio."
        actions={
          <Button colorPalette="brand" onClick={() => navigate("/personal/nuevo")}>
            + Agregar
          </Button>
        }
      />

      {loading && <Spinner color="brand.500" />}
      {error && <BannerError>{error}</BannerError>}
      {errorReactivar && <BannerError>{errorReactivar}</BannerError>}

      <ToggleInactivos
        checked={verInactivos}
        onChange={handleToggleInactivos}
        children="Ver dados de baja"
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por nombre, apellido, DNI o email..."
          />
        }
        filtros={
          <FiltroSelect
            label="Rol"
            valor={rol}
            onCambio={setRol}
            opciones={ROLES_PERSONAL.map((opcion) => ({
              valor: opcion.value,
              etiqueta: opcion.label,
            }))}
          />
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {!loading && !error && (
        <>
          {hayFiltros && personales.length === 0 ? (
            <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
              No hay personal que coincida con los filtros aplicados.
            </EstadoVacioFiltrado>
          ) : (
            <PersonalTable
              personales={personales}
              orden={orden}
              onEdit={handleEdit}
              onDelete={handleDeleteRequest}
              onReactivar={handleReactivarRequest}
            />
          )}

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}

      <ConfirmDialog
        isOpen={personaAEliminar !== null}
        titulo={
          <>
            ¿Está seguro que desea eliminar a{" "}
            <strong>{personaAEliminar?.nombre}</strong>?
          </>
        }
        mensaje="Esta acción no se puede deshacer."
        isLoading={procesando}
        onCancel={handleCloseDeleteDialog}
        onConfirm={handleConfirmDelete}
      />
      
      <ConfirmarReactivacionDialog 
        isOpen={personaAReactivar !== null} 
        mensaje={`¿Está seguro que desea reactivar al empleado ${personaAReactivar?.nombre}?`} 
        isLoading={procesando} 
        onCancel={handleCloseReactivarDialog} 
        onConfirm={handleConfirmReactivar} 
      />
    </Box>
  );
}
</file>

<file path="frontend/src/features/personal/components/PersonalTable.tsx">
import { Table, Text } from "@chakra-ui/react";
import { PersonalItem } from "./PersonalItem";
import type { Persona } from "../types/personal";
import type { ColumnaOrdenPersonal } from "../services/personalService";
import type { OrdenTabla } from "../../../common/hooks/useOrdenTabla";
import { EncabezadoOrdenable } from "../../../components/ui/filtros";
import {
  EncabezadoOscuro,
  FilaEncabezado,
  Tarjeta,
} from "../../../components/ui/patrones";

interface PersonalTableProps {
  personales: Persona[];
  orden: OrdenTabla<ColumnaOrdenPersonal, string>;
  onEdit: (persona: Persona) => void;
  onDelete: (persona: Persona) => void;
  onReactivar: (persona: Persona) => void;
}

export function PersonalTable({
  personales,
  orden,
  onEdit,
  onDelete,
  onReactivar,
}: PersonalTableProps) {
  if (personales.length === 0) {
    return (
      <Tarjeta p="8" textAlign="center">
        <Text color="fg.muted">No hay personal para mostrar.</Text>
      </Tarjeta>
    );
  }

  return (
    <Tarjeta overflowX="auto">
      <Table.Root variant="outline" w="100%" minW="720px">
        <Table.Header>
          <FilaEncabezado>
            <EncabezadoOrdenable columna="nombre" orden={orden}>
              Nombre
            </EncabezadoOrdenable>
            <EncabezadoOrdenable columna="dni" orden={orden} ancho="media">
              DNI
            </EncabezadoOrdenable>
            <EncabezadoOscuro ancho="media">Permisos</EncabezadoOscuro>
            <EncabezadoOscuro center ancho="accionesAnchas">Acciones</EncabezadoOscuro>
          </FilaEncabezado>
        </Table.Header>
        <Table.Body>
          {personales.map((persona) => (
            <PersonalItem key={persona.id} persona={persona} onEdit={onEdit} onDelete={onDelete} onReactivar={onReactivar} />
          ))}
        </Table.Body>
      </Table.Root>
    </Tarjeta>
  );
}
</file>

<file path="frontend/src/features/personal/services/personalService.ts">
import type { Persona, PersonaInput, RolPersonal } from "../types/personal";
import { pedir } from "../../../common/api/errors";


import { apiFetch, API_URL } from "../../../common/api/apiClient";
import { queryPagina, type Pagina } from "../../../common/api/paginacion";


export type ColumnaOrdenPersonal = "nombre" | "dni";
export type OrdenPersonal =
    | `${ColumnaOrdenPersonal}_asc`
    | `${ColumnaOrdenPersonal}_desc`;

export interface FiltrosPersonal {
    incluirInactivos?: boolean;
    buscar?: string;
    rol?: RolPersonal;
    orden?: OrdenPersonal;
}

export async function listarPersonal(
    page: number,
    pageSize: number,
    filtros: FiltrosPersonal = {}
): Promise<Pagina<Persona>> {
    const query = queryPagina(page, pageSize, {
        incluir_inactivos: filtros.incluirInactivos || undefined,
        buscar: filtros.buscar?.trim() || undefined,
        rol: filtros.rol,
        orden: filtros.orden,
    });
    const response = await apiFetch(`${API_URL}/personal${query}`);
    return pedir<Pagina<Persona>>(response, "Error al obtener el personal");
}

export async function obtenerPersona(id: number): Promise<Persona> {
    const response = await apiFetch(`${API_URL}/personal/${id}`);
    return pedir<Persona>(response, "Error al obtener la persona");
}

// Datos de la persona logueada, para la página "Mi perfil".
//
// No usa `GET /personal/{id}`: ese endpoint exige permiso de administrador
// y un operador no podría ver su propia ficha. `/auth/me` devuelve la misma
// `Persona` con solo tener la sesión abierta.
export async function obtenerMiPerfil(): Promise<Persona> {
    const response = await apiFetch(`${API_URL}/auth/me`);
    return pedir<Persona>(response, "Error al obtener tu perfil");
}

export async function crearPersona(persona: PersonaInput): Promise<Persona> {
    const response = await apiFetch(`${API_URL}/personal`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(persona),
    });

    return pedir<Persona>(response, "Error al crear el registro");
}

export async function modificarPersona(id: number, persona: PersonaInput): Promise<Persona> {
    const response = await apiFetch(`${API_URL}/personal/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(persona),
    });

    return pedir<Persona>(response, "Error al modificar el registro");
}

// Reactiva a alguien dado de baja, pisando sus datos con los valores nuevos.
// No es un endpoint nuevo: reusa el PUT /personal/{id} de siempre, solo que
// le manda `activo: true` además de los campos del formulario (PersonaUpdate
// ya soporta ese campo).
export async function reactivarPersona(id: number, persona: PersonaInput): Promise<Persona> {
    const response = await apiFetch(`${API_URL}/personal/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...persona, activo: true }),
    });
    return pedir<Persona>(response, "Error al reactivar el personal");
}

export async function eliminarPersona(id: number): Promise<void> {
    const response = await apiFetch(`${API_URL}/personal/${id}`, {
        method: "DELETE",
    });
    return pedir<void>(response, "Error al eliminar el registro");
}
</file>

