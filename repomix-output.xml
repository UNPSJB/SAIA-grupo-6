<file path="backend/src/incidente/services.py">
import logging
from datetime import date
from typing import List, Optional
from sqlalchemy import Select, func, select
from sqlalchemy.orm import Session, selectinload
from src.common.fechas import ahora
from src.common.listados import ColumnaOrden, aplicar_orden, filtro_busqueda
from src.common.paginacion import paginar
from src.common.persistence import guardar
from src.incidente import models, schemas, exceptions
from src.incidente.constants import EstadoIncidente, TipoIncidente
from src.Equipo.models import Equipo
from src.personal.models import Personal

logger = logging.getLogger(__name__)


# Relaciones que se cargan siempre para poder devolver los nombres en la respuesta.
_RELACIONES = (
    selectinload(models.Incidente.equipo),
    selectinload(models.Incidente.usuario),
    selectinload(models.Incidente.responsable_cierre),
)


# Órdenes válidos del listado de gestión. `recientes`/`antiguos` son los alias
# que usaba la tabla antes de que existiera el orden por columna: se mantienen
# porque el verifier y otros consumidores los siguen mandando.
_ORDENES_INCIDENTE = {
    "recientes": ColumnaOrden((models.Incidente.fecha_reporte,), descendente=True),
    "antiguos": ColumnaOrden((models.Incidente.fecha_reporte,)),
    "fecha_asc": ColumnaOrden((models.Incidente.fecha_reporte,)),
    "fecha_desc": ColumnaOrden((models.Incidente.fecha_reporte,), descendente=True),
    "estado_asc": ColumnaOrden((models.Incidente.estado,)),
    "estado_desc": ColumnaOrden((models.Incidente.estado,), descendente=True),
    "tipo_asc": ColumnaOrden((models.Incidente.tipo,)),
    "tipo_desc": ColumnaOrden((models.Incidente.tipo,), descendente=True),
}


def _nombre_completo(persona: Optional[Personal]) -> Optional[str]:
    if persona is None:
        return None
    return f"{persona.nombre} {persona.apellido or ''}".strip()


def _completar_nombres(incidentes: List[models.Incidente]) -> List[models.Incidente]:
    """Las relaciones se cargan a mano para evitar consultas perezosas."""
    for inc in incidentes:
        if inc.equipo:
            inc.equipo_nombre = inc.equipo.nombre
        inc.usuario_nombre = _nombre_completo(inc.usuario)
        inc.responsable_cierre_nombre = _nombre_completo(inc.responsable_cierre)
    return incidentes


def _verificar_equipo(db: Session, equipo_id: Optional[int]) -> None:
    """Verifica que el equipo exista y esté activo (si se especifica)."""
    if equipo_id is None:
        return
    equipo = db.scalar(select(Equipo).where(Equipo.id == equipo_id))
    if equipo is None:
        raise exceptions.EquipoNoEncontrado()
    if not equipo.activo:
        raise exceptions.EquipoInactivo()


def _verificar_usuario(db: Session, usuario_id: int) -> None:
    """Verifica que el usuario exista y esté activo."""
    usuario = db.scalar(select(Personal).where(Personal.id == usuario_id))
    if usuario is None:
        raise exceptions.UsuarioNoEncontrado()
    if not usuario.activo:
        raise exceptions.UsuarioInactivo()


def crear_incidente(db: Session, datos: schemas.IncidenteCreate, usuario_id: int) -> models.Incidente:
    _verificar_equipo(db, datos.equipo_id)
    _verificar_usuario(db, usuario_id)

    incidente = models.Incidente(
        titulo=datos.titulo,
        descripcion=datos.descripcion,
        tipo=datos.tipo,
        equipo_id=datos.equipo_id,
        foto_url=datos.foto_url,
        usuario_id=usuario_id,
        fecha_reporte=ahora(),
        estado=EstadoIncidente.ABIERTO.value,
    )
    db.add(incidente)
    return guardar(db, incidente)


def _validar_rango_fechas(
    fecha_desde: Optional[date], fecha_hasta: Optional[date]
) -> None:
    """Rechaza un rango cuya fecha inicial es posterior a la final."""
    if fecha_desde is not None and fecha_hasta is not None and fecha_desde > fecha_hasta:
        raise exceptions.FechaInvalida()


def _aplicar_rango_fechas(
    consulta,
    fecha_desde: Optional[date],
    fecha_hasta: Optional[date],
):
    """Acota la consulta a un rango de fechas de reporte, inclusive.

    Se compara por `func.date(...)`: `fecha_reporte` es un `DateTime` y sin el
    corte por día un `hasta` a las 00:00 se comería el día completo.
    """
    if fecha_desde is not None:
        consulta = consulta.where(
            func.date(models.Incidente.fecha_reporte) >= fecha_desde
        )
    if fecha_hasta is not None:
        consulta = consulta.where(
            func.date(models.Incidente.fecha_reporte) <= fecha_hasta
        )
    return consulta


def _consulta_incidentes(
    estado: Optional[EstadoIncidente],
    tipo: Optional[str],
    equipo_id: Optional[int],
    orden: Optional[str],
    buscar: Optional[str] = None,
) -> Select:
    """Consulta base del listado: filtros en el WHERE y orden estable.

    La búsqueda se resuelve en SQL (título, descripción y nombre de quien
    reportó). El join con `Personal` es many-to-one por clave primaria, así que
    no duplica filas ni rompe el COUNT/LIMIT; `sin_tildes` (ver
    `src.common.texto`) es la función que permite comparar sin acentos.

    El desempate por `id` es lo que hace seguro el OFFSET/LIMIT: solo por
    `fecha_reporte` hay filas con la misma fecha y el recorte puede repetir
    u omitir registros entre páginas.
    """
    consulta = (
        select(models.Incidente)
        .join(Personal, Personal.id == models.Incidente.usuario_id)
        .options(*_RELACIONES)
    )

    if estado:
        # El router ya convierte el query param con el enum de FastAPI, así que
        # acá llega como `EstadoIncidente`. Se acepta también un `str` suelta
        # para no romper callers que la pasen así.
        valor = estado.value if isinstance(estado, EstadoIncidente) else str(estado)
        consulta = consulta.where(models.Incidente.estado == valor)
    if tipo:
        consulta = consulta.where(models.Incidente.tipo == tipo)
    if equipo_id:
        consulta = consulta.where(models.Incidente.equipo_id == equipo_id)

    filtro_texto = filtro_busqueda(
        (
            models.Incidente.titulo,
            models.Incidente.descripcion,
            Personal.nombre,
            Personal.apellido,
        ),
        buscar,
    )
    if filtro_texto is not None:
        consulta = consulta.where(filtro_texto)

    # Por defecto, el más reciente arriba. `aplicar_orden` agrega el desempate
    # por `id` que hace seguro el OFFSET/LIMIT entre páginas.
    return aplicar_orden(
        consulta,
        models.Incidente,
        orden,
        _ORDENES_INCIDENTE,
        "recientes",
    )


def listar_incidentes(
    db: Session,
    estado: Optional[EstadoIncidente] = None,
    tipo: Optional[str] = None,
    equipo_id: Optional[int] = None,
    orden: Optional[str] = None,
    buscar: Optional[str] = None,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> List[models.Incidente]:
    """Lista los incidentes, por defecto del más reciente al más viejo.

    Sin `estado` devuelve todos (abiertos y cerrados); con `estado` filtra.
    `orden="antiguos"` invierte el criterio. Es el camino SIN paginar: lo
    usan el tablero y el resumen, que necesitan el conjunto completo.

    `buscar` se resuelve en el WHERE (título, descripción y nombre de quien
    reportó), igual que en el camino paginado: antes el router lo descartaba
    en silencio y quien lo mandaba recibía la lista completa sin filtrar.
    `fecha_desde`/`fecha_hasta` acotan por fecha de reporte (inclusive).
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)
    consulta = _consulta_incidentes(estado, tipo, equipo_id, orden, buscar)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)
    return _completar_nombres(list(db.scalars(consulta).all()))


def listar_incidentes_paginado(
    db: Session,
    estado: Optional[EstadoIncidente],
    tipo: Optional[str],
    equipo_id: Optional[int],
    buscar: Optional[str],
    orden: Optional[str],
    page: int,
    page_size: int,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> tuple[List[models.Incidente], int]:
    """Página del listado, recortada por la BASE (COUNT + OFFSET/LIMIT).

    Todos los filtros —estado, tipo, equipo, rango de fechas y búsqueda de
    texto— viajan en el WHERE, así que la consulta trae solo las filas de la
    página. La búsqueda ignora mayúsculas y tildes gracias a `sin_tildes`, la
    función SQLite que registra `src.common.texto`; también cubre el nombre y
    el apellido de quien reportó (join many-to-one con `personal`, que no
    duplica filas).
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)
    consulta = _consulta_incidentes(estado, tipo, equipo_id, orden, buscar)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)
    incidentes, total = paginar(db, consulta, page, page_size)
    return _completar_nombres(incidentes), total


def obtener_incidente(db: Session, incidente_id: int, current_user: Personal) -> models.Incidente:
    incidente = db.scalar(
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()

    # Operador solo ve sus propios incidentes
    if not (current_user.puede_administrar or current_user.es_super_admin):
        if incidente.usuario_id != current_user.id:
            raise exceptions.PermisoDenegado()

    _completar_nombres([incidente])
    return incidente


def _consulta_mis_incidentes(
    usuario_id: int, estado: Optional[EstadoIncidente]
) -> Select:
    """Incidentes del usuario, siempre del más reciente al más viejo.

    El orden es fijo (no se expone `orden` en "Mis reportes"), pero se mantiene
    el desempate por `id` para que OFFSET/LIMIT no repita ni omita filas.
    """
    consulta = (
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.usuario_id == usuario_id)
    )
    if estado:
        valor = estado.value if isinstance(estado, EstadoIncidente) else str(estado)
        consulta = consulta.where(models.Incidente.estado == valor)
    return consulta.order_by(
        models.Incidente.fecha_reporte.desc(), models.Incidente.id.desc()
    )


def listar_mis_incidentes(
    db: Session,
    usuario_id: int,
    estado: Optional[EstadoIncidente] = None,
) -> List[models.Incidente]:
    """Lista los incidentes reportados por un usuario específico (para operadores).

    Sin `estado` devuelve abiertos y cerrados.
    """
    consulta = _consulta_mis_incidentes(usuario_id, estado)
    return _completar_nombres(list(db.scalars(consulta).all()))


def listar_mis_incidentes_paginado(
    db: Session,
    usuario_id: int,
    page: int,
    page_size: int,
    estado: Optional[EstadoIncidente] = None,
) -> tuple[List[models.Incidente], int]:
    """Página de los incidentes del usuario, recortada por la BASE.

    El filtro es `usuario_id` (y opcionalmente `estado`), así que la consulta
    sale entera en SQL con COUNT + OFFSET/LIMIT y el orden estable de
    `listar_mis_incidentes`.
    """
    consulta = _consulta_mis_incidentes(usuario_id, estado)
    incidentes, total = paginar(db, consulta, page, page_size)
    return _completar_nombres(incidentes), total


def resumen_por_tipo(
    db: Session,
    estado: Optional[EstadoIncidente] = None,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> schemas.IncidenteResumenResponse:
    """Cuenta incidentes por tipo para el indicador del tablero (E7).

    Devuelve los cinco tipos siempre, con 0 si no hay registros. Por
    defecto es el universo de los abiertos (la historia de "incidentes abiertos":
    que ninguno quede reportado y olvidado). `fecha_desde`/`fecha_hasta`
    acotan por fecha de reporte (inclusive).
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)

    consulta = select(
        models.Incidente.tipo, func.count(models.Incidente.id)
    ).group_by(models.Incidente.tipo)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)
    if estado:
        consulta = consulta.where(models.Incidente.estado == estado.value)

    conteos = {tipo.value: 0 for tipo in TipoIncidente}
    for tipo, cantidad in db.execute(consulta).all():
        if tipo in conteos:
            conteos[tipo] = cantidad

    return schemas.IncidenteResumenResponse(
        estado=estado.value if estado else "todos",
        total=sum(conteos.values()),
        por_tipo=[
            schemas.IncidenteResumenTipo(tipo=t, cantidad=conteos[t])
            for t in (tipo.value for tipo in TipoIncidente)
        ],
    )


def cambiar_estado_incidente(
    db: Session,
    incidente_id: int,
    estado: EstadoIncidente,
    current_user: Personal,
    observacion_cierre: Optional[str] = None,
) -> models.Incidente:
    """Cierra o reabre un incidente.

    Al cerrar se asienta la acción correctiva, cuándo se cerró y quién lo
    resolvió. Al reabrir se limpia esa información para que no quede
    desactualizada. Además, guarda un evento en el historial de incidentes.
    """
    incidente = db.scalar(
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()

    if incidente.estado == estado.value:
        # Ya está en ese estado: no se pisa la fecha de cierre original.
        # Aun así hay que completar los nombres: sin esto, este camino
        # devolvía los tres campos de nombre en null (son Optional, así que
        # la inconsistencia con el GET pasaba inadvertida).
        return _completar_nombres([incidente])[0]

    estado_anterior = incidente.estado

    if estado == EstadoIncidente.CERRADO:
        _verificar_usuario(db, current_user.id)
        incidente.estado = EstadoIncidente.CERRADO.value
        incidente.fecha_cierre = ahora()
        incidente.responsable_cierre_id = current_user.id
        incidente.observacion_cierre = observacion_cierre
        logger.info(
            "Incidente %s cerrado por %s", incidente.id, current_user.id
        )
    else:
        incidente.estado = EstadoIncidente.ABIERTO.value
        incidente.fecha_cierre = None
        incidente.responsable_cierre_id = None
        incidente.observacion_cierre = None
        logger.info("Incidente %s reabierto por %s", incidente.id, current_user.id)

    # Guardar evento en el historial
    db.add(
        models.HistorialIncidente(
            incidente_id=incidente.id,
            estado_anterior=estado_anterior,
            estado_nuevo=estado.value,
            usuario_id=current_user.id,
            observacion=observacion_cierre,
        )
    )

    guardar(db, incidente)

    # refresh deja las relaciones sin cargar: hay que volver a consultarlas.
    return obtener_incidente(db, incidente_id, current_user)


def obtener_historial_incidente(
    db: Session, incidente_id: int, current_user: Personal
) -> schemas.HistorialIncidenteResponse:
    """Obtiene el historial de cierre/reapertura de un incidente.

    Igual que en el detalle, un operador solo ve el historial de sus propios
    incidentes: este endpoint no expone el historial (ni la observación de
    cierre) de incidentes ajenos por ID.
    """
    incidente = db.scalar(
        select(models.Incidente).where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()
    if not (current_user.puede_administrar or current_user.es_super_admin):
        if incidente.usuario_id != current_user.id:
            raise exceptions.PermisoDenegado()

    eventos = db.scalars(
        select(models.HistorialIncidente)
        .where(models.HistorialIncidente.incidente_id == incidente_id)
        .options(selectinload(models.HistorialIncidente.usuario))
        .order_by(models.HistorialIncidente.fecha_evento)
    ).all()

    items = []
    for e in eventos:
        item = schemas.HistorialIncidenteItem.model_validate(e)
        if e.usuario is not None:
            item.usuario_nombre = _nombre_completo(e.usuario)
        items.append(item)

    return schemas.HistorialIncidenteResponse(
        incidente_id=incidente_id,
        eventos=items,
    )
</file>

<file path="frontend/src/features/checklist/components/pages/HistorialChecklistPage.tsx">
import { Fragment, useMemo, useState } from "react";
import { Badge, Box, Field, Table, Text } from "@chakra-ui/react";
import { LuRefreshCw } from "react-icons/lu";
import { useHistorialChecklists } from "../../hooks/useHistorialChecklists";
import { DetalleChecklistDialog } from "../DetalleChecklistDialog";
import type { HistorialChecklistItem } from "../../types/checklist";
import { useEquipos } from "../../../equipo/hooks/useEquipos";
import {
  formatoFecha,
  haceDiasISO,
  hoyISO,
} from "../../../../common/utils/fechas";
import { useOrdenTabla } from "../../../../common/hooks/useOrdenTabla";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EncabezadoOrdenable,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../../components/ui/filtros";
import {
  BannerError,
  BotonAccion,
  BotonCancelar,
  BotonTexto,
  Celda,
  EncabezadoOscuro,
  EstadoCargando,
  EstadoVacio,
  FilaEncabezado,
  FormInput,
  LabelFiltro,
  PageHeader,
  Paginacion,
  Tarjeta,
  TextoTruncado,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

type ColumnaHistorial = "fecha" | "equipo";

const ETIQUETAS_ORDEN: Record<ColumnaHistorial, string> = {
  fecha: "Fecha",
  equipo: "Equipo",
};

/** Verde/ámbar/rojo del cumplimiento, con los tokens del tema. */
function colorPorcentaje(pct: number): string {
  if (pct >= 80) return "green.600";
  if (pct >= 50) return "orange.400";
  return "red.700";
}

export function HistorialChecklistPage() {
  // El rango inicial (últimos 7 días) es también el destino de "Limpiar todo".
  const [rangoInicial] = useState(() => ({
    desde: haceDiasISO(7),
    hasta: hoyISO(),
  }));

  const [fechaDesde, setFechaDesde] = useState(rangoInicial.desde);
  const [fechaHasta, setFechaHasta] = useState(rangoInicial.hasta);
  const [equipoSeleccionado, setEquipoSeleccionado] = useState<string>("");
  const [busqueda, setBusqueda] = useState("");
  const [expandidos, setExpandidos] = useState<Set<number>>(new Set());
  const [checklistSeleccionado, setChecklistSeleccionado] =
    useState<HistorialChecklistItem | null>(null);

  const equipoIdFiltro =
    equipoSeleccionado !== "" ? Number(equipoSeleccionado) : undefined;

  const { equipos } = useEquipos();

  const [page, setPage] = useState(1);

  // La tabla abre por fecha descendente (lo más reciente arriba). Al ordenar
  // se vuelve a la página 1: `alCambiar` replica lo que hace
  // `useListaPaginada` en los listados que no manejan `page` a mano.
  const orden = useOrdenTabla<ColumnaHistorial, "fecha_desc">(
    "fecha_desc",
    "fecha",
    () => setPage(1)
  );

  const { historial, loading, error, recargar } = useHistorialChecklists(
    fechaDesde,
    fechaHasta,
    equipoIdFiltro,
    busqueda,
    orden.orden,
    page,
    PAGE_SIZE
  );

  const toggleExpandido = (checklistId: number) => {
    setExpandidos((prev) => {
      const nuevo = new Set(prev);
      if (nuevo.has(checklistId)) {
        nuevo.delete(checklistId);
      } else {
        nuevo.add(checklistId);
      }
      return nuevo;
    });
  };

  // `items` es la página actual; el cumplimiento general y el total vienen
  // calculados sobre TODO el período en el backend.
  const checklists = useMemo(() => historial?.items ?? [], [historial]);
  const total = historial?.total ?? 0;
  const totalPaginas = historial?.total_paginas ?? 1;
  const hayVariasPaginas = totalPaginas > 1;

  // Página fuera de rango: si el rango se acortó (p. ej. un refresco después
  // de que otro usuario cerró checklists) el backend devuelve `items` vacíos
  // con `total > 0`. El ajuste va DURANTE el render — el mismo "recortar, no
  // corregir con un efecto" de `useListaPaginada` — porque un `useEffect`
  // con `setPage` dispara la regla `set-state-in-effect`. Con `page` en las
  // dependencias del hook, la corrección dispara el re-fetch de la última
  // página válida y la tabla nunca queda vacía con la paginación oculta.
  if (
    historial &&
    historial.total > 0 &&
    historial.items.length === 0 &&
    page > totalPaginas
  ) {
    setPage(totalPaginas);
  }

  /** Al cambiar cualquier filtro la página 1 siempre es válida. */
  const cambiarFiltro = (aplicar: () => void) => {
    aplicar();
    setPage(1);
  };

  const limpiarTodo = () => {
    cambiarFiltro(() => {
      setBusqueda("");
      setEquipoSeleccionado("");
      setFechaDesde(rangoInicial.desde);
      setFechaHasta(rangoInicial.hasta);
      orden.reiniciar();
    });
  };

  // El orden no cambia las filas, así que no cuenta para el vacío "por
  // filtros": solo búsqueda, equipo y un rango distinto al de apertura.
  const hayFiltros =
    busqueda.trim() !== "" ||
    equipoSeleccionado !== "" ||
    fechaDesde !== rangoInicial.desde ||
    fechaHasta !== rangoInicial.hasta;

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => cambiarFiltro(() => setBusqueda("")),
    },
    {
      clave: "equipo",
      etiqueta: "Equipo",
      valor:
        equipos.find((equipo) => String(equipo.id) === equipoSeleccionado)
          ?.nombre ?? (equipoSeleccionado !== "" ? "Equipo seleccionado" : ""),
      onQuitar: () => cambiarFiltro(() => setEquipoSeleccionado("")),
    },
    {
      clave: "periodo",
      etiqueta: "Período",
      valor: `${formatoFecha(fechaDesde)} – ${formatoFecha(fechaHasta)}`,
      visible:
        fechaDesde !== rangoInicial.desde || fechaHasta !== rangoInicial.hasta,
      onQuitar: () =>
        cambiarFiltro(() => {
          setFechaDesde(rangoInicial.desde);
          setFechaHasta(rangoInicial.hasta);
        }),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: !orden.esPorDefecto && orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  /** Botón de "Ver/ocultar N incumplidas" dentro de la celda. */
  const botonIncumplidas = (checklistId: number, cantidad: number) => (
    <BotonTexto onClick={() => toggleExpandido(checklistId)}>
      {expandidos.has(checklistId) ? "Ocultar" : `Ver ${cantidad}`}
    </BotonTexto>
  );

  return (
    <Box p="5">
      <PageHeader
        title="Historial de checklists"
        description="Cumplimiento por período, filtrado por rango de fechas y equipo."
        actions={
          <BotonCancelar onClick={recargar}>
            <LuRefreshCw aria-hidden />
            Actualizar
          </BotonCancelar>
        }
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={(valor) => cambiarFiltro(() => setBusqueda(valor))}
            placeholder="Buscar por equipo..."
          />
        }
        filtros={
          <>
            <Box minW="170px">
              <Field.Root>
                <LabelFiltro>Desde</LabelFiltro>
                <FormInput
                  type="date"
                  value={fechaDesde}
                  onChange={(e) =>
                    cambiarFiltro(() => setFechaDesde(e.target.value))
                  }
                  w="auto"
                />
              </Field.Root>
            </Box>
            <Box minW="170px">
              <Field.Root>
                <LabelFiltro>Hasta</LabelFiltro>
                <FormInput
                  type="date"
                  value={fechaHasta}
                  onChange={(e) =>
                    cambiarFiltro(() => setFechaHasta(e.target.value))
                  }
                  w="auto"
                />
              </Field.Root>
            </Box>
            <FiltroSelect
              label="Equipo"
              valor={equipoSeleccionado}
              onCambio={(valor) =>
                cambiarFiltro(() => setEquipoSeleccionado(valor))
              }
              opciones={equipos.map((equipo) => ({
                valor: String(equipo.id),
                etiqueta: equipo.nombre,
              }))}
              todos="Todos los equipos"
            />
          </>
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {error && <BannerError>{error}</BannerError>}

      {loading && <EstadoCargando>Cargando historial...</EstadoCargando>}

      {!loading && historial && checklists.length === 0 && !error && (
        hayFiltros ? (
          <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
            No hay checklists que coincidan con los filtros aplicados.
          </EstadoVacioFiltrado>
        ) : (
          <EstadoVacio>
            No hay checklists registrados en el rango seleccionado.
          </EstadoVacio>
        )
      )}

      {historial && checklists.length > 0 && (
        <>
          <Text fontSize="sm" color="fg.muted" mb="4">
            Cumplimiento general del período:{" "}
            <Text
              as="span"
              fontWeight="bold"
              color={colorPorcentaje(historial.porcentaje_cumplimiento_general)}
            >
              {historial.porcentaje_cumplimiento_general.toFixed(0)}%
            </Text>
          </Text>

          {/* Mientras se pide la página siguiente la tabla SIGUE montada (sin
              el parpadeo de desmontar/montar): solo se atenúa y se bloquean
              los clicks hasta que llega la respuesta. */}
          <Tarjeta
            opacity={loading ? 0.6 : 1}
            pointerEvents={loading ? "none" : "auto"}
            transition="opacity 0.15s"
          >
            <Table.Root variant="outline" w="100%">
              <Table.Header>
                <FilaEncabezado>
                  <EncabezadoOrdenable columna="fecha" orden={orden} ancho="media">
                    Fecha
                  </EncabezadoOrdenable>
                  <EncabezadoOrdenable columna="equipo" orden={orden} ancho="media">
                    Equipo
                  </EncabezadoOrdenable>
                  <EncabezadoOscuro ancho="angosta">Estado</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">Cumplimiento</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">
                    Incumplidas
                  </EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">
                    Acciones
                  </EncabezadoOscuro>
                </FilaEncabezado>
              </Table.Header>
              <Table.Body>
                {checklists.map((cl) => (
                  <Fragment key={cl.checklist_id}>
                    <Table.Row>
                      <Celda>{formatoFecha(cl.fecha)}</Celda>
                      <Celda>
                        <TextoTruncado texto={cl.equipo_nombre} />
                      </Celda>
                      <Celda>
                        <Badge
                          colorPalette={cl.estado === "cerrado" ? "green" : "orange"}
                          rounded="md"
                          px="2"
                          py="1"
                          textTransform="capitalize"
                          maxW="100%"
                          overflow="hidden"
                          textOverflow="ellipsis"
                        >
                          {cl.estado}
                        </Badge>
                      </Celda>
                      <Celda center>
                        <Text fontWeight="bold" color={colorPorcentaje(cl.porcentaje_cumplimiento)}>
                          {cl.porcentaje_cumplimiento.toFixed(0)}%
                        </Text>
                        <Text fontSize="xs" color="fg.muted">
                          {cl.tareas_completadas}/{cl.total_tareas}
                        </Text>
                      </Celda>
                      <Celda center>
                        {cl.tareas_incumplidas.length === 0 ? (
                          <Text fontSize="sm" color="fg.subtle">
                            —
                          </Text>
                        ) : (
                          botonIncumplidas(cl.checklist_id, cl.tareas_incumplidas.length)
                        )}
                      </Celda>
                      <Celda center>
                        <BotonAccion
                          accion="ver"
                          label="Ver detalle del checklist"
                          onClick={() => setChecklistSeleccionado(cl)}
                        />
                      </Celda>
                    </Table.Row>
                    {expandidos.has(cl.checklist_id) && (
                      <Table.Row>
                        <Table.Cell
                          colSpan={6}
                          color="fg"
                          fontSize="sm"
                          px="4"
                          py="3"
                          borderBottomWidth="1px"
                          borderColor="border.subtle"
                          bg="red.50"
                        >
                          <Text fontSize="sm" fontWeight="bold" color="red.fg" mb="2">
                            Tareas incumplidas:
                          </Text>
                          {cl.tareas_incumplidas.map((t, i) => (
                            <Text key={t.tarea_id ?? i} fontSize="sm" color="fg.muted">
                              • {t.nombre}
                            </Text>
                          ))}
                        </Table.Cell>
                      </Table.Row>
                    )}
                  </Fragment>
                ))}
              </Table.Body>
            </Table.Root>
          </Tarjeta>

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}

          {checklistSeleccionado && (
            <DetalleChecklistDialog
              isOpen
              checklist={checklistSeleccionado}
              onClose={() => setChecklistSeleccionado(null)}
            />
          )}
        </>
      )}
    </Box>
  );
}
</file>

<file path="frontend/src/features/documentos/pages/documentosPages.tsx">
import { useState } from "react";
import { useNavigate } from "react-router-dom";
import { Badge, Box, Button, HStack, Spinner, Table, Text } from "@chakra-ui/react";
import {
  BannerError,
  BotonAccion,
  BotonTexto,
  Celda,
  EncabezadoOscuro,
  FilaEncabezado,
  PageHeader,
  Paginacion,
  Tarjeta,
  TextoTruncado,
} from "../../../components/ui/patrones";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EncabezadoOrdenable,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../components/ui/filtros";
import { useDocumentos } from "../hooks/useDocumentos";
import type { ColumnaOrdenDocumento } from "../services/documentoService";
import { useOrdenTabla } from "../../../common/hooks/useOrdenTabla";
import { useValorDebounced } from "../../../common/hooks/useValorDebounced";
import { abrirArchivo } from "../services/documentoService";
import { ESTADOS_DOCUMENTO, TIPOS_DOCUMENTO } from "../types/documento";
import type { EstadoDocumentoFiltro, TipoDocumento } from "../types/documento";
import { etiquetaTipo, fechaCorta } from "../utils/formato";

const PAGE_SIZE = 10;

const ETIQUETAS_ORDEN: Record<ColumnaOrdenDocumento, string> = {
  nombre: "Documento",
  tipo: "Tipo",
  estado: "Estado",
};

export function DocumentosPage() {
  const navigate = useNavigate();

  const [busqueda, setBusqueda] = useState("");
  const busquedaAplicada = useValorDebounced(busqueda);
  const [tipo, setTipo] = useState<TipoDocumento | "">("");
  const [estado, setEstado] = useState<EstadoDocumentoFiltro | "">("");
  const orden = useOrdenTabla<ColumnaOrdenDocumento, "nombre_asc">(
    "nombre_asc"
  );

  const {
    documentos,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading,
    error,
  } = useDocumentos(
    {
      buscar: busquedaAplicada,
      tipo,
      estado,
      orden: orden.orden,
    },
    PAGE_SIZE
  );

  const limpiarTodo = () => {
    setBusqueda("");
    setTipo("");
    setEstado("");
    orden.reiniciar();
  };

  const hayFiltros =
    busqueda.trim() !== "" ||
    tipo !== "" ||
    estado !== "" ||
    !orden.esPorDefecto;

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "tipo",
      etiqueta: "Tipo",
      valor: etiquetaTipo(tipo),
      onQuitar: () => setTipo(""),
    },
    {
      clave: "estado",
      etiqueta: "Estado",
      valor: ESTADOS_DOCUMENTO.find((e) => e.value === estado)?.label ?? estado,
      onQuitar: () => setEstado(""),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: !orden.esPorDefecto && orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  return (
    <Box p="5">
      <PageHeader
        title="Documentos"
        description="Manuales, procedimientos y registros del sistema de calidad."
        actions={
          <Button colorPalette="brand" onClick={() => navigate("/documentos/nuevo")}>
            + Agregar
          </Button>
        }
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por nombre o tipo..."
          />
        }
        filtros={
          <>
            <FiltroSelect
              label="Tipo"
              valor={tipo}
              onCambio={(valor) => setTipo(valor as TipoDocumento | "")}
              opciones={TIPOS_DOCUMENTO.map((t) => ({
                valor: t.value,
                etiqueta: t.label,
              }))}
              todos="Todos los tipos"
              minW="200px"
            />
            <FiltroSelect
              label="Estado"
              valor={estado}
              onCambio={(valor) =>
                setEstado(valor as EstadoDocumentoFiltro | "")
              }
              opciones={ESTADOS_DOCUMENTO.map((e) => ({
                valor: e.value,
                etiqueta: e.label,
              }))}
              todos="Todos los estados"
              minW="190px"
            />
          </>
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {loading && <Spinner color="brand.500" />}
      {!loading && error && <BannerError>{error}</BannerError>}

      {!loading && !error && documentos.length === 0 && (
        hayFiltros ? (
          <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
            No hay documentos que coincidan con los filtros aplicados.
          </EstadoVacioFiltrado>
        ) : (
          <Tarjeta p="6" textAlign="center">
            <Text color="fg.muted">Todavía no hay documentos cargados.</Text>
          </Tarjeta>
        )
      )}

      {!loading && !error && documentos.length > 0 && (
        <>
          <Tarjeta overflowX="auto">
            <Table.Root variant="outline" w="100%" minW="1080px">
              <Table.Header>
                <FilaEncabezado>
                  <EncabezadoOrdenable columna="nombre" orden={orden}>
                    Documento
                  </EncabezadoOrdenable>
                  <EncabezadoOrdenable columna="tipo" orden={orden} ancho="media">
                    Tipo
                  </EncabezadoOrdenable>
                  <EncabezadoOscuro ancho="media">Versión vigente</EncabezadoOscuro>
                  <EncabezadoOrdenable
                    columna="estado"
                    orden={orden}
                    ancho="media"
                  >
                    Estado
                  </EncabezadoOrdenable>
                  <EncabezadoOscuro ancho="media">Archivadas</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="accionesAnchas">
                    Acciones
                  </EncabezadoOscuro>
                </FilaEncabezado>
              </Table.Header>
              <Table.Body>
                {documentos.map((doc) => {
                  const vigente = doc.version_vigente;
                  return (
                    <Table.Row key={doc.id}>
                      <Celda p="3">
                        <TextoTruncado texto={doc.nombre} />
                      </Celda>
                      <Celda p="3">{etiquetaTipo(doc.tipo)}</Celda>
                      <Celda p="3">
                        {vigente ? (
                          <>
                            <BotonTexto
                              onClick={() =>
                                abrirArchivo(vigente.archivo_url).catch(() =>
                                  alert("No se pudo abrir el documento"),
                                )
                              }
                            >
                              v{vigente.numero_version}
                            </BotonTexto>{" "}
                            <Text as="span" color="fg.muted" fontSize="xs">
                              (desde {fechaCorta(vigente.vigente_desde)})
                            </Text>
                          </>
                        ) : (
                          <Text as="span" color="fg.subtle">
                            Sin vigente
                          </Text>
                        )}
                      </Celda>
                      <Celda p="3">
                        {vigente ? (
                          <Badge
                            colorPalette={
                              vigente.estado === "vencido"
                                ? "red"
                                : "green"
                            }
                            rounded="full"
                            px="2"
                            py="1"
                            fontSize="xs"
                            fontWeight="bold"
                          >
                            {vigente.estado === "vencido" ? "Vencido" : "Vigente"}
                          </Badge>
                        ) : (
                          <Badge
                            colorPalette="gray"
                            rounded="full"
                            px="2"
                            py="1"
                            fontSize="xs"
                            fontWeight="bold"
                          >
                            Archivado
                          </Badge>
                        )}

                        {vigente?.fecha_vencimiento && (
                          <Text color="fg.muted" fontSize="xs" mt="1">
                            Vence: {fechaCorta(vigente.fecha_vencimiento)}
                          </Text>
                        )}
                      </Celda>
                      <Celda p="3">{doc.cantidad_archivadas}</Celda>
                      <Celda p="3" center>
                        <HStack justify="center" gap="2" flexWrap="wrap" rowGap="2">
                          <BotonAccion
                            accion="historial"
                            label="Ver historial de versiones"
                            onClick={() => navigate(`/documentos/${doc.id}/historial`)}
                          />
                          <BotonAccion
                            accion="subir"
                            label="Subir nueva versión"
                            onClick={() => navigate(`/documentos/${doc.id}/nueva-version`)}
                          />
                        </HStack>
                      </Celda>
                    </Table.Row>
                  );
                })}
              </Table.Body>
            </Table.Root>
          </Tarjeta>

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}
    </Box>
  );
}
</file>

<file path="frontend/src/features/equipo/components/pages/EquipoPage.tsx">
import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import { Box, Button, Spinner } from "@chakra-ui/react";
import { EquipoTable } from "../EquipoTable";
import { ConfirmDialog } from "../../../../common/components/ConfirmDialog";
import { ConfirmarReactivacionDialog } from "../../../../common/components/ConfirmarReactivacionDialog";
import { IntervencionEquipo } from "../IntervencionEquipo";
import { HistorialCalibracionesDialog } from "../HistorialCalibracionesDialog";
import { useEquiposPaginados } from "../../hooks/useEquiposPaginados";
import { useEquipoABM } from "../../hooks/useEquipoABM";
import type { Equipo } from "../../types/equipo";
import {
  obtenerOpcionesEquipos,
  type ColumnaOrdenEquipo,
  type OpcionesEquipos,
} from "../../services/equipoService";
import { useOrdenTabla } from "../../../../common/hooks/useOrdenTabla";
import { useValorDebounced } from "../../../../common/hooks/useValorDebounced";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../../components/ui/filtros";
import {
  BannerError,
  PageHeader,
  Paginacion,
  ToggleInactivos,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

const SIN_OPCIONES: OpcionesEquipos = { tipos: [], sectores: [] };

export function EquiposPage() {
  const navigate = useNavigate();
  const [verInactivos, setVerInactivos] = useState(false);

  const [busqueda, setBusqueda] = useState("");
  const busquedaAplicada = useValorDebounced(busqueda);
  const [tipo, setTipo] = useState("");
  const [sectorId, setSectorId] = useState("");
  const [opciones, setOpciones] = useState<OpcionesEquipos>(SIN_OPCIONES);
  const orden = useOrdenTabla<ColumnaOrdenEquipo, "nombre_asc">("nombre_asc");

  const {
    equipos,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading,
    error,
    cargarEquipos,
  } = useEquiposPaginados(
    {
      incluirInactivos: verInactivos,
      buscar: busquedaAplicada,
      tipo,
      sectorId,
      orden: orden.orden,
    },
    PAGE_SIZE
  );
  const { borrar, reactivar, loading: procesando } = useEquipoABM();

  const [equipoAEliminar, setEquipoAEliminar] = useState<Equipo | null>(null);
  const [equipoAReactivar, setEquipoAReactivar] = useState<Equipo | null>(null);
  const [equipoAIntervenir, setEquipoAIntervenir] = useState<Equipo | null>(null);
  const [equipoVerHistorial, setEquipoVerHistorial] = useState<Equipo | null>(null);

  // Tipos y sectores para los selects. La página se vuelve a montar al
  // volver de un alta/edición, así que el catálogo se refresca solo.
  useEffect(() => {
    const cargarOpciones = async () => {
      try {
        setOpciones(await obtenerOpcionesEquipos());
      } catch (err) {
        console.error("Error al cargar las opciones de equipos:", err);
      }
    };
    void cargarOpciones();
  }, []);

  const limpiarTodo = () => {
    setBusqueda("");
    setTipo("");
    setSectorId("");
    orden.reiniciar();
  };

  const hayFiltros =
    busqueda.trim() !== "" || tipo !== "" || sectorId !== "";

  const ETIQUETAS_ORDEN: Record<ColumnaOrdenEquipo, string> = {
    nombre: "Nombre",
    tipo: "Tipo",
    sector: "Sector",
  };

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "tipo",
      etiqueta: "Tipo",
      valor: tipo,
      onQuitar: () => setTipo(""),
    },
    {
      clave: "sector",
      etiqueta: "Sector",
      valor:
        opciones.sectores.find((sector) => String(sector.id) === sectorId)
          ?.nombre ?? sectorId,
      onQuitar: () => setSectorId(""),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  const handleConfirmReactivar = async () => {
    if (!equipoAReactivar) return;
    try {
      await reactivar(equipoAReactivar.id, {
        nombre: equipoAReactivar.nombre,
        tipo: equipoAReactivar.tipo,
        sector_id: equipoAReactivar.sector_id,
        activo: true,
      });
      setEquipoAReactivar(null);
      await cargarEquipos();
    } catch {
      // The mutation hook exposes the failure state to this page.
    }
  };

  const handleEdit = (equipo: Equipo) =>
    navigate(`/equipos/${equipo.id}/editar`);
  const handleDeleteRequest = (equipo: Equipo) => setEquipoAEliminar(equipo);
  const handleCloseDeleteDialog = () => {
    if (!procesando) setEquipoAEliminar(null);
  };

  const handleConfirmDelete = async () => {
    if (!equipoAEliminar) return;
    try {
      await borrar(equipoAEliminar.id);
      setEquipoAEliminar(null);
      await cargarEquipos();
    } catch {
      // The mutation hook exposes the failure state to this page.
    }
  };

  return (
    <Box p="5">
      <PageHeader
        title={
          verInactivos ? "Equipos dados de baja" : "Gestión de equipos"
        }
        description="Alta, modificación y baja de los equipos del laboratorio, con su historial de intervenciones."
        actions={
          <Button colorPalette="brand" onClick={() => navigate("/equipos/nuevo")}>
            + Agregar
          </Button>
        }
      />

      <ToggleInactivos
        checked={verInactivos}
        onChange={(checked: boolean) => {
          // El hook de listado vuelve solo a la página 1 cuando cambia el filtro.
          setVerInactivos(checked);
        }}
        children="Ver dadas de baja"
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por nombre, tipo o sector..."
          />
        }
        filtros={
          <>
            <FiltroSelect
              label="Tipo"
              valor={tipo}
              onCambio={setTipo}
              opciones={opciones.tipos.map((valor) => ({
                valor,
                etiqueta: valor,
              }))}
            />
            <FiltroSelect
              label="Sector"
              valor={sectorId}
              onCambio={setSectorId}
              opciones={opciones.sectores.map((sector) => ({
                valor: String(sector.id),
                etiqueta: sector.nombre,
              }))}
              todos="Todos"
            />
          </>
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {error && <BannerError>{error}</BannerError>}
      {loading && <Spinner color="brand.500" />}

      {!loading && !error && (
        <>
          {hayFiltros && equipos.length === 0 ? (
            <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
              No hay equipos que coincidan con los filtros aplicados.
            </EstadoVacioFiltrado>
          ) : (
            <EquipoTable
              equipos={equipos}
              orden={orden}
              onEdit={handleEdit}
              onDelete={handleDeleteRequest}
              onReactivar={(equipo) => setEquipoAReactivar(equipo)}
              onIntervenir={(equipo) => setEquipoAIntervenir(equipo)}
              onVerHistorial={(equipo) => setEquipoVerHistorial(equipo)}
            />
          )}

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}

      <ConfirmDialog
        isOpen={equipoAEliminar !== null}
        titulo={
          <>
            ¿Está seguro que desea eliminar el equipo{" "}
            <strong>{equipoAEliminar?.nombre}</strong>?
          </>
        }
        mensaje="Esta acción no se puede deshacer."
        isLoading={procesando}
        onCancel={handleCloseDeleteDialog}
        onConfirm={handleConfirmDelete}
      />

      <ConfirmarReactivacionDialog
        isOpen={equipoAReactivar !== null}
        mensaje={`¿Está seguro que desea reactivar el equipo ${equipoAReactivar?.nombre}?`}
        isLoading={procesando}
        onCancel={() => {
          if (!procesando) setEquipoAReactivar(null);
        }}
        onConfirm={handleConfirmReactivar}
      />

      {/* Registro de intervención: toda la lógica vive en IntervencionEquipo. */}
      {equipoAIntervenir && (
        <IntervencionEquipo
          equipo={equipoAIntervenir}
          onCerrar={() => setEquipoAIntervenir(null)}
        />
      )}

      <HistorialCalibracionesDialog
        isOpen={equipoVerHistorial !== null}
        equipo={equipoVerHistorial}
        onClose={() => setEquipoVerHistorial(null)}
      />
    </Box>
  );
}
</file>

<file path="frontend/src/features/incidente/components/pages/IncidenteDetailPage.tsx">
import { useState } from "react";
import { useParams, useNavigate, useLocation } from "react-router-dom";
import { Badge, Box, Image, Portal, Text, VStack } from "@chakra-ui/react";
import { LuCircleCheck, LuHistory } from "react-icons/lu";
import { useIncidente } from "../../hooks/useIncidente";
import { useHistorialIncidente } from "../../hooks/useHistorialIncidente";
import { HistorialIncidenteModal } from "../HistorialIncidenteModal";
import { useImagenAutenticada } from "../../../../common/hooks/useImagenAutenticada";
import {
  estadoLabel,
  tipoLabel,
  tipoColor,
  formatoFecha,
  formatoFechaCierre,
} from "../../types/incidente";
import {
  AccionesDetalle,
  BannerError,
  BotonCancelar,
  BotonVolver,
  EstadoCargando,
  PageHeader,
} from "../../../../components/ui/patrones";

export function IncidenteDetailPage() {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const location = useLocation();
  const { incidente, loading, error } = useIncidente(Number(id));
  const { historial, loading: loadingHistorial, cargarHistorial, limpiarHistorial } = useHistorialIncidente();
  const [imagenAmpliada, setImagenAmpliada] = useState(false);
  const [mostrarHistorial, setMostrarHistorial] = useState(false);

  // Si el usuario viene de "Mis Reportes" (operador), vuelve ahí. Si viene de
  // la gestión (admin), vuelve a la lista de gestión.
  const backUrl = location.state?.from === "mis-reportes" ? "/incidentes/reportar" : "/incidentes";

  // El hook de imagen debe ir ANTES de los early returns: si no, cuando loading
  // es true o hay error, el componente retorna antes de llegar al hook y React
  // se queja de que el número de hooks cambió entre renders.
  const imagen = useImagenAutenticada(incidente?.foto_url);

  if (loading) {
    return (
      <Box p="5">
        <EstadoCargando>Cargando incidente...</EstadoCargando>
      </Box>
    );
  }

  if (error || !incidente) {
    return (
      <Box p="5" maxW="720px" mx="auto">
        <BannerError>{error || "No se encontró el incidente"}</BannerError>
        <BotonVolver mt="4" onClick={() => navigate(backUrl)}>
          Volver a la lista
        </BotonVolver>
      </Box>
    );
  }

  const cerrado = incidente.estado === "cerrado";

  const handleVerHistorial = async () => {
    setMostrarHistorial(true);
    await cargarHistorial(incidente.id);
  };

  const handleCerrarHistorial = () => {
    setMostrarHistorial(false);
    limpiarHistorial();
  };

  return (
    <>
      <Box p="5" maxW={incidente.foto_url ? "720px" : "600px"} mx="auto">
        <PageHeader
          title={`${incidente.titulo} #${incidente.id}`}
          description={`Reportado el ${formatoFecha(incidente.fecha_reporte)}`}
        />

        {/* Estado */}
        <Box mb="4">
          <Text fontSize="sm" color="fg.muted" fontWeight="medium" mb="1">
            Estado
          </Text>
          <Badge
            colorPalette={cerrado ? "green" : "red"}
            variant="subtle"
            borderRadius="md"
            px="2"
            py="1"
            fontWeight="bold"
          >
            {estadoLabel(incidente.estado)}
          </Badge>
        </Box>

        {/* Tipo */}
        <Box mb="4">
          <Text fontSize="sm" color="fg.muted" fontWeight="medium" mb="1">
            Tipo de incidente
          </Text>
          <Badge colorPalette={tipoColor(incidente.tipo)} borderRadius="md" px="2" py="1">
            {tipoLabel(incidente.tipo)}
          </Badge>
        </Box>

        {/* Descripción */}
        <Box mb="6">
          <Text fontSize="sm" color="fg.muted" fontWeight="medium" mb="2">
            Descripción
          </Text>
          <Box
            p="4"
            bg="bg.subtle"
            borderWidth="1px"
            borderColor="border"
            rounded="lg"
            whiteSpace="pre-line"
            lineHeight={1.7}
          >
            <Text fontSize="md" wordBreak="break-word">
              {incidente.descripcion}
            </Text>
          </Box>
        </Box>

        {/* Metadatos */}
        <Box
          mb="6"
          p="4"
          bg="bg.subtle"
          borderWidth="1px"
          borderColor="border"
          rounded="lg"
        >
          <VStack align="start" gap="3">
            <Text fontSize="md" wordBreak="break-word">
              <strong>Reportado por:</strong>{" "}
              {incidente.usuario_nombre ?? `Usuario #${incidente.usuario_id}`}
            </Text>
            <Text fontSize="md" wordBreak="break-word">
              <strong>Fecha y hora:</strong>{" "}
              {new Date(incidente.fecha_reporte).toLocaleString("es-AR", { timeZone: "America/Argentina/Buenos_Aires", hour12: false })}
            </Text>
            {incidente.equipo_nombre && (
              /*
               * Sin `wordBreak`, un nombre de equipo sin espacios (una sola
               * "palabra" larga) no tenía dónde cortar y se salía del
               * recuadro. Con `break-word` el texto sigue en el renglón de
               * abajo y el recuadro crece: el nombre completo se lee.
               */
              <Text fontSize="md" wordBreak="break-word">
                <strong>Equipo:</strong> {incidente.equipo_nombre}
              </Text>
            )}
          </VStack>
        </Box>

        {/* Evidencia fotográfica */}
        {incidente.foto_url && (
          <Box mb="6">
            <Text fontSize="sm" color="fg.muted" fontWeight="medium" mb="1">
              Evidencia fotográfica
            </Text>
            <Box
              display="flex"
              justifyContent="center"
              p="4"
              bg="bg.subtle"
              rounded="lg"
              borderWidth="1px"
              borderColor="border"
            >
              {imagen.loading && (
                <Text fontSize="sm" color="fg.muted">Cargando imagen...</Text>
              )}
              {!imagen.loading && imagen.error && (
                <Text fontSize="sm" color="red.fg">{imagen.error}</Text>
              )}
              {imagen.src && (
                <Image
                  src={imagen.src}
                  alt="Evidencia del incidente"
                  w="100%"
                  maxH="400px"
                  objectFit="contain"
                  rounded="lg"
                  cursor="pointer"
                  onClick={() => setImagenAmpliada(true)}
                />
              )}
            </Box>
          </Box>
        )}

        {/* Resolución: qué se hizo, cuándo y quién lo resolvió */}
        {cerrado && (
          <Box
            mb="6"
            p="4"
            bg="green.50"
            borderWidth="1px"
            borderColor="green.200"
            rounded="lg"
          >
            <Text
              fontSize="md"
              color="green.fg"
              fontWeight="bold"
              display="flex"
              alignItems="center"
              gap="2"
            >
              <LuCircleCheck size={20} aria-hidden />
              Incidente cerrado
            </Text>

            <VStack align="start" gap="2" mt="3">
              <Text fontSize="sm" color="green.fg">
                <strong>Acción correctiva:</strong>{" "}
                {incidente.observacion_cierre ?? "Sin detalle registrado."}
              </Text>
              <Text fontSize="sm" color="green.fg">
                <strong>Fecha de cierre:</strong>{" "}
                {formatoFechaCierre(incidente.fecha_cierre)}
              </Text>
              <Text fontSize="sm" color="green.fg">
                <strong>Responsable de la resolución:</strong>{" "}
                {incidente.responsable_cierre_nombre ??
                  (incidente.responsable_cierre_id
                    ? `Usuario #${incidente.responsable_cierre_id}`
                    : "-")}
              </Text>
            </VStack>
          </Box>
        )}

        {/* Acciones al pie de la ficha */}
        <AccionesDetalle>
          <BotonCancelar loading={loadingHistorial} onClick={handleVerHistorial}>
            <LuHistory aria-hidden />
            Ver historial
          </BotonCancelar>
          <BotonVolver onClick={() => navigate(backUrl)}>
            Volver a la lista
          </BotonVolver>
        </AccionesDetalle>
      </Box>

      {/* Imagen ampliada */}
      {imagenAmpliada && imagen.src && (
        <Portal>
          <Box
            position="fixed"
            inset={0}
            bg="blackAlpha.800"
            display="flex"
            alignItems="center"
            justifyContent="center"
            zIndex={2000}
            p="5"
            cursor="zoom-out"
            onClick={() => setImagenAmpliada(false)}
          >
            <Image
              src={imagen.src}
              alt="Evidencia ampliada"
              maxW="90%"
              maxH="90%"
              rounded="lg"
            />
          </Box>
        </Portal>
      )}

      {/* Modal de historial */}
      <HistorialIncidenteModal
        isOpen={mostrarHistorial}
        historial={historial}
        loading={loadingHistorial}
        onClose={handleCerrarHistorial}
      />
    </>
  );
}
</file>

<file path="frontend/src/features/incidente/components/IncidenteItem.tsx">
import { useNavigate } from "react-router-dom";
import { Badge, Box, HStack, Table, Text } from "@chakra-ui/react";
import { LuCamera, LuTriangleAlert } from "react-icons/lu";
import {
  estadoLabel,
  tipoLabel,
  tipoColor,
} from "../types/incidente";
import type { Incidente } from "../types/incidente";
import { formatoFecha as formatoFechaDia } from "../../../common/utils/fechas";
import { BotonAccion, Celda, TextoTruncado } from "../../../components/ui/patrones";
import { Tooltip } from "../../../components/ui/tooltip";

interface IncidenteItemProps {
  incidente: Incidente;
  onCerrar?: (incidente: Incidente) => void;
  onReabrir?: (incidente: Incidente) => void;
  onVer?: (incidente: Incidente) => void;
  showActions?: boolean;
}

// HU #55: Calcular si pasaron más de 7 días desde el reporte
function llevaMuchoTiempoAbierto(fechaReporte: string): boolean {
  const reporte = new Date(fechaReporte);
  const hoy = new Date();
  const diffTime = hoy.getTime() - reporte.getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays > 7;
}

export function IncidenteItem({
  incidente,
  onCerrar,
  onReabrir,
  onVer,
  showActions = true,
}: IncidenteItemProps) {
  const navigate = useNavigate();
  const cerrado = incidente.estado === "cerrado";

  const handleVer = () => {
    if (onVer) {
      onVer(incidente);
    } else {
      navigate(`/incidentes/${incidente.id}`);
    }
  };

  // Resaltado visual si está abierto y es viejo
  const esViejo = !cerrado && llevaMuchoTiempoAbierto(incidente.fecha_reporte);

  return (
    <Table.Row
      borderBottomWidth="1px"
      borderColor="border.subtle"
      opacity={cerrado ? 0.7 : 1}
      /*
       * Un incidente abierto que lleva más de una semana sin resolverse se
       * marca sin pintar la fila entera: el título pasa a rojo y debajo
       * aparece el texto "Lleva más de 7 días sin resolver". El fondo rojo
       * completo tapaba la jerarquía visual del listado (parecía un error
       * de render antes que un estado).
       */
    >
      {/*
        Solo el día en la tabla: la hora completa queda en el `title`,
        para no perderla del todo. El detalle la muestra completa.
      */}
      <Celda
        p="3"
        whiteSpace="nowrap"
        title={new Date(incidente.fecha_reporte).toLocaleString("es-AR", {
          timeZone: "America/Argentina/Buenos_Aires",
          hour12: false,
        })}
      >
        {formatoFechaDia(incidente.fecha_reporte)}
      </Celda>

      <Celda p="3" maxW="220px">
        <Text
          fontWeight="bold"
          fontSize="15px"
          lineClamp={1}
          color={esViejo ? "red.fg" : "fg"}
          title={incidente.titulo}
        >
          {incidente.titulo}
        </Text>
        {/*
          La descripción no se muestra acá: se lee en el detalle. En la
          lista solo el título, y para los cerrados, la acción correctiva.
        */}
        {cerrado && incidente.observacion_cierre && (
          <Text fontSize="xs" color="fg.subtle" mt="4px" lineClamp={2}>
            <strong>Resolución:</strong> {incidente.observacion_cierre}
          </Text>
        )}
        {esViejo && (
          <HStack gap="1" color="red.fg" fontSize="xs" fontWeight="bold" mt="4px">
            <Box as="span" display="inline-flex" flexShrink={0} aria-hidden>
              <LuTriangleAlert size={12} />
            </Box>
            <Text as="span">Lleva más de 7 días sin resolver</Text>
          </HStack>
        )}
      </Celda>

      <Celda p="3" center>
        {incidente.foto_url ? (
          <Tooltip content="Ver detalle para ver la foto" showArrow openDelay={300} closeDelay={0}>
            <Box
              display="inline-flex"
              color="brand.fg"
              role="img"
              aria-label="Tiene foto adjunta"
            >
              <LuCamera size={20} />
            </Box>
          </Tooltip>
        ) : (
          <Text color="fg.subtle">-</Text>
        )}
      </Celda>

      <Celda p="3">
        {/*
          `maxW` + ellipsis en los badges: con `table-layout: fixed` la columna
          ya no crece para acomodar la etiqueta, y "Falla / Rotura de Equipo"
          se salía de la celda. Con puntos suspensivos el texto largo se
          recorta dentro de la píldora en vez de pisar la columna de al lado.
        */}
        <Badge
          colorPalette={tipoColor(incidente.tipo)}
          borderRadius="md"
          px="2"
          py="1"
          maxW="100%"
          overflow="hidden"
          textOverflow="ellipsis"
        >
          {tipoLabel(incidente.tipo)}
        </Badge>
      </Celda>

      <Celda p="3">
        <Badge
          colorPalette={cerrado ? "green" : "red"}
          borderRadius="md"
          px="3"
          py="1"
          maxW="100%"
          overflow="hidden"
          textOverflow="ellipsis"
        >
          {estadoLabel(incidente.estado)}
        </Badge>
      </Celda>

      <Celda p="3">
        <TextoTruncado
          texto={incidente.usuario_nombre ?? `Usuario #${incidente.usuario_id}`}
        />
      </Celda>

      {showActions && (
        <Celda p="3" center>
          <HStack justify="center" gap="2" flexWrap="wrap" rowGap="2">
            <BotonAccion accion="ver" label="Ver detalle" onClick={handleVer} />
            {cerrado
              ? onReabrir && (
                  <BotonAccion
                    accion="reabrir"
                    label="Reabrir incidente"
                    onClick={() => onReabrir(incidente)}
                  />
                )
              : onCerrar && (
                  <BotonAccion
                    accion="cerrar"
                    label="Cerrar incidente"
                    onClick={() => onCerrar(incidente)}
                  />
                )}
          </HStack>
        </Celda>
      )}
    </Table.Row>
  );
}
</file>

<file path="backend/src/migrations.py">
# Este archivo contiene SQL crudo específico de SQLite.
# Solo SQLite está soportado actualmente; no se implementa soporte multi-motor.

import logging

from sqlalchemy import inspect, text

import src.all_models  # noqa: F401  (registra todos los modelos)
from src.database import engine
from src.models import ModeloBase

logger = logging.getLogger(__name__)


_SECTOR_SIN_ASIGNAR = "Sin sector asignado (migración)"


def _sector_id_conforme(inspector) -> bool:
    """Indica si equipos ya tiene la relación obligatoria con sectores."""
    columnas = {columna["name"]: columna for columna in inspector.get_columns("equipos")}
    sector_id = columnas.get("sector_id")
    if sector_id is None or sector_id["nullable"]:
        return False

    return any(
        fk["referred_table"] == "sectores"
        and fk["constrained_columns"] == ["sector_id"]
        for fk in inspector.get_foreign_keys("equipos")
    )


def _migrar_equipos_a_sectores() -> None:
    """Reemplaza la ubicación heredada por una relación obligatoria a Sector.

    SQLite no permite agregar una columna NOT NULL con FK a una tabla con filas.
    Por eso se reconstruye únicamente ``equipos`` dentro de una transacción. Las
    tablas que lo referencian conservan sus ``equipo_id`` y la columna
    ``ubicacion`` queda como historial para no descartar el dato original.
    """
    inspector = inspect(engine)
    columnas = _columnas_de(inspector, "equipos")
    tiene_ubicacion = "ubicacion" in columnas
    tiene_sector_id = "sector_id" in columnas

    with engine.connect() as conexion:
        # La reconstrucción reemplaza la tabla padre. SQLite exige desactivar
        # temporalmente las FK aun cuando los IDs de las tablas hijas no cambian.
        fk_habilitadas = conexion.execute(text("PRAGMA foreign_keys")).scalar_one()
        conexion.commit()
        if fk_habilitadas:
            conexion.execute(text("PRAGMA foreign_keys = OFF"))
            conexion.commit()

        try:
            with conexion.begin():
                total_antes = conexion.execute(
                    text("SELECT COUNT(*) FROM equipos")
                ).scalar_one()

                if tiene_ubicacion:
                    # Las ubicaciones cortas pasan a ser sectores reales. El dato
                    # original también queda en equipos.ubicacion para auditoría.
                    conexion.execute(
                        text(
                            "INSERT OR IGNORE INTO sectores (nombre, descripcion, activo) "
                            "SELECT DISTINCT TRIM(ubicacion), "
                            "'Creado automáticamente desde la ubicación histórica de equipos.', 1 "
                            "FROM equipos "
                            "WHERE ubicacion IS NOT NULL "
                            "AND TRIM(ubicacion) <> '' "
                            "AND LENGTH(TRIM(ubicacion)) <= 60"
                        )
                    )

                condicion_sin_sector = []
                if tiene_ubicacion:
                    condicion_sin_sector.append(
                        "ubicacion IS NULL OR TRIM(ubicacion) = '' "
                        "OR LENGTH(TRIM(ubicacion)) > 60"
                    )
                else:
                    condicion_sin_sector.append("1 = 1")
                if tiene_sector_id:
                    condicion_sin_sector.append(
                        "sector_id IS NULL OR sector_id NOT IN (SELECT id FROM sectores)"
                    )

                necesita_transitorio = conexion.execute(
                    text(
                        "SELECT EXISTS(SELECT 1 FROM equipos WHERE "
                        + " OR ".join(f"({condicion})" for condicion in condicion_sin_sector)
                        + ")"
                    )
                ).scalar_one()
                if necesita_transitorio:
                    conexion.execute(
                        text(
                            "INSERT OR IGNORE INTO sectores (nombre, descripcion, activo) "
                            "VALUES (:nombre, :descripcion, 1)"
                        ),
                        {
                            "nombre": _SECTOR_SIN_ASIGNAR,
                            "descripcion": (
                                "Asignación transitoria para equipos migrados sin "
                                "una ubicación válida. Reasignar desde Gestión de equipos."
                            ),
                        },
                    )

                columnas_destino = [
                    "id",
                    "nombre",
                    "tipo",
                    "activo",
                    "frecuencia_calibracion_dias",
                ]
                expresiones_origen = [
                    "id",
                    "nombre",
                    "tipo",
                    "activo",
                    "frecuencia_calibracion_dias",
                ]
                if tiene_ubicacion:
                    columnas_destino.insert(3, "ubicacion")
                    expresiones_origen.insert(3, "ubicacion")

                sectores_candidatos = []
                if tiene_sector_id:
                    sectores_candidatos.append(
                        "(SELECT id FROM sectores WHERE id = equipos.sector_id)"
                    )
                if tiene_ubicacion:
                    sectores_candidatos.append(
                        "(SELECT id FROM sectores "
                        "WHERE nombre = TRIM(equipos.ubicacion))"
                    )
                sectores_candidatos.append(
                    "(SELECT id FROM sectores WHERE nombre = :sector_sin_asignar)"
                )

                definicion_ubicacion = "ubicacion VARCHAR(100) NOT NULL, " if tiene_ubicacion else ""
                conexion.execute(
                    text(
                        "CREATE TABLE equipos_migracion_sector ("
                        "id INTEGER NOT NULL, "
                        "nombre VARCHAR(100) NOT NULL, "
                        "tipo VARCHAR(100) NOT NULL, "
                        + definicion_ubicacion
                        + "activo BOOLEAN NOT NULL, "
                        "frecuencia_calibracion_dias INTEGER, "
                        "sector_id INTEGER NOT NULL REFERENCES sectores(id), "
                        "PRIMARY KEY (id)"
                        ")"
                    )
                )
                conexion.execute(
                    text(
                        "INSERT INTO equipos_migracion_sector ("
                        + ", ".join(columnas_destino + ["sector_id"])
                        + ") SELECT "
                        + ", ".join(expresiones_origen)
                        + ", COALESCE("
                        + ", ".join(sectores_candidatos)
                        + ") FROM equipos"
                    ),
                    {"sector_sin_asignar": _SECTOR_SIN_ASIGNAR},
                )

                total_despues = conexion.execute(
                    text("SELECT COUNT(*) FROM equipos_migracion_sector")
                ).scalar_one()
                if total_despues != total_antes:
                    raise RuntimeError(
                        "La migración de equipos no conservó la cantidad de registros "
                        f"({total_antes} antes, {total_despues} después)."
                    )

                conexion.execute(text("DROP TABLE equipos"))
                conexion.execute(
                    text("ALTER TABLE equipos_migracion_sector RENAME TO equipos")
                )
                conexion.execute(
                    text("CREATE INDEX ix_equipos_nombre ON equipos (nombre)")
                )
                conexion.execute(
                    text("CREATE INDEX ix_equipos_sector_id ON equipos (sector_id)")
                )
        finally:
            if fk_habilitadas:
                conexion.execute(text("PRAGMA foreign_keys = ON"))
                conexion.commit()


def _columnas_de(inspector, tabla: str) -> set:
    return {columna["name"] for columna in inspector.get_columns(tabla)}


def _marcar_migracion(clave: str) -> None:
    """Registra que una migración de una sola vez ya corrió."""
    with engine.begin() as conexion:
        conexion.execute(
            text("INSERT OR IGNORE INTO schema_migrations (clave) VALUES (:clave)"),
            {"clave": clave},
        )


def _migracion_ya_corrio(clave: str) -> bool:
    inspector = inspect(engine)
    if "schema_migrations" not in set(inspector.get_table_names()):
        return False
    with engine.begin() as conexion:
        return (
            conexion.execute(
                text("SELECT 1 FROM schema_migrations WHERE clave = :clave"),
                {"clave": clave},
            ).scalar_one_or_none()
            is not None
        )


def run_migrations() -> None:
    inspector = inspect(engine)
    tablas = set(inspector.get_table_names())

    # Bitácora de las migraciones que no deben repetirse.
    if "schema_migrations" not in tablas:
        logger.info("Migración: creando la tabla schema_migrations")
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "CREATE TABLE IF NOT EXISTS schema_migrations ("
                    "clave TEXT PRIMARY KEY, "
                    "aplicada_en DATETIME DEFAULT CURRENT_TIMESTAMP)"
                )
            )

    if "personal" in tablas and "es_super_admin" not in _columnas_de(inspector, "personal"):
        logger.info("Migración: agregando columna personal.es_super_admin")
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "ALTER TABLE personal "
                    "ADD COLUMN es_super_admin BOOLEAN NOT NULL DEFAULT 0"
                )
            )

    if "personal" in tablas and "debe_cambiar_password" not in _columnas_de(inspector, "personal"):
        logger.info("Migración: agregando columna personal.debe_cambiar_password")
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "ALTER TABLE personal "
                    "ADD COLUMN debe_cambiar_password BOOLEAN NOT NULL DEFAULT 0"
                )
            )

    if "personal" in tablas and "password_changed_at" not in _columnas_de(inspector, "personal"):
        logger.info("Migración: agregando columna personal.password_changed_at")
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "ALTER TABLE personal "
                    "ADD COLUMN password_changed_at DATETIME"
                )
            )

    if "versiones_documento" in tablas:
        columnas = _columnas_de(inspect(engine), "versiones_documento")

        if "fecha_vencimiento" not in columnas:
            logger.info(
                "Migración: agregando columna "
                "versiones_documento.fecha_vencimiento"
            )

            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE versiones_documento "
                        "ADD COLUMN fecha_vencimiento DATE"
                    )
                )

    if "incidentes" in tablas:
        columnas = _columnas_de(inspector, "incidentes")

        if "estado" not in columnas:
            logger.info("Migración: agregando columna incidentes.estado")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE incidentes "
                        "ADD COLUMN estado VARCHAR(20) NOT NULL DEFAULT 'abierto'"
                    )
                )

            # Los que estaban dados de baja (activo = 0) pasan a cerrado.
            if "activo" in columnas:
                with engine.begin() as conexion:
                    actualizados = conexion.execute(
                        text(
                            "UPDATE incidentes SET estado = 'cerrado' "
                            "WHERE activo = 0"
                        )
                    ).rowcount
                if actualizados:
                    logger.info(
                        "Migración: %s incidentes dados de baja quedaron como "
                        "cerrados.",
                        actualizados,
                    )

        if "fecha_cierre" not in columnas:
            logger.info("Migración: agregando columna incidentes.fecha_cierre")
            with engine.begin() as conexion:
                conexion.execute(
                    text("ALTER TABLE incidentes ADD COLUMN fecha_cierre DATETIME")
                )

        if "observacion_cierre" not in columnas:
            logger.info(
                "Migración: agregando columna incidentes.observacion_cierre"
            )
            with engine.begin() as conexion:
                conexion.execute(
                    text("ALTER TABLE incidentes ADD COLUMN observacion_cierre TEXT")
                )

        if "responsable_cierre_id" not in columnas:
            logger.info(
                "Migración: agregando columna incidentes.responsable_cierre_id"
            )
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE incidentes "
                        "ADD COLUMN responsable_cierre_id INTEGER "
                        "REFERENCES personal(id)"
                    )
                )


        if "activo" in _columnas_de(inspector, "incidentes"):
            logger.info("Migración: eliminando columna incidentes.activo")
            with engine.begin() as conexion:
                conexion.execute(text("ALTER TABLE incidentes DROP COLUMN activo"))

    if "incidentes" in tablas and "titulo" not in _columnas_de(inspector, "incidentes"):
        logger.info("Migración: agregando columna incidentes.titulo")
        with engine.begin() as conexion:
            conexion.execute(
                text("ALTER TABLE incidentes ADD COLUMN titulo VARCHAR(60)")
            )

            conexion.execute(
                text(
                    "UPDATE incidentes SET titulo = "
                    "CASE WHEN descripcion IS NULL OR TRIM(descripcion) = '' "
                    "THEN 'Incidente sin título' "
                    "ELSE SUBSTR(TRIM(descripcion), 1, 60) END "
                    "WHERE titulo IS NULL"
                )
            )


    if (
        "registro_tareas" in tablas
        and "elemento_limpieza_id" not in _columnas_de(inspector, "registro_tareas")
    ):
        logger.info(
            "Migración: agregando columna registro_tareas.elemento_limpieza_id"
        )
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "ALTER TABLE registro_tareas "
                    "ADD COLUMN elemento_limpieza_id INTEGER "
                    "REFERENCES elementos_limpieza(id) ON DELETE SET NULL"
                )
            )

    # Instalaciones creadas antes del informe de consumo tienen la tabla pero
    # no estas dos columnas: create_all no altera tablas existentes.
    if "registro_tareas" in tablas:
        columnas = _columnas_de(inspect(engine), "registro_tareas")
        if "insumo_quimico_id" not in columnas:
            logger.info("Migración: agregando columna registro_tareas.insumo_quimico_id")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE registro_tareas "
                        "ADD COLUMN insumo_quimico_id INTEGER "
                        "REFERENCES insumos_quimicos(id) ON DELETE SET NULL"
                    )
                )
        if "cantidad_consumida" not in columnas:
            logger.info("Migración: agregando columna registro_tareas.cantidad_consumida")
            with engine.begin() as conexion:
                conexion.execute(
                    text("ALTER TABLE registro_tareas ADD COLUMN cantidad_consumida FLOAT")
                )
        if "version_stock" not in columnas:
            logger.info("Migración: agregando columna registro_tareas.version_stock")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE registro_tareas "
                        "ADD COLUMN version_stock INTEGER NOT NULL DEFAULT 0"
                    )
                )

    # Los productos que ya existían empiezan explícitamente con saldo cero.
    # No se reconstruye ni descuenta el histórico de checklist: esa información
    # no representa una carga inicial verificable.
    if "insumos_quimicos" in tablas and "stock_insumos_quimicos" in tablas:
        with engine.begin() as conexion:
            creados = conexion.execute(
                text(
                    "INSERT OR IGNORE INTO stock_insumos_quimicos "
                    "(insumo_quimico_id, cantidad_actual, actualizado_en) "
                    "SELECT id, 0, CURRENT_TIMESTAMP FROM insumos_quimicos"
                )
            ).rowcount
        if creados:
            logger.info("Migración: se inicializaron %s saldos de productos químicos.", creados)

    # Las tablas nuevas se crean con metadata.create_all() antes de esta función.
    # Estos índices se aseguran de forma idempotente para bases ya existentes.
    if "lotes_stock" in tablas:
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "CREATE INDEX IF NOT EXISTS ix_lotes_stock_proveedor_insumo_lote "
                    "ON lotes_stock (proveedor_id, insumo_quimico_id, numero_lote)"
                )
            )


    # E1 es el maestro de insumos y también de los productos elaborados. Los
    # productos históricos se migran a `insumos` con tipo='producto' y los
    # lotes quedan vinculados a ese registro por id.
    if "insumos" in tablas:
        if "tipo" not in _columnas_de(inspector, "insumos"):
            logger.info("Migración: agregando columna insumos.tipo")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE insumos ADD COLUMN tipo VARCHAR(20) "
                        "NOT NULL DEFAULT 'insumo'"
                    )
                )
            inspector = inspect(engine)
        with engine.begin() as conexion:
            conexion.execute(
                text("CREATE INDEX IF NOT EXISTS ix_insumos_tipo ON insumos (tipo)")
            )

    if "insumos" in tablas and "lotes" in tablas:
        if "producto_id" not in _columnas_de(inspector, "lotes"):
            logger.info("Migración: agregando columna lotes.producto_id")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE lotes ADD COLUMN producto_id INTEGER "
                        "REFERENCES insumos(id)"
                    )
                )
            inspector = inspect(engine)
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "CREATE INDEX IF NOT EXISTS ix_lotes_producto_id "
                    "ON lotes (producto_id)"
                )
            )

        if "unidades_medida" in tablas:
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "INSERT OR IGNORE INTO unidades_medida "
                        "(nombre, simbolo, activo) VALUES ('unidad', 'u', 1)"
                    )
                )
                unidad_id = conexion.execute(
                    text(
                        "SELECT id FROM unidades_medida "
                        "WHERE simbolo = 'u' OR nombre = 'unidad' "
                        "ORDER BY id LIMIT 1"
                    )
                ).scalar_one_or_none()

            if unidad_id is not None:
                with engine.begin() as conexion:
                    creados = 0
                    if "productos" in tablas:
                        creados += conexion.execute(
                            text(
                                "INSERT OR IGNORE INTO insumos "
                                "(nombre, unidad_medida_id, activo, tipo) "
                                "SELECT DISTINCT TRIM(nombre), :unidad_id, "
                                "COALESCE(activo, 1), 'producto' FROM productos "
                                "WHERE nombre IS NOT NULL "
                                "AND TRIM(nombre) <> ''"
                            ),
                            {"unidad_id": unidad_id},
                        ).rowcount
                    creados += conexion.execute(
                        text(
                            "INSERT OR IGNORE INTO insumos "
                            "(nombre, unidad_medida_id, activo, tipo) "
                            "SELECT DISTINCT TRIM(producto_nombre), :unidad_id, "
                            "1, 'producto' FROM lotes "
                            "WHERE producto_nombre IS NOT NULL "
                            "AND TRIM(producto_nombre) <> ''"
                        ),
                        {"unidad_id": unidad_id},
                    ).rowcount
                    actualizados = conexion.execute(
                        text(
                            "UPDATE lotes SET producto_id = ("
                            "SELECT i.id FROM insumos i "
                            "WHERE i.tipo = 'producto' "
                            "AND lower(i.nombre) = lower(TRIM(lotes.producto_nombre)) "
                            "ORDER BY i.id LIMIT 1"
                            ") WHERE producto_id IS NULL "
                            "AND producto_nombre IS NOT NULL "
                            "AND TRIM(producto_nombre) <> ''"
                        )
                    ).rowcount

                if creados:
                    logger.info(
                        "Migración: se cargaron %s productos en el maestro de insumos.",
                        creados,
                    )
                if actualizados:
                    logger.info(
                        "Migración: se vincularon %s lotes con su producto de E1.",
                        actualizados,
                    )

    if "equipos" in tablas and "frecuencia_calibracion_dias" not in _columnas_de(
        inspector, "equipos"
    ):
        logger.info(
            "Migración: agregando columna equipos.frecuencia_calibracion_dias"
        )
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "ALTER TABLE equipos "
                    "ADD COLUMN frecuencia_calibracion_dias INTEGER"
                )
            )

    if (
        "calibraciones" in tablas
        and "activo" in _columnas_de(inspector, "calibraciones")
    ):
        logger.info("Migración: eliminando columna calibraciones.activo")
        with engine.begin() as conexion:
            conexion.execute(
                text("ALTER TABLE calibraciones DROP COLUMN activo")
            )

    # 6) Calibraciones: tipo de intervención.
    #
    #    La tabla se conserva para no perder el historial existente: al agregar
    #    la columna con este default, cada registro previo queda identificado
    #    como una calibración. La restricción coincide con el modelo y evita
    #    nuevos valores ajenos a los dos tipos de intervención admitidos.
    if "calibraciones" in tablas:
        columnas = _columnas_de(inspector, "calibraciones")
        if "tipo" not in columnas:
            logger.info("Migración: agregando columna calibraciones.tipo")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE calibraciones "
                        "ADD COLUMN tipo VARCHAR(20) NOT NULL "
                        "DEFAULT 'calibracion' "
                        "CHECK (tipo IN ('calibracion', 'mantenimiento'))"
                    )
                )
        else:
            # Protege instalaciones que hubieran agregado la columna antes de
            # esta migración sin valor para filas históricas.
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "UPDATE calibraciones SET tipo = 'calibracion' "
                        "WHERE tipo IS NULL OR TRIM(tipo) = ''"
                    )
                )

    # 7) Tareas: tipo (preoperacional/operacional/postoperacional) y
    #    observaciones del administrador.
    #
    #    `tipo` es NOT NULL con default: las tareas que ya existían quedan como
    #    operacionales (el default histórico). `observaciones` es texto libre.
    if "tareas" in tablas:
        columnas = _columnas_de(inspector, "tareas")

        if "tipo" not in columnas:
            logger.info("Migración: agregando columna tareas.tipo")
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE tareas "
                        "ADD COLUMN tipo VARCHAR(30) NOT NULL DEFAULT 'operacional'"
                    )
                )

        if "observaciones" not in columnas:
            logger.info("Migración: agregando columna tareas.observaciones")
            with engine.begin() as conexion:
                conexion.execute(
                    text("ALTER TABLE tareas ADD COLUMN observaciones TEXT")
                )

    # 8) Registro de tareas: congelado del tipo y las observaciones.
    #
    #    El checklist es una foto de la tarea al generarse; las filas viejas
    #    no tienen el dato, por eso las columnas quedan en NULL (a diferencia
    #    de `tareas.tipo`, acá no se puede inventar un valor del pasado).
    if "registro_tareas" in tablas:
        columnas = _columnas_de(inspector, "registro_tareas")

        if "tipo_tarea_historico" not in columnas:
            logger.info(
                "Migración: agregando columna registro_tareas.tipo_tarea_historico"
            )
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE registro_tareas "
                        "ADD COLUMN tipo_tarea_historico VARCHAR(30)"
                    )
                )

        if "observaciones_tarea_historico" not in columnas:
            logger.info(
                "Migración: agregando columna "
                "registro_tareas.observaciones_tarea_historico"
            )
            with engine.begin() as conexion:
                conexion.execute(
                    text(
                        "ALTER TABLE registro_tareas "
                        "ADD COLUMN observaciones_tarea_historico TEXT"
                    )
                )

    # 9) Equipos: la ubicación pasó a ser su propia entidad (`sectores`).
    #
    #    El CRUD de Sector cambió el modelo de equipos (`sector_id` en vez
    #    de `ubicacion`), pero `create_all` no altera tablas existentes:
    #    una base previa a ese cambio quedaba sin la columna y TODA
    #    consulta de equipos (y la de los listados que lo incluyen:
    #    checklist, incidentes, vencimientos) reventaba con
    #    "no such column: equipos.sector_id".
    #
    #    La migración conserva los datos: cada ubicación usada se convierte
    #    en un sector y cada equipo queda asociado al suyo. La columna vieja
    #    `ubicacion` no se borra (SQLite la tolera; el ORM no la selecciona).
    inspector = inspect(engine)
    if "equipos" in set(inspector.get_table_names()) and not _sector_id_conforme(
        inspector
    ):
        logger.info("Migración: vinculando equipos existentes con sectores")
        _migrar_equipos_a_sectores()
        inspector = inspect(engine)

    if "equipos" in set(inspector.get_table_names()):
        with engine.begin() as conexion:
            conexion.execute(
                text(
                    "CREATE INDEX IF NOT EXISTS ix_equipos_sector_id "
                    "ON equipos (sector_id)"
                )
            )

    # 10) Bootstrap del primer super admin.
    #
    #    El CRUD de Sector cambió el modelo de equipos (`sector_id` en vez
    #    de `ubicacion`), pero `create_all` no altera tablas existentes:
    #    una base previa a ese cambio quedaba sin la columna y TODA
    #    consulta de equipos (y la de los listados que lo incluyen:
    #    checklist, incidentes, vencimientos) reventaba con
    #    "no such column: equipos.sector_id".
    #
    #    La migración conserva los datos: cada ubicación usada se convierte
    #    en un sector y cada equipo queda asociado al suyo. La columna vieja
    #    `ubicacion` no se borra (SQLite la tolera; el ORM no la selecciona).
    if "equipos" in tablas and "sectores" in tablas:
        columnas = _columnas_de(inspector, "equipos")

        if "sector_id" not in columnas:
            logger.info("Migración: agregando columna equipos.sector_id")
            with engine.begin() as conexion:
                if "ubicacion" in columnas:
                    # Cada ubicación usada pasa a ser un sector: mismo
                    # nombre, recortado al ancho de la columna (que es 60).
                    conexion.execute(
                        text(
                            "INSERT INTO sectores (nombre, activo) "
                            "SELECT DISTINCT SUBSTR(TRIM(ubicacion), 1, 60), 1 "
                            "FROM equipos "
                            "WHERE ubicacion IS NOT NULL AND TRIM(ubicacion) <> '' "
                            "AND NOT EXISTS ("
                            "    SELECT 1 FROM sectores s "
                            "    WHERE s.nombre = SUBSTR(TRIM(ubicacion), 1, 60))"
                        )
                    )

                conexion.execute(
                    text(
                        "ALTER TABLE equipos "
                        "ADD COLUMN sector_id INTEGER REFERENCES sectores(id)"
                    )
                )

                if "ubicacion" in columnas:
                    conexion.execute(
                        text(
                            "UPDATE equipos SET sector_id = ("
                            "    SELECT s.id FROM sectores s "
                            "    WHERE s.nombre = SUBSTR(TRIM(equipos.ubicacion), 1, 60)) "
                            "WHERE sector_id IS NULL"
                        )
                    )

                # Los equipos sin ubicación (o que no coincidan con ningún
                # sector) van a un sector genérico: en el modelo la FK es
                # NOT NULL y no puede quedar en NULL.
                conexion.execute(
                    text(
                        "INSERT INTO sectores (nombre, activo) "
                        "SELECT 'Sin sector', 1 "
                        "WHERE NOT EXISTS ("
                        "    SELECT 1 FROM sectores WHERE nombre = 'Sin sector')"
                    )
                )
                conexion.execute(
                    text(
                        "UPDATE equipos SET sector_id = "
                        "    (SELECT id FROM sectores WHERE nombre = 'Sin sector') "
                        "WHERE sector_id IS NULL"
                    )
                )

    if "equipos" in tablas:
        columnas_equipos = _columnas_de(inspect(engine), "equipos")
        if "sector_id" in columnas_equipos and "ubicacion" in columnas_equipos:
            logger.info("Migración: eliminando columna heredada equipos.ubicacion")
            with engine.begin() as conexion:
                conexion.execute(text("ALTER TABLE equipos DROP COLUMN ubicacion"))

    # 10) Bootstrap del primer super admin.
    #
    #     Antes corría en cada arranque: un super admin que se degradaba a
    #     propósito (para pasar el control) volvía a ser promovido en el
    #     siguiente reinicio, y degradar era imposible sin editar la base a mano.
    #     Ahora es de una sola vez, con bitácora en `schema_migrations`.
    if _migracion_ya_corrio("bootstrap_super_admin"):
        return

    promovido = None
    motivo = ""

    with engine.begin() as conexion:
        total = conexion.execute(text("SELECT COUNT(*) FROM personal")).scalar_one()
        ya_hay_super = conexion.execute(
            text("SELECT COUNT(*) FROM personal WHERE es_super_admin = 1")
        ).scalar_one()
        ya_hay_admin = conexion.execute(
            text(
                "SELECT COUNT(*) FROM personal "
                "WHERE puede_administrar = 1 OR es_super_admin = 1"
            )
        ).scalar_one()

        if total > 0 and ya_hay_super == 0:
            if ya_hay_admin > 0:
                consulta = (
                    "SELECT id FROM personal "
                    "WHERE puede_administrar = 1 ORDER BY id LIMIT 1"
                )
                motivo = "no existía ningún super admin"
            else:
                consulta = (
                    "SELECT id FROM personal "
                    "WHERE activo = 1 ORDER BY id LIMIT 1"
                )
                motivo = "no existía ningún administrador en la base"

            candidato = conexion.execute(text(consulta)).scalar_one_or_none()

            if candidato is not None:
                conexion.execute(
                    text("UPDATE personal SET es_super_admin = 1 WHERE id = :id"),
                    {"id": candidato},
                )
                promovido = candidato

    if promovido is not None:
        _marcar_migracion("bootstrap_super_admin")
    if promovido is not None:
        logger.warning(
            "Bootstrap: el usuario %s fue promovido a super admin (%s).",
            promovido,
            motivo,
        )


def crear_tablas_y_migrar() -> None:
    """Crea las tablas que faltan y aplica las migraciones de columnas."""
    ModeloBase.metadata.create_all(bind=engine)
    run_migrations()
</file>

<file path="backend/src/Equipo/router.py">
from datetime import date, timedelta
from typing import Literal, Optional, Union

from fastapi import APIRouter, Depends, File, Form, HTTPException, Query, UploadFile, status
from sqlalchemy import select
from sqlalchemy.orm import Session

from src.auth.dependencies import require_admin, require_operador
from src.common.archivos import guardar_archivo
from src.common.paginacion import PAGE_SIZE_MAXIMO, PAGE_SIZE_POR_DEFECTO
from src.config import CARPETA_UPLOADS
from src.database import get_db
from src.PlanCalibracionMantenimiento.models import PlanCalibracionMantenimiento
from src.PlanCalibracionMantenimiento.services import asentar_ultima_intervencion
from . import schemas, services
from .models import Calibracion, Equipo

# Sin dependencia global: cada endpoint declara lo que necesita.
# Leer la lista de equipos es parte de lo operativo (por ejemplo, para
# reportar un incidente), pero modificar el maestro es solo del administrador.
router = APIRouter(
    prefix="/equipos",
    tags=["Equipos"],
)

OrdenEquipo = Literal[
    "nombre_asc",
    "nombre_desc",
    "tipo_asc",
    "tipo_desc",
    "sector_asc",
    "sector_desc",
]

@router.post(
    "",
    response_model=schemas.EquipoResponse,
    status_code=status.HTTP_201_CREATED,
    dependencies=[Depends(require_admin)]
)
def crear_equipo(
    datos: schemas.EquipoCreate,
    db: Session = Depends(get_db)
):
    return services.crear_equipo(db, datos)

@router.get(
    "",
    response_model=Union[list[schemas.EquipoResponse], schemas.EquipoPagina],
    dependencies=[Depends(require_operador)]
)
def listar_equipos(
    incluir_inactivos: bool = False,
    buscar: Optional[str] = Query(
        None,
        max_length=100,
        description="Busca en nombre, tipo y sector (sin distinguir mayúsculas ni tildes).",
    ),
    tipo: Optional[str] = Query(None, max_length=100),
    sector_id: Optional[int] = Query(None, ge=1),
    orden: OrdenEquipo = "nombre_asc",
    page: Optional[int] = Query(
        None,
        ge=1,
        description="Número de página. Sin este parámetro se devuelve la lista completa (la usan los dropdowns y el tablero).",
    ),
    page_size: int = Query(PAGE_SIZE_POR_DEFECTO, ge=1, le=PAGE_SIZE_MAXIMO),
    db: Session = Depends(get_db),
):
    if page is None:
        return services.listar_equipos(
            db, incluir_inactivos, buscar, tipo, sector_id
        )
    items, total = services.listar_equipos_paginado(
        db,
        incluir_inactivos,
        page,
        page_size,
        buscar=buscar,
        tipo=tipo,
        sector_id=sector_id,
        orden=orden,
    )
    return schemas.EquipoPagina(items=items, total=total, page=page, page_size=page_size)


@router.get(
    "/opciones",
    response_model=schemas.EquipoOpcionesResponse,
    dependencies=[Depends(require_operador)],
)
def obtener_opciones_equipos(db: Session = Depends(get_db)):
    """Tipos y sectores para los selects del filtro de la tabla.

    Va antes de `/{equipo_id}`: si estuviera después, FastAPI intentaría
    convertir "opciones" a int y devolvería 422.
    """
    return services.obtener_opciones_equipos(db)

@router.get(
    "/{equipo_id}",
    response_model=schemas.EquipoResponse,
    dependencies=[Depends(require_operador)]
)
def obtener_equipo(
    equipo_id: int,
    db: Session = Depends(get_db)
):
    return services.obtener_equipo(db, equipo_id)

@router.patch(
    "/{equipo_id}",
    response_model=schemas.EquipoResponse,
    dependencies=[Depends(require_admin)]
)
def actualizar_equipo(
    equipo_id: int,
    datos: schemas.EquipoUpdate,
    db: Session = Depends(get_db)
):
    return services.actualizar_equipo(
        db,
        equipo_id,
        datos
    )

@router.delete(
    "/{equipo_id}",
    response_model=schemas.EquipoResponse,
    dependencies=[Depends(require_admin)]
)
def dar_de_baja_equipo(
    equipo_id: int,
    db: Session = Depends(get_db)
):
    return services.dar_de_baja_equipo(
        db,
        equipo_id
    )

# Extensiones y tamaño del archivo adjunto. Mismo criterio que las fotos de
# incidentes: el MIME que manda el navegador no alcanza, se valida acá.
EXTENSIONES_ARCHIVO_ADJUNTO = {".pdf", ".jpg", ".jpeg", ".png"}
TAMANO_MAX_ARCHIVO_ADJUNTO = 10 * 1024 * 1024  # 10 MB


@router.post(
    "/{equipo_id}/calibraciones",
    status_code=status.HTTP_201_CREATED,
    response_model=schemas.CalibracionResponse,
    dependencies=[Depends(require_operador)]
)
def registrar_intervencion_con_archivo(
    equipo_id: int,
    fecha_realizacion: date = Form(...),
    certificado: UploadFile = File(...),
    tipo: schemas.TipoIntervencion = Form("calibracion"),
    db: Session = Depends(get_db)
):
    # 1. Buscar que el equipo exista
    equipo = db.scalar(select(Equipo).where(Equipo.id == equipo_id))
    if not equipo:
        raise HTTPException(status_code=404, detail="Equipo no encontrado")

    # 2. Guardar archivo validado con helper (extensión vía Path, tamaño limitado,
    #    nombre {prefijo}_{uuid4().hex}{ext})
    prefijo = f"eq{equipo_id}"
    ruta_relativa = guardar_archivo(
        certificado,
        EXTENSIONES_ARCHIVO_ADJUNTO,
        TAMANO_MAX_ARCHIVO_ADJUNTO,
        prefijo,
        "certificados"
    )

    # 5. Calcular próximo vencimiento. Si hay un plan activo del mismo tipo,
    #    manda su periodicidad (la misma que usa el sistema de alertas). Para
    #    calibración se conserva la frecuencia propia del equipo como fallback;
    #    la regla histórica de 365 días cubre ambos tipos cuando no hay plan.
    plan_activo = db.scalar(
        select(PlanCalibracionMantenimiento).where(
            PlanCalibracionMantenimiento.equipo_id == equipo_id,
            PlanCalibracionMantenimiento.tipo == tipo,
            PlanCalibracionMantenimiento.activo.is_(True),
        )
    )
    if plan_activo is not None:
        dias_frecuencia = plan_activo.periodicidad_dias
    elif tipo == "calibracion":
        dias_frecuencia = equipo.frecuencia_calibracion_dias or 365
    else:
        dias_frecuencia = 365
    fecha_vencimiento = fecha_realizacion + timedelta(days=dias_frecuencia)

    # 6. Guardar el registro y asentar el plan correspondiente en la misma
    #    transacción: o se confirman ambos cambios, o no se confirma ninguno.
    nueva_calibracion = Calibracion(
        equipo_id=equipo_id,
        fecha_realizacion=fecha_realizacion,
        proximo_vencimiento=fecha_vencimiento,
        certificado_url=ruta_relativa,
        tipo=tipo,
    )
    db.add(nueva_calibracion)

    asentar_ultima_intervencion(db, equipo_id, tipo, fecha_realizacion)

    try:
        db.commit()
    except Exception:
        db.rollback()
        # Evita adjuntos huérfanos cuando la intervención y su plan no pueden
        # confirmarse de forma atómica en la base.
        try:
            ruta_abs = CARPETA_UPLOADS / ruta_relativa.removeprefix("uploads/")
            ruta_abs.unlink(missing_ok=True)
        except Exception:
            pass
        raise
    db.refresh(nueva_calibracion)

    return nueva_calibracion


@router.get(
    "/{equipo_id}/calibraciones",
    response_model=list[schemas.CalibracionResponse],
    dependencies=[Depends(require_operador)]
)
def ver_historial_intervenciones(
    equipo_id: int,
    db: Session = Depends(get_db)
):
    equipo = db.scalar(select(Equipo).where(Equipo.id == equipo_id))
    if not equipo:
        raise HTTPException(status_code=404, detail="Equipo no encontrado")

    # Buscamos las intervenciones ordenadas por fecha descendente.
    calibraciones = db.scalars(
        select(Calibracion)
        .where(Calibracion.equipo_id == equipo_id)
        .order_by(Calibracion.fecha_realizacion.desc())
    ).all()

    return list(calibraciones)
