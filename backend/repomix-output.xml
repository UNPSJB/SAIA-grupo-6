from datetime import date, datetime
from enum import Enum
from typing import List, Optional

from src.Equipo.models import Equipo
from src.PlanLimpieza.models import PlanLimpieza
from src.personal.models import Personal
from src.tareas.models import Tarea
from src.insumoQuimico.models import InsumoQuimico
from src.elementoLimpieza.models import ElementoLimpieza

from sqlalchemy import Boolean, Date, DateTime, Float, ForeignKey, String, Text, UniqueConstraint, Enum as SQLEnum

from sqlalchemy.orm import Mapped, mapped_column, relationship

from src.models import ModeloBase


class EstadoChecklist(str, Enum):
    ABIERTO = "abierto"
    COMPLETO = "completo"
    OBSERVADO = "observado"
    CERRADO = "cerrado"


class Checklist(ModeloBase):
    """Cabecera diaria de checklist para un equipo."""

    __tablename__ = "checklists"
    __table_args__ = (
        UniqueConstraint(
            "plan_id",
            "fecha",
            name="uq_checklist_plan_fecha",
        ),
    )

    id: Mapped[int] = mapped_column(primary_key=True, index=True)
    equipo_id: Mapped[int] = mapped_column(ForeignKey("equipos.id"), nullable=False, index=True)
    plan_id: Mapped[int] = mapped_column(
        ForeignKey("plan_limpieza.id"), nullable=False, index=True
    )
    fecha: Mapped[date] = mapped_column(Date, nullable=False, index=True)

    estado: Mapped[EstadoChecklist] = mapped_column(
        SQLEnum(EstadoChecklist),
        default=EstadoChecklist.ABIERTO,
        nullable=False
    )

    observaciones: Mapped[Optional[str]] = mapped_column(Text, nullable=True)

    supervisor_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey("personal.id"),
        nullable=True
    )

    fecha_creacion: Mapped[datetime] = mapped_column(DateTime, default=datetime.now)
    fecha_actualizacion: Mapped[Optional[datetime]] = mapped_column(
        DateTime,
        nullable=True,
        onupdate=datetime.now
    )

    equipo: Mapped["Equipo"] = relationship()
    plan: Mapped["PlanLimpieza"] = relationship()
    supervisor: Mapped[Optional["Personal"]] = relationship()

    
    registros: Mapped[List["RegistroTarea"]] = relationship(
        back_populates="checklist",
        cascade="all, delete-orphan"
    )


class RegistroTarea(ModeloBase):
    # El rastro de cada marcado vive en HistorialRegistroTarea (fuente de verdad):
    # auditar también esta fila lo registraría dos veces.
    __audit__ = False

    __tablename__ = "registro_tareas"
    __table_args__ = (
        UniqueConstraint(
            "checklist_id",
            "tarea_id",
            name="uq_registro_checklist_tarea",
        ),
    )

    id: Mapped[int] = mapped_column(primary_key=True, index=True)
    checklist_id: Mapped[int] = mapped_column(
        ForeignKey(
            "checklists.id",
            ondelete="CASCADE"
        ),
        nullable=False,
        index=True
    )

    tarea_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey(
            "tareas.id",
            ondelete="SET NULL"
        ),
        nullable=True
    )

    nombre_tarea_historico: Mapped[str] = mapped_column(String(100), nullable=False)
    descripcion_tarea_historico: Mapped[Optional[str]] = mapped_column(Text, nullable=True)

    # El tipo (preoperacional/operacional/postoperacional) y las observaciones
    # también son una foto de la tarea al momento de generarse el checklist.
    # Son opcionales porque las filas viejas (previas a esta historia) no tienen
    # el dato: solo se completan cuando la tarea los define y se congela.
    tipo_tarea_historico: Mapped[Optional[str]] = mapped_column(String(30), nullable=True)
    observaciones_tarea_historico: Mapped[Optional[str]] = mapped_column(Text, nullable=True)

    completado: Mapped[bool] = mapped_column(Boolean, default=False, nullable=False)
    fecha_completado: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True)

    usuario_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey("personal.id"),
        nullable=True
    )

    evidencia_url: Mapped[Optional[str]] = mapped_column(
        String(255),
        nullable=True
    )

    # Producto químico utilizado en esta tarea.
    # Es opcional porque no todas las tareas necesariamente
    # utilizan un producto químico.
    insumo_quimico_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey(
            "insumos_quimicos.id",
            ondelete="SET NULL"
        ),
        nullable=True
    )

    # Cantidad aproximada consumida.
    cantidad_consumida: Mapped[Optional[float]] = mapped_column(
        Float,
        nullable=True
    )

    elemento_limpieza_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey(
            "elementos_limpieza.id",
            ondelete="SET NULL"
        ),
        nullable=True
    )

    checklist: Mapped["Checklist"] = relationship(
        back_populates="registros"
    )
    tarea: Mapped[Optional["Tarea"]] = relationship()

    usuario: Mapped[Optional["Personal"]] = relationship()

    insumo_quimico: Mapped[Optional["InsumoQuimico"]] = relationship()
    
    elemento_limpieza: Mapped[Optional["ElementoLimpieza"]] = relationship()

    historial: Mapped[List["HistorialRegistroTarea"]] = relationship(
        back_populates="registro",
        order_by="HistorialRegistroTarea.fecha_evento",
        cascade="all, delete-orphan",
    )


class HistorialRegistroTarea(ModeloBase):
    """Bitácora de auditoría de un RegistroTarea. A diferencia de
    RegistroTarea (que solo guarda el estado ACTUAL y se sobrescribe en
    cada marcar_tarea), acá se agrega una fila nueva por cada evento:
    nunca se actualiza ni se borra una vez creada. Esto es lo que
    satisface el criterio "una vez marcada, la tarea no puede editarse
    sin dejar rastro del cambio" (Historia #9, fila 9)."""

    # Ya es una bitácora append-only por sí misma: no se vuelve a auditar.
    __audit__ = False

    __tablename__ = "historial_registro_tareas"

    id: Mapped[int] = mapped_column(primary_key=True, index=True)
    registro_tarea_id: Mapped[int] = mapped_column(
        ForeignKey("registro_tareas.id", ondelete="CASCADE"), nullable=False, index=True
    )
    completado: Mapped[bool] = mapped_column(Boolean, nullable=False)
    usuario_id: Mapped[Optional[int]] = mapped_column(
        ForeignKey("personal.id"), nullable=True
    )
    evidencia_url: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    # Cuándo ocurrió ESTE evento puntual. No confundir con
    # RegistroTarea.fecha_completado, que representa "cuándo quedó
    # completada la tarea actualmente" y se pisa en cada cambio.
    fecha_evento: Mapped[datetime] = mapped_column(DateTime, default=datetime.now, nullable=False)

    registro: Mapped["RegistroTarea"] = relationship(back_populates="historial")
    usuario: Mapped[Optional["Personal"]] = relationship()
