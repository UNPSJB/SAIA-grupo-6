export function ElementoLimpiezaTable({
  elementos,
  onEdit,
  onDelete,
  onReactivar,
}: ElementoLimpiezaTableProps) {
  if (elementos.length === 0) {
    return <EstadoVacio>No hay elementos de limpieza para mostrar.</EstadoVacio>;
  }

  return (
    <Tarjeta overflowX="auto">
