import { useState } from "react";
import { useNavigate } from "react-router-dom";
import { Badge, Box, Button, Flex, HStack, Text, VStack } from "@chakra-ui/react";
import { IncidenteForm } from "../IncidenteForm";
import { CeldaFoto } from "../MiniaturaFoto";
import { useIncidenteABM } from "../../hooks/useIncidenteABM";
import { useMisIncidentes } from "../../hooks/useMisIncidentes";
import { ReportarIncidenteEmptyState } from "./ReportarIncidenteEmptyState";
import { useSafeTimeout } from "../../../../common/hooks/useDelayedNavigate";
import { notificarCambioIncidentes } from "../../eventoIncidentes";
import { estadoLabel, tipoLabel, tipoColor, formatoFecha } from "../../types/incidente";
import type {
  IncidenteFormValues,
  Incidente,
  EstadoIncidente,
} from "../../types/incidente";
import {
  BannerError,
  BannerExito,
  EstadoCargando,
  PageHeader,
  Paginacion,
  Tarjeta,
  TextoTruncado,
} from "../../../../components/ui/patrones";

/** Tamaño de página de todos los listados de la app. */
const PAGE_SIZE = 10;

/**
 * Pills de navegación.
 *
 * Está FUERA del componente que las usa a propósito: si se definieran
 * adentro, React vería un tipo de componente nuevo en cada render y
 * desmontaría/remontaría el formulario, perdiendo el foco mientras se escribe.
 */
function TabButton({
  label,
  isActive,
  onClick,
}: {
  label: string;
  isActive: boolean;
  onClick: () => void;
}) {
  return (
    <Button
      type="button"
      onClick={onClick}
      variant={isActive ? "solid" : "outline"}
      colorPalette={isActive ? "brand" : "neutral"}
      fontWeight="bold"
      fontSize="sm"
      rounded="full"
      minW="180px"
      h="12"
      borderWidth="1px"
      borderColor={isActive ? "transparent" : "border.muted"}
      color={isActive ? "white" : "fg.muted"}
    >
      {label}
    </Button>
  );
}

const ESTADOS_MIS_REPORTES: { valor: EstadoIncidente | ""; etiqueta: string }[] = [
  { valor: "", etiqueta: "Todos" },
  { valor: "abierto", etiqueta: "Abiertos" },
  { valor: "cerrado", etiqueta: "Cerrados" },
];

/**
 * Filtro compacto de "Mis reportes".
 *
 * Esta vista no es una tabla de gestión: es un feed de los reportes del
 * operador dentro de la página de alta. Por eso no lleva búsqueda, orden ni
 * chips; alcanza con separar lo que sigue pendiente de lo ya resuelto.
 */
function FiltroEstadoMisReportes({
  valor,
  onCambio,
}: {
  valor: EstadoIncidente | "";
  onCambio: (estado: EstadoIncidente | "") => void;
}) {
  return (
    <HStack gap="1" role="group" aria-label="Filtrar tus incidentes por estado">
      {ESTADOS_MIS_REPORTES.map((opcion) => {
        const activo = valor === opcion.valor;
        return (
          <Button
            key={opcion.etiqueta}
            type="button"
            size="xs"
            rounded="full"
            variant={activo ? "solid" : "ghost"}
            colorPalette={activo ? "brand" : "neutral"}
            aria-pressed={activo}
            onClick={() => onCambio(opcion.valor)}
          >
            {opcion.etiqueta}
          </Button>
        );
      })}
    </HStack>
  );
}

/**
 * Tarjeta de "Mis Reportes".
 *
 * Muestra el estado porque el operador reportó algo y necesita ver si ya fue
 * resuelto, junto con la acción correctiva que dejó el administrador.
 */
function IncidenteCard({
  incidente,
  onVer,
}: {
  incidente: Incidente;
  onVer: (incidente: Incidente) => void;
}) {
  const cerrado = incidente.estado === "cerrado";

  return (
    <Box
      onClick={() => onVer(incidente)}
      role="button"
      tabIndex={0}
      onKeyDown={(e) => {
        if (e.key === "Enter" || e.key === " ") onVer(incidente);
      }}
      w="100%"
      p="4"
      rounded="lg"
      borderWidth="1px"
      borderColor="border"
      bg="bg.panel"
      transition="all 0.15s ease"
      cursor="pointer"
      _hover={{
        bg: "bg.subtle",
        borderColor: "border.muted",
        boxShadow: "sm",
      }}
    >
      <Flex justify="space-between" align="flex-start" gap="4" flexWrap="wrap">
        <Box flex="1" minW={0}>
          {/* ID + tipo + estado */}
          <Flex align="center" gap="2" flexWrap="wrap" mb="2">
            {/*
             * `wordBreak`: un título con una sola palabra larguísima no tenía
             * dónde cortar y estiraba la tarjeta más allá de su ancho.
             */}
            <Text fontWeight="bold" fontSize="sm" color="fg" wordBreak="break-word">
              #{incidente.id} — {incidente.titulo}
            </Text>
            <Badge
              colorPalette={tipoColor(incidente.tipo)}
              variant="solid"
              borderRadius="md"
              px="2"
              py="1"
              fontSize="xs"
              fontWeight="medium"
            >
              {tipoLabel(incidente.tipo)}
            </Badge>
            <Badge
              colorPalette={cerrado ? "green" : "red"}
              variant="subtle"
              borderRadius="md"
              px="2"
              py="1"
              fontSize="xs"
              fontWeight="medium"
            >
              {estadoLabel(incidente.estado)}
            </Badge>
          </Flex>

          {/* Descripción con "Ver más" */}
          <Text fontSize="sm" color="fg" lineHeight={1.55} wordBreak="break-word">
            {incidente.descripcion.length > 120
              ? `${incidente.descripcion.substring(0, 117)}...`
              : incidente.descripcion}
            {incidente.descripcion.length > 120 && (
              <Text as="span" color="brand.fg" fontWeight="bold" ml="1">
                Ver más
              </Text>
            )}
          </Text>

          {/* Si ya fue resuelto, el operador ve qué se hizo */}
          {cerrado && incidente.observacion_cierre && (
            <Text fontSize="xs" color="green.fg" mt="2" lineHeight={1.5}>
              <strong>Resolución:</strong> {incidente.observacion_cierre}
            </Text>
          )}

          {/* Meta: fecha + equipo */}
          <Flex
            align="center"
            gap="4"
            fontSize="xs"
            color="fg.muted"
            flexWrap="wrap"
            mt="2"
          >
            <Text as="span">{formatoFecha(incidente.fecha_reporte)}</Text>
            {incidente.equipo_nombre && (
              /*
               * Un nombre de equipo largo se salía de la tarjeta: el tope
               * lo recorta y `minW="0"` deja que el CSS lo termine de
               * ajustar al ancho que quede al lado de la fecha.
               */
              <TextoTruncado
                as="span"
                fontSize="xs"
                color="fg.muted"
                texto={incidente.equipo_nombre}
                minW="0"
              />
            )}
          </Flex>
        </Box>

        {/* La foto que el mismo operador adjuntó, para que la reconozca */}
        <CeldaFoto rutaFoto={incidente.foto_url} />
      </Flex>
    </Box>
  );
}

export function ReportarIncidentePage() {
  const navigate = useNavigate();
  const { alta, loading: loadingAlta, error: errorAlta } = useIncidenteABM();
  // Filtro compacto del feed: todos (default), abiertos o cerrados. El orden
  // sigue fijo en "más recientes primero".
  const [estadoMis, setEstadoMis] = useState<EstadoIncidente | "">("");
  const {
    misIncidentes,
    total,
    page,
    setPage,
    primeraPagina,
    hayVariasPaginas,
    loading: loadingMis,
    error: errorMis,
    cargarMisIncidentes,
  } = useMisIncidentes(PAGE_SIZE, estadoMis);
  const [exito, setExito] = useState(false);
  // `setTimeout` a mano: sin cleanup, si el usuario navega antes de los 3s
  // el setState corre sobre un componente ya desmontado.
  const programarAviso = useSafeTimeout();
  const [activeTab, setActiveTab] = useState<"mis-reportes" | "nuevo-incidente">("mis-reportes");

  const handleSubmit = async (values: IncidenteFormValues, foto?: File) => {
    try {
      await alta(values, foto);
      setExito(true);
      setActiveTab("mis-reportes");
      // El reporte nuevo es el más reciente y siempre nace abierto: si había
      // un filtro "Cerrados", se vuelve a "Todos" para que aparezca.
      setEstadoMis("");
      // El reporte nuevo es el más reciente: en la primera página se ve
      // apenas termina el submit, sin importar en qué página se estaba.
      primeraPagina();
      await cargarMisIncidentes();
      // Avisa al resto de las vistas (por ejemplo /incidentes) que hay un
      // incidente nuevo, para que su estadística se actualice sola.
      notificarCambioIncidentes();
      programarAviso(() => setExito(false), 3000);
    } catch {
      // El mensaje de error ya quedó en errorAlta.
    }
  };

  const handleVerDetalle = (incidente: Incidente) => {
    navigate(`/incidentes/${incidente.id}`, { state: { from: "mis-reportes" } });
  };

  return (
    <Box p="5">
      <PageHeader
        title="Reportar incidente"
        description="Registrá un incidente nuevo o seguí el estado de los que ya reportaste."
      />

      {exito && <BannerExito>Incidente registrado correctamente</BannerExito>}

      {errorAlta && <BannerError>{errorAlta}</BannerError>}

      {/* Tabs estilo pills */}
      <Flex
        mb="6"
        gap="3"
        bg="bg.subtle"
        p="1"
        rounded="full"
        borderWidth="1px"
        borderColor="border.subtle"
      >
        <TabButton
          label="Mis reportes"
          isActive={activeTab === "mis-reportes"}
          onClick={() => setActiveTab("mis-reportes")}
        />
        <TabButton
          label="Nuevo incidente"
          isActive={activeTab === "nuevo-incidente"}
          onClick={() => setActiveTab("nuevo-incidente")}
        />
      </Flex>

      {activeTab === "nuevo-incidente" && (
        <Box maxW="600px" mx="auto">
          <IncidenteForm
            onSubmit={handleSubmit}
            isLoading={loadingAlta}
            title="Registrar nuevo incidente"
            submitLabel="Reportar incidente"
          />
        </Box>
      )}

      {activeTab === "mis-reportes" && (
        <Box maxW="960px" mx="auto">
          <Tarjeta p="6">
            {/*
              El header con el filtro queda visible cuando hay resultados o
              cuando un filtro dejó la lista vacía: así se puede volver a
              "Todos" sin salir de la vista.
            */}
            {!errorMis && (misIncidentes.length > 0 || estadoMis !== "") && (
              <Flex
                justify="space-between"
                align="center"
                gap="3"
                flexWrap="wrap"
                mb="3"
              >
                <Text fontWeight="bold" fontSize="sm" color="fg.muted">
                  Tus incidentes reportados (más recientes primero)
                </Text>
                <FiltroEstadoMisReportes
                  valor={estadoMis}
                  onCambio={setEstadoMis}
                />
              </Flex>
            )}

            {loadingMis && <EstadoCargando>Cargando tus reportes...</EstadoCargando>}
            {errorMis && (
              <BannerError mb="0">Error al cargar: {errorMis}</BannerError>
            )}
            {!loadingMis &&
              !errorMis &&
              misIncidentes.length === 0 &&
              estadoMis === "" && <ReportarIncidenteEmptyState />}
            {!loadingMis &&
              !errorMis &&
              misIncidentes.length === 0 &&
              estadoMis !== "" && (
                <Box textAlign="center" py="8">
                  <Text color="fg.muted">
                    No tenés incidentes {estadoLabel(estadoMis).toLowerCase()}s.
                  </Text>
                </Box>
              )}
            {!loadingMis && !errorMis && misIncidentes.length > 0 && (
              <VStack align="stretch" gap="3">
                <VStack align="stretch" gap="2">
                  {misIncidentes.map((inc) => (
                    <IncidenteCard key={inc.id} incidente={inc} onVer={handleVerDetalle} />
                  ))}
                </VStack>

                {hayVariasPaginas && (
                  <Paginacion
                    count={total}
                    pageSize={PAGE_SIZE}
                    page={page}
                    onPageChange={setPage}
                  />
                )}
              </VStack>
            )}
          </Tarjeta>
        </Box>
      )}
    </Box>
  );
}
</file>

<file path="frontend/src/features/incidente/components/pages/IncidentesListPage.tsx">
import { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import { Box } from "@chakra-ui/react";
import { IncidenteTable } from "../IncidenteTable";
import { IncidentesPorTipoPanel } from "../IncidentesPorTipoPanel";
import { CerrarIncidenteDialog } from "../CerrarIncidenteDialog";
import { ReabrirIncidenteDialog } from "../ReabrirIncidenteDialog";
import { useIncidentes } from "../../hooks/useIncidentes";
import { useIncidenteABM } from "../../hooks/useIncidenteABM";
import { useAvisoTemporal } from "../../../../common/hooks/useDelayedNavigate";
import { useOrdenTabla } from "../../../../common/hooks/useOrdenTabla";
import {
  ESTADOS_INCIDENTE,
  TIPOS_INCIDENTE,
  ETIQUETA_PERIODO,
  estadoLabel,
} from "../../types/incidente";
import type {
  EstadoIncidente,
  Incidente,
  PeriodoRapido,
  TipoIncidente,
} from "../../types/incidente";
import type { ColumnaOrdenIncidente } from "../../services/incidenteService";
import {
  escucharCambioIncidentes,
  notificarCambioIncidentes,
} from "../../eventoIncidentes";
import { haceDiasISO, hoyISO, inicioMesISO } from "../../../../common/utils/fechas";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../../components/ui/filtros";
import {
  BannerError,
  BannerExito,
  BotonAgregar,
  EstadoCargando,
  PageHeader,
  Paginacion,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

const ETIQUETAS_ORDEN: Record<ColumnaOrdenIncidente, string> = {
  fecha: "Fecha",
  tipo: "Tipo",
  estado: "Estado",
};

export function IncidentesListPage() {
  const navigate = useNavigate();

  // HU "Ver incidentes abiertos": por defecto se listan solo los que todavía
  // no tienen una acción correctiva registrada (estado abierto).
  const [filtroEstado, setFiltroEstado] = useState<EstadoIncidente | "">("abierto");
  const [filtroTipo, setFiltroTipo] = useState<TipoIncidente | "">("");
  const [busqueda, setBusqueda] = useState("");
  const [incluirCerrados, setIncluirCerrados] = useState(false);

  // Período de la estadística: por defecto "todo", que es el comportamiento
  // original (sin acotar por fecha).
  const [periodo, setPeriodo] = useState<PeriodoRapido>("todo");
  const [fechaDesde, setFechaDesde] = useState(haceDiasISO(30));
  const [fechaHasta, setFechaHasta] = useState(hoyISO());

  // La tabla abre por fecha ascendente ("antiguos"), igual que antes: el
  // incidente más viejo arriba para resolver primero lo que más espera.
  // `columnaPorDefecto` hace que el header de Fecha ya muestre la flecha.
  const orden = useOrdenTabla<ColumnaOrdenIncidente, "antiguos">(
    "antiguos",
    "fecha"
  );

  // Todos los filtros viajan al backend, que devuelve una página de filas.
  const {
    incidentes,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading,
    error,
    cargarIncidentes,
  } = useIncidentes(
    filtroEstado,
    filtroTipo,
    busqueda,
    periodo === "todo" ? undefined : fechaDesde,
    periodo === "todo" ? undefined : fechaHasta,
    PAGE_SIZE,
    orden.orden
  );

  // Refresco automático: el alta, el cierre o la reapertura de un incidente
  // avisan por el bus y acá se vuelve a pedir la lista. Así la estadística y
  // la tabla se actualizan aunque el cambio se haya hecho en otra vista.
  useEffect(() => {
    return escucharCambioIncidentes(() => {
      void cargarIncidentes();
    });
  }, [cargarIncidentes]);

  const { cerrar, reabrir, loading: procesando } = useIncidenteABM();

  const [incidenteACerrar, setIncidenteACerrar] = useState<Incidente | null>(null);
  const [incidenteAReabrir, setIncidenteAReabrir] = useState<Incidente | null>(null);
  const { valor: mensajeAviso, avisar } = useAvisoTemporal<string>(3500);

  const handleTipoChange = (nuevo: string) => {
    setFiltroTipo(nuevo as TipoIncidente | "");
  };

  const handleEstadoChange = (nuevo: string) => {
    const nuevoEstado = nuevo as EstadoIncidente | "";
    setFiltroEstado(nuevoEstado);
    // El switch del gráfico y el select de la tabla miran el mismo universo.
    setIncluirCerrados(nuevoEstado === "");
  };

  // Al elegir un chip se recalculan las fechas; "personalizado" arranca con
  // los últimos 30 días para que el usuario solo ajuste lo que necesite.
  // "todo" no toca las fechas: sin ellas el backend cuenta el histórico.
  const handlePeriodoChange = (nuevo: PeriodoRapido) => {
    setPeriodo(nuevo);
    if (nuevo === "7d") {
      setFechaDesde(haceDiasISO(7));
      setFechaHasta(hoyISO());
    } else if (nuevo === "30d") {
      setFechaDesde(haceDiasISO(30));
      setFechaHasta(hoyISO());
    } else if (nuevo === "mes") {
      setFechaDesde(inicioMesISO());
      setFechaHasta(hoyISO());
    } else if (nuevo === "personalizado") {
      setFechaDesde(haceDiasISO(30));
      setFechaHasta(hoyISO());
    }
    setPage(1);
  };

  const limpiarTodo = () => {
    setBusqueda("");
    setFiltroTipo("");
    // "Limpiar todo" vuelve al universo completo: abiertos y cerrados. El
    // estado "abierto" de apertura es un filtro más y también se limpia.
    setFiltroEstado("");
    setIncluirCerrados(true);
    setPeriodo("todo");
    orden.reiniciar();
  };

  // El diálogo no se cierra mientras corre la petición: cerrarlo a mitad de
  // camino ocultaría el aviso de que la operación sigue en curso.
  const handleCerrarDialogClose = () => {
    if (!procesando) setIncidenteACerrar(null);
  };

  const handleReabrirDialogClose = () => {
    if (!procesando) setIncidenteAReabrir(null);
  };

  const handleCerrar = async (observacion: string) => {
    if (!incidenteACerrar) return;
    const id = incidenteACerrar.id;
    try {
      await cerrar(id, observacion);
      setIncidenteACerrar(null);
      // El bus hace que la suscripción de arriba vuelva a pedir la lista:
      // así la estadística y la tabla se actualizan sin recargar la página.
      notificarCambioIncidentes();
      avisar(`Incidente #${id} cerrado. La resolución quedó registrada.`);
    } catch {
      // El mensaje de error ya quedó en el hook.
    }
  };

  const handleReabrir = async (motivo: string) => {
    if (!incidenteAReabrir) return;
    const id = incidenteAReabrir.id;
    try {
      await reabrir(id, motivo);
      setIncidenteAReabrir(null);
      notificarCambioIncidentes();
      avisar(`Incidente #${id} reabierto. El motivo quedó registrado en el historial.`);
    } catch {
      // El mensaje de error ya quedó en el hook.
    }
  };

  // El orden no cambia las filas, así que no cuenta para el estado vacío
  // "por filtros": solo búsqueda, tipo, estado y período.
  const hayFiltros =
    filtroEstado !== "" ||
    filtroTipo !== "" ||
    busqueda.trim() !== "" ||
    periodo !== "todo";

  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "tipo",
      etiqueta: "Tipo",
      valor:
        TIPOS_INCIDENTE.find((tipo) => tipo.value === filtroTipo)?.label ??
        filtroTipo,
      onQuitar: () => setFiltroTipo(""),
    },
    {
      clave: "estado",
      etiqueta: "Estado",
      valor: filtroEstado !== "" ? estadoLabel(filtroEstado) : "",
      onQuitar: () => {
        setFiltroEstado("");
        setIncluirCerrados(true);
      },
    },
    {
      clave: "periodo",
      etiqueta: "Período",
      valor: ETIQUETA_PERIODO[periodo],
      // "Todo" es el período de apertura: no es un filtro aplicado.
      visible: periodo !== "todo",
      onQuitar: () => setPeriodo("todo"),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor:
        orden.columna !== null
          ? `${ETIQUETAS_ORDEN[orden.columna]} ${
              orden.direccion === "asc" ? "↑" : "↓"
            }`
          : "",
      visible: !orden.esPorDefecto && orden.columna !== null,
      onQuitar: orden.reiniciar,
    },
  ]);

  return (
    <Box p="5">
      <PageHeader
        title="Gestión de incidentes"
        description="Reportes, cierres y reaperturas del laboratorio."
        actions={
          <BotonAgregar onClick={() => navigate("/incidentes/reportar")}>
            Registrar incidente
          </BotonAgregar>
        }
      />

      {/* Indicador E7: incidentes por tipo — conectado al filtro de la tabla */}
      <IncidentesPorTipoPanel
        filtroTipo={filtroTipo}
        onFiltroTipoChange={(tipo) => setFiltroTipo(tipo)}
        incluirCerrados={incluirCerrados}
        onIncluirCerradosChange={(checked) => {
          setIncluirCerrados(checked);
          setFiltroEstado(checked ? "" : "abierto");
        }}
        periodo={periodo}
        onPeriodoChange={handlePeriodoChange}
        fechaDesde={fechaDesde}
        fechaHasta={fechaHasta}
        onFechaDesdeChange={(valor) => { setFechaDesde(valor); setPage(1); }}
        onFechaHastaChange={(valor) => { setFechaHasta(valor); setPage(1); }}
      />

      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por título, descripción o reportado por..."
          />
        }
        filtros={
          <>
            <FiltroSelect
              label="Estado"
              valor={filtroEstado}
              onCambio={handleEstadoChange}
              opciones={ESTADOS_INCIDENTE.map((estado) => ({
                valor: estado.value,
                etiqueta: estado.label,
              }))}
              todos="Todos los estados"
            />
            <FiltroSelect
              label="Tipo"
              valor={filtroTipo}
              onCambio={handleTipoChange}
              opciones={TIPOS_INCIDENTE.map((tipo) => ({
                valor: tipo.value,
                etiqueta: tipo.label,
              }))}
              todos="Todos los tipos"
            />
          </>
        }
      />

      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {loading && <EstadoCargando>Cargando incidentes...</EstadoCargando>}
      {!loading && error && <BannerError>{error}</BannerError>}

      {mensajeAviso && <BannerExito>{mensajeAviso}</BannerExito>}

      {!loading && !error && (
        <>
          {hayFiltros && incidentes.length === 0 ? (
            <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
              No hay incidentes que coincidan con los filtros aplicados.
            </EstadoVacioFiltrado>
          ) : (
            <IncidenteTable
              incidentes={incidentes}
              orden={orden}
              onCerrar={setIncidenteACerrar}
              onReabrir={setIncidenteAReabrir}
              onVer={(incidente) => navigate(`/incidentes/${incidente.id}`)}
              showActions={true}
              mensajeVacio="Todavía no se registraron incidentes."
            />
          )}

          {/*
            `Paginacion` espera el total de FILAS como `count`: Chakra calcula
            las páginas con `ceil(count / pageSize)`.
          */}
          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}

      <CerrarIncidenteDialog
        isOpen={incidenteACerrar !== null}
        incidente={incidenteACerrar}
        isLoading={procesando}
        onClose={handleCerrarDialogClose}
        onConfirm={handleCerrar}
      />

      <ReabrirIncidenteDialog
        isOpen={incidenteAReabrir !== null}
        incidente={incidenteAReabrir}
        isLoading={procesando}
        onClose={handleReabrirDialogClose}
        onConfirm={handleReabrir}
      />
    </Box>
  );
}
</file>

<file path="backend/src/main.py">
import logging
import os

import anyio
from fastapi.middleware.cors import CORSMiddleware

from contextlib import asynccontextmanager
from fastapi import FastAPI
from src.database import SessionLocal
from src.migrations import crear_tablas_y_migrar
from src.auth.services import purgar_revocados_vencidos
from src.uploads.router import router as uploads_router
from src.config import CARPETA_UPLOADS

# Importamos la configuración validada por Pydantic
from src.config import settings

# Importamos configuración de logger
from src.logger import setup_logging

# Importamos los routers desde nuestros módulos
# Un solo lugar importa todos los modelos: hay pares con relaciones
# bidireccionales que SQLAlchemy resuelve por registro de clases, y ese
# registro solo queda completo si alguien los importo a todos.
import src.all_models  # noqa: F401

from src.personal.router import router as personal_router
from src.auth.router import router as auth_router
from src.Equipo.router import router as equipo_router
from src.insumos.router import router as insumos_router
from src.elementoLimpieza.router import router as elementosLimpieza_router
from src.PlanLimpieza.router import router as plan_limpieza_router
from src.PlanCalibracionMantenimiento.router import (
    router as plan_calibracion_mantenimiento_router,
)
from src.tareas.router import router as tareas_router
from src.checklist.router import router as checklist_router
from src.insumoQuimico.router import router as insumoQuimico_router
from src.notificaciones.router import router as notificaciones_router
from src.unidadMedida.router import router as unidad_medida_router
from src.incidente.router import router as incidente_router
from src.vencimientoPersonal.router import router as vencimiento_personal_router
from src.aptitud.router import router as aptitud_router
from src.proveedores.router import router as proveedores_router
from src.lotes.router import router as lotes_router

from src.documentos.router import router as documentos_router
from src.vencimientos.router import router as vencimientos_router

from src.sector.router import router as sector_router

from src.auditoria.router import router as auditoria_router

# Mapeo explícito en vez de f"ROOT_PATH_{ENV}": antes, un ENV mal escrito
# (por ejemplo "DEV", que es lo que tiene el .env local) buscaba una clave
# inexistente y devolvía "" en silencio, sin avisar.
_RAIZ_POR_ENTORNO = {
    "DEVELOPMENT": "ROOT_PATH_DEVELOPMENT",
    "PRODUCTION": "ROOT_PATH_PRODUCTION",
}

ENV = settings.ENV.upper()
if ENV not in _RAIZ_POR_ENTORNO:
    raise RuntimeError(
        f"ENV={settings.ENV!r} no es válido. Usá 'DEVELOPMENT' o 'PRODUCTION' "
        f"(en .env.template está el ejemplo correcto)."
    )
ROOT_PATH = getattr(settings, _RAIZ_POR_ENTORNO[ENV])

setup_logging()
logger = logging.getLogger(__name__)


@asynccontextmanager
async def db_creation_lifespan(app: FastAPI):
    # Crea las tablas faltantes y aplica las migraciones de columnas.
    # Es DDL síncrono: en un hilo para no bloquear el event loop.
    await anyio.to_thread.run_sync(crear_tablas_y_migrar)

    # La tabla de tokens revocados crece un registro por logout y solo se
    # purgaba al expirar el token... nunca: nadie llamaba a la función.
    def _purgar_revocados() -> None:
        with SessionLocal() as db:
            borrados = purgar_revocados_vencidos(db)
            if borrados:
                logger.info("Tokens revocados vencidos purgados: %s", borrados)

    try:
        await anyio.to_thread.run_sync(_purgar_revocados)
    except Exception:  # pragma: no cover - la purga no debe impedir arrancar
        logger.warning("No se pudieron purgar los tokens revocados vencidos", exc_info=True)

    yield


app = FastAPI(
    root_path=ROOT_PATH,
    lifespan=db_creation_lifespan
)


# La carpeta de evidencias existe, pero NO se sirve como carpeta estática:
# las fotos de las tareas requieren sesión (ver src/uploads/router.py).
# Ruta anclada al backend, no al CWD del proceso.
os.makedirs(str(CARPETA_UPLOADS / "evidencias"), exist_ok=True)

origins = settings.cors_origins

app.add_middleware(
    CORSMiddleware,
    allow_origins=origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# Asociamos los routers a nuestra app
app.include_router(auth_router)
app.include_router(uploads_router)
app.include_router(personal_router)
app.include_router(insumos_router)
app.include_router(equipo_router)
app.include_router(elementosLimpieza_router)

app.include_router(sector_router)


app.include_router(plan_limpieza_router)
app.include_router(plan_calibracion_mantenimiento_router)
app.include_router(tareas_router)
app.include_router(checklist_router)
app.include_router(insumoQuimico_router)
app.include_router(notificaciones_router)
app.include_router(unidad_medida_router)
app.include_router(vencimiento_personal_router)
app.include_router(aptitud_router)
app.include_router(proveedores_router)
app.include_router(lotes_router)
app.include_router(incidente_router)
app.include_router(documentos_router)
app.include_router(vencimientos_router)
app.include_router(auditoria_router)
</file>

<file path="frontend/src/features/notificaciones/components/pages/NotificacionesPage.tsx">
import { formatoFechaOCorta } from "../../../../common/utils/fechas";
import { useEffect, useMemo, useState } from "react";
import { useNavigate } from "react-router-dom";
import {
  Badge,
  Box,
  Button,
  Field,
  Flex,
  HStack,
  Spinner,
  Table,
  Text,
  VStack,
} from "@chakra-ui/react";
import { usePaginas } from "../../../../common/hooks/usePaginas";
import { obtenerCriticidadDashboard } from "../../services/notificacionService";
import { useSafeTimeout } from "../../../../common/hooks/useDelayedNavigate";
import { registrarRecambioElemento } from "../../../elementoLimpieza/services/elementoLimpiezaService";
import type { IconType } from "react-icons";
import {
  LuArrowDown,
  LuArrowUp,
  LuArrowUpDown,
  LuBell,
  LuCircleCheck,
  LuClipboardCheck,
  LuFileText,
  LuPackage,
  LuSprayCan,
  LuTriangleAlert,
  LuUser,
  LuWrench,
} from "react-icons/lu";
import type {
  AlertaCriticidad,
  Criticidad,
  CriticidadDashboard,
  IconoCriticidad,
} from "../../types/notificacion";
import { CambiarFechaVencimientoDialog } from "../CambiarFechaVencimientoDialog";
import { ConfiguracionAlertasPanel } from "../ConfiguracionAlertasPanel";
import {
  BannerError,
  Celda,
  DialogoExito,
  EncabezadoOscuro,
  FilaEncabezado,
  FormInput,
  FormNativeSelect,
  LabelFiltro,
  PageHeader,
  Paginacion,
  Tarjeta,
  TextoTruncado,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

type FiltroOrigen =
  | "todas"
  | "ELEMENTO_LIMPIEZA"
  | "VENCIMIENTO_PERSONAL"
  | "PLAN_CALIBRACION"
  | "PLAN_MANTENIMIENTO"
  | "DOCUMENTO"
  | "CHECKLIST"
  | "INCIDENTE";
type SortColumn = "criticidad" | "plazo" | "origen" | null;
type SortDirection = "asc" | "desc";

const ORDEN_CRITICIDAD: Record<Criticidad, number> = {
  alta: 0,
  media: 1,
  baja: 2,
};

const PALETA_CRITICIDAD: Record<Criticidad, string> = {
  alta: "red",
  media: "orange",
  baja: "green",
};

const ICONO_ORIGEN: Record<IconoCriticidad, IconType> = {
  limpieza: LuSprayCan,
  calibracion: LuWrench,
  incidente: LuTriangleAlert,
  personal: LuUser,
  documento: LuFileText,
  checklist: LuClipboardCheck,
  stock: LuPackage,
};

function IconoOrigen({ icono }: { icono: IconoCriticidad }) {
  const Icono = ICONO_ORIGEN[icono];
  return <Icono size={16} aria-hidden />;
}

const ETIQUETA_ORIGEN: Record<string, string> = {
  ELEMENTO_LIMPIEZA: "Elemento de limpieza",
  VENCIMIENTO_PERSONAL: "Vencimiento de personal",
  PLAN_CALIBRACION: "Calibración",
  PLAN_MANTENIMIENTO: "Mantenimiento",
  DOCUMENTO: "Documento",
  CHECKLIST: "Checklist",
  INCIDENTE: "Incidente",
};

const ETIQUETA_ACCION: Record<string, string> = {
  ELEMENTO_LIMPIEZA: "Registrar recambio",
  VENCIMIENTO_PERSONAL: "Cambiar fecha",
  PLAN_CALIBRACION: "Gestionar calibraci├│n",
  PLAN_MANTENIMIENTO: "Gestionar mantenimiento",
  DOCUMENTO: "Ver documento",
  CHECKLIST: "Ver checklist",
  INCIDENTE: "Ver incidente",
};

function etiquetaCriticidad(criticidad: Criticidad) {
  return criticidad === "alta"
    ? "ALTA"
    : criticidad === "media"
      ? "MEDIA"
      : "BAJA";
}

function etiquetaNivelRiesgo(nivel: CriticidadDashboard["nivel_riesgo"]) {
  return nivel === "alto" ? "ALTO" : nivel === "medio" ? "MEDIO" : "BAJO";
}

function paletaNivelRiesgo(nivel: CriticidadDashboard["nivel_riesgo"]) {
  return nivel === "alto" ? "red" : nivel === "medio" ? "orange" : "green";
}

function SortIcon({
  column,
  sortColumn,
  sortDirection,
}: {
  column: Exclude<SortColumn, null>;
  sortColumn: SortColumn;
  sortDirection: SortDirection;
}) {
  if (sortColumn !== column) return <LuArrowUpDown size={14} opacity={0.4} />;
  return sortDirection === "asc" ? <LuArrowUp size={14} /> : <LuArrowDown size={14} />;
}

function normalizar(texto: string) {
  return texto.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

export function NotificacionesPage() {
  const navigate = useNavigate();
  const delayed = useSafeTimeout();

  const [datos, setDatos] = useState<CriticidadDashboard>({
    nivel_riesgo: "bajo",
    total: 0,
    altas: 0,
    medias: 0,
    bajas: 0,
    alertas: [],
  });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [mensajeExito, setMensajeExito] = useState<string | null>(null);
  const [alertaEditando, setAlertaEditando] = useState<AlertaCriticidad | null>(null);
  const [recambiando, setRecambiando] = useState<string | null>(null);

  const [criticidadesSeleccionadas, setCriticidadesSeleccionadas] = useState<Criticidad[]>([]);
  const [filtroOrigen, setFiltroOrigen] = useState<FiltroOrigen>("todas");
  const [busqueda, setBusqueda] = useState("");
  const [sortColumn, setSortColumn] = useState<SortColumn>(null);
  const [sortDirection, setSortDirection] = useState<SortDirection>("asc");

  const cargar = async () => {
    try {
      setLoading(true);
      setError(null);
      const resultado = await obtenerCriticidadDashboard();
      setDatos(resultado);
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "No se pudo calcular la criticidad de la entidad",
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    const timeoutId = window.setTimeout(cargar, 0);
    return () => window.clearTimeout(timeoutId);
  }, []);

  const mostrarExito = (mensaje: string) => {
    window.dispatchEvent(new Event("actualizar_notificaciones"));
    setMensajeExito(mensaje);
    delayed(() => {
      setMensajeExito(null);
      cargar();
    }, 1500);
  };

  const handleResolver = async (alerta: AlertaCriticidad) => {
    if (alerta.origen === "ELEMENTO_LIMPIEZA" && alerta.recambio_id !== null) {
      try {
        setRecambiando(alerta.clave);
        await registrarRecambioElemento(alerta.recambio_id);
        mostrarExito("Recambio registrado correctamente.");
      } catch (e) {
        setError(
          e instanceof Error ? e.message : "No se pudo registrar el recambio",
        );
      } finally {
        setRecambiando(null);
      }
      return;
    }

    if (alerta.origen === "VENCIMIENTO_PERSONAL") {
      setAlertaEditando(alerta);
      return;
    }

    navigate(alerta.destino);
  };

  const handleFechaGuardada = () => {
    setAlertaEditando(null);
    mostrarExito("Fecha de vencimiento actualizada correctamente.");
  };

  const alertasFiltradas = useMemo(() => {
    let resultado = [...datos.alertas];

    if (busqueda.trim()) {
      const termino = normalizar(busqueda.trim());
      resultado = resultado.filter(
        (alerta) =>
          normalizar(alerta.titulo).includes(termino) ||
          normalizar(alerta.detalle).includes(termino) ||
          normalizar(alerta.motivo).includes(termino),
      );
    }

    if (criticidadesSeleccionadas.length > 0) {
      resultado = resultado.filter((alerta) =>
        criticidadesSeleccionadas.includes(alerta.criticidad),
      );
    }

    if (filtroOrigen !== "todas") {
      resultado = resultado.filter((alerta) => alerta.origen === filtroOrigen);
    }

    if (sortColumn === "criticidad") {
      resultado.sort((a, b) => {
        const diferencia =
          ORDEN_CRITICIDAD[a.criticidad] - ORDEN_CRITICIDAD[b.criticidad];
        return sortDirection === "asc" ? diferencia : -diferencia;
      });
    } else if (sortColumn === "plazo") {
      resultado.sort((a, b) => {
        const aFecha = a.plazo.startsWith("hace") ? 0 : 1;
        const bFecha = b.plazo.startsWith("hace") ? 0 : 1;
        return sortDirection === "asc" ? aFecha - bFecha : bFecha - aFecha;
      });
    } else if (sortColumn === "origen") {
      const comparar = (a: AlertaCriticidad, b: AlertaCriticidad) =>
        (ETIQUETA_ORIGEN[a.origen] ?? a.origen).localeCompare(
          ETIQUETA_ORIGEN[b.origen] ?? b.origen,
        );
      resultado.sort((a, b) => {
        const diferencia = comparar(a, b);
        return sortDirection === "asc" ? diferencia : -diferencia;
      });
    }

    return resultado;
  }, [datos.alertas, criticidadesSeleccionadas, filtroOrigen, busqueda, sortColumn, sortDirection]);

  const contadores = useMemo(() => {
    // Los contadores de origen siempre representan el conjunto que se est├í
    // visualizando, incluyendo los filtros de criticidad, b├║squeda y origen.
    // De esta forma, si se selecciona "Baja", "Elementos" muestra solamente
    // cu├íntas situaciones BAJAS provienen de elementos de limpieza.
    let base = [...datos.alertas];

    if (criticidadesSeleccionadas.length > 0) {
      base = base.filter((alerta) =>
        criticidadesSeleccionadas.includes(alerta.criticidad),
      );
    }

    if (busqueda.trim()) {
      const termino = normalizar(busqueda.trim());
      base = base.filter(
        (alerta) =>
          normalizar(alerta.titulo).includes(termino) ||
          normalizar(alerta.detalle).includes(termino) ||
          normalizar(alerta.motivo).includes(termino),
      );
    }

    if (filtroOrigen !== "todas") {
      base = base.filter((alerta) => alerta.origen === filtroOrigen);
    }

    return {
      todas: base.length,
      elementos: base.filter((a) => a.origen === "ELEMENTO_LIMPIEZA").length,
      personal: base.filter((a) => a.origen === "VENCIMIENTO_PERSONAL").length,
      calibracion: base.filter((a) => a.origen === "PLAN_CALIBRACION").length,
      mantenimiento: base.filter((a) => a.origen === "PLAN_MANTENIMIENTO").length,
      documentos: base.filter((a) => a.origen === "DOCUMENTO").length,
      checklists: base.filter((a) => a.origen === "CHECKLIST").length,
      incidentes: base.filter((a) => a.origen === "INCIDENTE").length,
    };
  }, [datos.alertas, criticidadesSeleccionadas, filtroOrigen, busqueda]);

  const {
    paginados: alertasPaginadas,
    page,
    setPage,
    total,
    hayVariasPaginas,
  } = usePaginas(alertasFiltradas, PAGE_SIZE);

  const handleSort = (column: Exclude<SortColumn, null>) => {
    if (sortColumn === column) {
      setSortDirection((d) => (d === "asc" ? "desc" : "asc"));
    } else {
      setSortColumn(column);
      setSortDirection("asc");
    }
    setPage(1);
  };

  const handleFiltroOrigen = (value: FiltroOrigen) => {
    setFiltroOrigen(value);
    setPage(1);
  };

  const alternarCriticidad = (criticidad: Criticidad) => {
    setCriticidadesSeleccionadas((actuales) =>
      actuales.includes(criticidad)
        ? actuales.filter((actual) => actual !== criticidad)
        : [...actuales, criticidad],
    );
    setPage(1);
  };

  const mostrarTodasLasSituaciones = () => {
    setCriticidadesSeleccionadas([]);
    setFiltroOrigen("todas");
    setBusqueda("");
    setPage(1);
  };

  const nivel = datos.nivel_riesgo;
  const nivelTexto = etiquetaNivelRiesgo(nivel);
  const nivelPaleta = paletaNivelRiesgo(nivel);

  return (
    <Box p="5">
      <PageHeader
        title={
          <HStack gap="2" flexWrap="wrap" rowGap="2">
            <LuBell aria-hidden />
            Centro de notificaciones
          </HStack>
        }
        description="Situaciones de inocuidad detectadas y priorizadas autom├íticamente seg├║n su criticidad."
      />

      <ConfiguracionAlertasPanel
        onGuardado={() => mostrarExito("Configuraci├│n guardada correctamente.")}
      />

      <DialogoExito isOpen={mensajeExito !== null} mensaje={mensajeExito ?? ""} />

      {alertaEditando && (
        <CambiarFechaVencimientoDialog
          key={alertaEditando.clave}
          vencimiento={{
            entidad_id: alertaEditando.entidad_id,
            mensaje: alertaEditando.detalle,
            fecha_referencia: alertaEditando.fecha_referencia,
          }}
          onClose={() => setAlertaEditando(null)}
          onSaved={handleFechaGuardada}
        />
      )}

      {error && <BannerError>{error}</BannerError>}

      {/* Resumen general del motor de riesgo. */}
      <Tarjeta p={{ base: "4", md: "5" }} mb="6">
        <Flex
          direction={{ base: "column", md: "row" }}
          align={{ base: "stretch", md: "center" }}
          gap={{ base: "5", md: "8" }}
        >
          {/* Nivel general de riesgo: destacado a la izquierda. */}
          <Box flex="1" minW="0">
            <Text fontSize="sm" color="fg.muted" mb="1">
              Nivel de riesgo de la entidad
            </Text>
            <Text
              fontSize={{ base: "3xl", md: "4xl" }}
              lineHeight="1.1"
              fontWeight="extrabold"
              color={`${nivelPaleta}.600`}
            >
              {nivelTexto}
            </Text>
            <Text fontSize="sm" color="fg.muted" mt="2">
              Riesgo general de inocuidad
            </Text>
          </Box>

          {/* Contador clickeable: limpia los filtros y muestra todo. */}
          <Button
            flexShrink={0}
            minW={{ base: "100%", md: "170px" }}
            minH="112px"
            h="auto"
            px="6"
            py="4"
            borderRadius="xl"
            bg="gray.50"
            color="gray.800"
            borderWidth="1px"
            borderColor="gray.200"
            variant="solid"
            _hover={{ bg: "gray.100", borderColor: "gray.300" }}
            _dark={{ bg: "gray.800", color: "white", borderColor: "gray.700" }}
            onClick={mostrarTodasLasSituaciones}
            aria-label="Mostrar todas las situaciones y limpiar los filtros"
            title="Mostrar todas las situaciones"
          >
            <VStack gap="1" align="center">
              <Text fontSize="3xl" lineHeight="1" fontWeight="bold">
                {alertasFiltradas.length}
              </Text>
              <Text fontSize="xs" letterSpacing="wider" fontWeight="bold">
                SITUACIONES
              </Text>
              <Text fontSize="xs" fontWeight="normal" color="fg.muted">
                Ver todas
              </Text>
            </VStack>
          </Button>

          {/* Filtros de criticidad acumulables, sin contadores individuales. */}
          <VStack align="stretch" gap="2" minW={{ base: "100%", md: "145px" }}>
            <Button
              justifyContent="flex-start"
              variant={criticidadesSeleccionadas.includes("alta") ? "solid" : "ghost"}
              colorPalette="red"
              size="sm"
              onClick={() => alternarCriticidad("alta")}
              aria-pressed={criticidadesSeleccionadas.includes("alta")}
              title="Filtrar situaciones de criticidad alta"
            >
              ­ƒö┤ Alta
            </Button>
            <Button
              justifyContent="flex-start"
              variant={criticidadesSeleccionadas.includes("media") ? "solid" : "ghost"}
              colorPalette="orange"
              size="sm"
              onClick={() => alternarCriticidad("media")}
              aria-pressed={criticidadesSeleccionadas.includes("media")}
              title="Filtrar situaciones de criticidad media"
            >
              ­ƒƒá Media
            </Button>
            <Button
              justifyContent="flex-start"
              variant={criticidadesSeleccionadas.includes("baja") ? "solid" : "ghost"}
              colorPalette="green"
              size="sm"
              onClick={() => alternarCriticidad("baja")}
              aria-pressed={criticidadesSeleccionadas.includes("baja")}
              title="Filtrar situaciones de criticidad baja"
            >
              ­ƒƒó Baja
            </Button>
          </VStack>
        </Flex>
      </Tarjeta>

      {/* Filtros de la gesti├│n de riesgos. */}
      <Tarjeta p="4" mb="6">
        <HStack gap="4" flexWrap="wrap" align="flex-end">
          <Box minW="220px">
            <Field.Root>
              <LabelFiltro>Origen</LabelFiltro>
              <FormNativeSelect
                value={filtroOrigen}
                onChange={(e) =>
                  handleFiltroOrigen(e.target.value as FiltroOrigen)
                }
              >
                <option value="todas">Todos ({contadores.todas})</option>
                <option value="ELEMENTO_LIMPIEZA">Elementos ({contadores.elementos})</option>
                <option value="VENCIMIENTO_PERSONAL">Personal ({contadores.personal})</option>
                <option value="PLAN_CALIBRACION">Calibraci├│n ({contadores.calibracion})</option>
                <option value="PLAN_MANTENIMIENTO">Mantenimiento ({contadores.mantenimiento})</option>
                <option value="DOCUMENTO">Documentos ({contadores.documentos})</option>
                <option value="CHECKLIST">Checklists ({contadores.checklists})</option>
                <option value="INCIDENTE">Incidentes ({contadores.incidentes})</option>
              </FormNativeSelect>
            </Field.Root>
          </Box>

          <Box minW="250px" flex="1">
            <Field.Root>
              <LabelFiltro>B├║squeda</LabelFiltro>
              <FormInput
                type="text"
                value={busqueda}
                onChange={(e) => {
                  setBusqueda(e.target.value);
                  setPage(1);
                }}
                placeholder="Buscar situaci├│n, elemento o motivo..."
              />
            </Field.Root>
          </Box>
        </HStack>
      </Tarjeta>

      {loading ? (
        <Spinner color="brand.500" />
      ) : alertasFiltradas.length === 0 ? (
        <Tarjeta p="8" textAlign="center">
          <HStack justify="center" gap="2" color="green.fg">
            <LuCircleCheck aria-hidden />
            <Text fontSize="lg" fontWeight="bold">
              No hay situaciones que requieran atenci├│n
            </Text>
          </HStack>
          <Text color="fg.muted" fontSize="sm">
            No se detectaron situaciones activas con los filtros seleccionados.
          </Text>
        </Tarjeta>
      ) : (
        <>
          <Tarjeta overflowX="auto">
            <Table.Root variant="outline" size="md" w="100%" minW="1100px">
              <Table.Header>
                <FilaEncabezado>
                  <EncabezadoOscuro ancho="angosta" onClick={() => handleSort("criticidad")}>
                    <Box display="flex" alignItems="center" gap="1" cursor="pointer" userSelect="none">
                      Criticidad
                      <SortIcon column="criticidad" sortColumn={sortColumn} sortDirection={sortDirection} />
                    </Box>
                  </EncabezadoOscuro>
                  <EncabezadoOscuro ancho="media" onClick={() => handleSort("origen")}>
                    <Box display="flex" alignItems="center" gap="1" cursor="pointer" userSelect="none">
                      Origen
                      <SortIcon column="origen" sortColumn={sortColumn} sortDirection={sortDirection} />
                    </Box>
                  </EncabezadoOscuro>
                  <EncabezadoOscuro>Situaci├│n</EncabezadoOscuro>
                  <EncabezadoOscuro ancho="media" onClick={() => handleSort("plazo")}>
                    <Box display="flex" alignItems="center" gap="1" cursor="pointer" userSelect="none">
                      Plazo
                      <SortIcon column="plazo" sortColumn={sortColumn} sortDirection={sortDirection} />
                    </Box>
                  </EncabezadoOscuro>
                  <EncabezadoOscuro>Motivo</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="acciones">Acci├│n</EncabezadoOscuro>
                </FilaEncabezado>
              </Table.Header>

              <Table.Body>
                {alertasPaginadas.map((alerta) => (
                  <Table.Row
                    key={alerta.clave}
                    _hover={{ bg: "brand.50" }}
                    transition="background 0.2s"
                  >
                    <Celda>
                      <Badge
                        colorPalette={PALETA_CRITICIDAD[alerta.criticidad]}
                        variant="subtle"
                        px="2"
                        py="1"
                        borderRadius="md"
                        fontWeight="bold"
                      >
                        {etiquetaCriticidad(alerta.criticidad)}
                      </Badge>
                    </Celda>

                    <Celda>
                      <HStack gap="2">
                        <IconoOrigen icono={alerta.icono} />
                        <Text fontSize="sm" fontWeight="medium">
                          {ETIQUETA_ORIGEN[alerta.origen] ?? alerta.origen}
                        </Text>
                      </HStack>
                    </Celda>

                    <Celda>
                      <TextoTruncado fontWeight="bold" color="fg" mb="1" texto={alerta.titulo} />
                      <TextoTruncado fontSize="sm" color="fg.muted" max={90} texto={alerta.detalle} />
                    </Celda>

                    <Celda fontSize="sm">
                      {alerta.fecha_referencia
                        ? formatoFechaOCorta(alerta.fecha_referencia)
                        : alerta.plazo}
                    </Celda>

                    <Celda>
                      <Text fontSize="sm" color="fg.muted" title={alerta.motivo}>
                        {alerta.motivo}
                      </Text>
                    </Celda>

                    <Celda center>
                      <Button
                        size="sm"
                        colorPalette="brand"
                        fontWeight="bold"
                        loading={recambiando === alerta.clave}
                        onClick={() => handleResolver(alerta)}
                      >
                        {ETIQUETA_ACCION[alerta.origen] ?? "Ver situaci├│n"}
                      </Button>
                    </Celda>
                  </Table.Row>
                ))}
              </Table.Body>
            </Table.Root>
          </Tarjeta>

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}
        </>
      )}
    </Box>
  );
}
</file>

