export function Paginacion({
  count,
  page,
  pageSize,
  onPageChange,
}: {
  /**
   * Total de FILAS, no de páginas: es el `count` de Chakra, que calcula las
   * páginas como `ceil(count / pageSize)`. Pasarle el número de páginas
   * (2 páginas con pageSize 10) daba `ceil(2/10) = 1` y la segunda página
   * quedaba inalcanzable aunque la tabla tuviera filas para ella.
   */
  count: number;
  page: number;
  pageSize: number;
  onPageChange: (page: number) => void;
}) {
  // Para « inicio y » fin: los triggers de Chakra solo cubren anterior y
  // siguiente, así que estos dos botones llaman directo a `onPageChange`.
  const totalPaginas = Math.max(1, Math.ceil(count / pageSize));

  /*
   * Mismo lenguaje visual que los botones numéricos de abajo: transparente
   * con borde sutil, hover con el fondo suave de la marca y el estado
   * deshabilitado que Chakra ya atenúa en la receta de botón.
   */
  const estiloNav: ButtonProps = {
    bg: "transparent",
    color: "brand.fg",
    borderWidth: "1px",
    borderColor: "border",
    rounded: "md",
    _hover: { bg: "brand.subtle" },
  };

  return (
    <Pagination.Root
      count={count}
      pageSize={pageSize}
      page={page}
      onPageChange={(e) => onPageChange(e.page)}
      mt="6"
    >
      {/* flexWrap (acá y no en el HStack): los botones viven todos dentro
          del mismo ButtonGroup, así que la fila que tiene que envolver en
          pantallas angostas es la del grupo. */}
      <HStack justify="center">
        <ButtonGroup variant="ghost" size="sm" flexWrap="wrap" justifyContent="center">
          {/* « inicio */}
          <IconButton
            aria-label="Primera página"
            title="Primera página"
            disabled={page <= 1}
            onClick={() => onPageChange(1)}
            {...estiloNav}
          >
            <LuChevronsLeft aria-hidden />
          </IconButton>

          {/* ‹ anterior */}
          <Pagination.PrevTrigger asChild>
            <IconButton
              aria-label="Página anterior"
              title="Página anterior"
              disabled={page <= 1}
              {...estiloNav}
            >
              <LuChevronLeft aria-hidden />
            </IconButton>
          </Pagination.PrevTrigger>

          <Pagination.Items
            render={(pageItem) => {
              const isSelected = pageItem.value === page;
              return (
                <IconButton
                  aria-label={`Página ${pageItem.value}`}
                  bg={isSelected ? "brand.600" : "transparent"}
                  color={isSelected ? "white" : "brand.fg"}
                  borderWidth={isSelected ? "0" : "1px"}
                  borderColor="border"
                  rounded="md"
                  _hover={{ bg: isSelected ? "brand.700" : "brand.subtle" }}
                >
                  {pageItem.value}
                </IconButton>
              );
            }}
          />

          {/* siguiente › */}
          <Pagination.NextTrigger asChild>
            <IconButton
              aria-label="Página siguiente"
              title="Página siguiente"
              disabled={page >= totalPaginas}
              {...estiloNav}
            >
              <LuChevronRight aria-hidden />
            </IconButton>
          </Pagination.NextTrigger>

          {/* fin » */}
          <IconButton
            aria-label="Última página"
            title="Última página"
            disabled={page >= totalPaginas}
            onClick={() => onPageChange(totalPaginas)}
            {...estiloNav}
          >
            <LuChevronsRight aria-hidden />
          </IconButton>
        </ButtonGroup>
      </HStack>
    </Pagination.Root>
  );
}

export function ToggleInactivos({
  checked,
  onChange,
  children = "Ver dadas de baja",
}: {
  checked: boolean;
  onChange: (checked: boolean) => void;
  children?: ReactNode;
}) {
  return (
    <HStack justify="flex-end" mb="6">
      <Switch.Root
        checked={checked}
        onCheckedChange={(e) => onChange(e.checked)}
        colorPalette="neutral"
      >
        <Switch.HiddenInput />
        <Switch.Control />
        <Switch.Label
          fontSize="sm"
          color="fg.muted"
          fontWeight={checked ? "bold" : "normal"}
        >
          {children}
        </Switch.Label>
      </Switch.Root>
    </HStack>
  );
}

/**
 * Aviso de operación exitosa antes de volver al listado.
 * Usa `Dialog` para que traiga foco atrapado y roles ARIA; no tiene acción
 * de cierre, conserva el comportamiento de "mostrar y redirigir".
 */
export function DialogoExito({
  isOpen,
  mensaje,
}: {
  isOpen: boolean;
  mensaje: string;
}) {
  if (!isOpen) return null;

  return (
    <DialogRoot
      open
      placement="center"
      motionPreset="none"
      closeOnEscape={false}
      closeOnInteractOutside={false}
    >
      <DialogContent
        width="400px"
        maxWidth="400px"
        p="8"
        rounded="lg"
        bg="bg.panel"
        textAlign="center"
        boxShadow="dialog"
      >
        <Box color="green.fg" display="flex" justifyContent="center" mb="2" aria-hidden>
          <LuCircleCheck size={32} />
        </Box>
        <DialogTitle fontSize="lg" fontWeight="bold" color="green.fg">
          Éxito
        </DialogTitle>
        <Text mt="3" color="fg.muted" fontSize="sm">
          {mensaje}
        </Text>
      </DialogContent>
    </DialogRoot>
  );
}
