/** Estado `hover` de `EXITO_TEXTO` → `green.emphasized`. */
export const EXITO_TEXTO_HOVER = "#155724"; // {colors.green.800}

/* ── Semánticos: error → {colors.red.*} ────────────────────────── */

/** Fondo del banner de error de los formularios → `red.muted`. */
