    )
    return schemas.PlanCalibracionMantenimientoPagina(
        items=items, total=total, page=page, page_size=page_size
    )


@router.get(
    "/{plan_id}",
    response_model=schemas.PlanCalibracionMantenimiento,
    dependencies=_DEP_ADMIN,
