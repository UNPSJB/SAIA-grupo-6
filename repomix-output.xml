<file path="backend/src/common/paginacion.py">
"""Paginación server-side compartida por todos los listados.

Antes cada tabla traía la lista completa del backend y recortaba en el
navegador (`usePaginas`), lo que pedía miles de filas para mostrar 10. Acá
vive el sobre de respuesta (`Pagina`) y la dependencia de FastAPI
(`ParamsPaginacion`) que leen `page` / `page_size` del query string.

Compatibilidad: los endpoints que además alimentan dropdowns y el dashboard
aceptan `page` como parámetro OPCIONAL. Sin `page` siguen devolviendo la
lista completa de siempre; con `page`, el sobre `Pagina`. Así los
consumidores que necesitan todo siguen funcionando sin cambios.

Uso en un router:

    @router.get("", response_model=Union[List[schemas.Insumo], schemas.InsumoPagina])
    def read_insumos(
        incluir_inactivos: bool = False,
        page: Optional[int] = Query(None, ge=1),
        page_size: int = Query(PAGE_SIZE_POR_DEFECTO, ge=1, le=PAGE_SIZE_MAXIMO),
        db: Session = Depends(get_db),
    ):
        if page is None:
            return services.listar_insumos(db, incluir_inactivos)
        items, total = services.listar_insumos_paginado(db, incluir_inactivos, page, page_size)
        return schemas.InsumoPagina(
            items=items, total=total, page=page, page_size=page_size
        )
"""

import math
from typing import Generic, List, Tuple, TypeVar

from fastapi import Query
from pydantic import BaseModel, ConfigDict, computed_field
from sqlalchemy import Select, func, select
from sqlalchemy.orm import Session

T = TypeVar("T")

PAGE_SIZE_POR_DEFECTO = 10
PAGE_SIZE_MAXIMO = 100


class ParamsPaginacion:
    """Dependencia de FastAPI para endpoints SIEMPRE paginados.

    Los endpoints con consumidores que necesitan la lista completa usan los
    parámetros sueltos con `page` opcional (ver el docstring del módulo); este
    `Depends()` es para los que solo devuelven páginas.
    """

    def __init__(
        self,
        page: int = Query(1, ge=1, description="Número de página, desde 1."),
        page_size: int = Query(
            PAGE_SIZE_POR_DEFECTO,
            ge=1,
            le=PAGE_SIZE_MAXIMO,
            description="Filas por página.",
        ),
    ) -> None:
        self.page = page
        self.page_size = page_size


class Pagina(BaseModel, Generic[T]):
    """Sobre estándar de un listado paginado en el servidor.

    `total` es la cantidad de FILAS que cumple el filtro (no de páginas), que
    es lo que el componente `Paginacion` del frontend espera como `count`.
    """

    items: List[T]
    total: int
    page: int
    page_size: int

    # from_attributes para poder armar la página directo desde el router sin
    # convertir los ORM a dict a mano.
    model_config = ConfigDict(from_attributes=True)

    @computed_field  # type: ignore[prop-decorator]
    @property
    def total_paginas(self) -> int:
        if self.page_size <= 0:
            return 1
        return max(1, math.ceil(self.total / self.page_size))


def paginar(
    db: Session, consulta: Select, page: int, page_size: int
) -> Tuple[List, int]:
    """Ejecuta la consulta acotada a la página y cuenta el total de filas.

    Devuelve `(items, total)`. La consulta tiene que traer su propio
    `ORDER BY`: sin un orden estable, `OFFSET/LIMIT` puede repetir u omitir
    filas entre páginas.

    El COUNT se hace sobre la misma consulta SIN el `ORDER BY` (con
    `.order_by(None)`): contar no necesita ordenar nada, y dejarlo dentro de
    la subconsulta hace que la base ordene todo el rango solo para contar
    (además de que en SQL Server ni siquiera es válido).
    """
    total = db.scalar(
        select(func.count()).select_from(consulta.order_by(None).subquery())
    )

    items = list(
        db.scalars(consulta.offset((page - 1) * page_size).limit(page_size)).all()
    )
    return items, int(total or 0)
</file>

<file path="backend/src/common/validators.py">
"""Validadores compartidos por los schemas del dominio.

Antes cada módulo repetía la misma expresión regular y el mismo esqueleto de
`field_validator`. Estos helpers concentran el patrón: cada módulo pasa sus
propias excepciones y el comportamiento queda uniforme.

Regla que respetan todos los helpers: **`None` se devuelve sin tocar**. Los
schemas `*Update` ensanchan su `*Base` y vuelven opcionales los campos que
heredan validadores, así que un `null` explícito en el body llega al validador.
Si no se contemplate, `v.strip()` explota con `AttributeError` y la validación
de Pydantic (que solo convierte `ValueError`) deja escapar un 500 en vez de un 400.
"""

import re
from typing import Callable, Optional

# Nombres que admiten letras, dígitos y separadores habituales.
RE_NOMBRE_GENERICO = r"^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ \-\.()]+$"
# Nombres de solo letras y espacios (personas, planes, tareas).
RE_NOMBRE_SOLO_LETRAS = r"^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]+$"
RE_DNI = r"^\d{7,8}$"
RE_EMAIL = r"^[\w\.-]+@[\w\.-]+\.\w+$"


def texto_obligatorio(
    v: Optional[str],
    *,
    invalido: Callable[[], Exception],
    vacio: Optional[Callable[[], Exception]] = None,
    patron: str = RE_NOMBRE_GENERICO,
    exigir_alfabetico: bool = False,
) -> Optional[str]:
    """Valida y normaliza (recorta) un texto obligatorio.

    `vacio` e `invalido` son callables que devuelven la excepción a lanzar:
    cada módulo pasa las suyas para conservar sus mensajes.

    `exigir_alfabetico` además rechaza textos formados solo por dígitos o
    separadores (usado por las unidades de medida, donde "..." no es un nombre).
    """
    if v is None:
        return None

    texto = v.strip()
    if not texto:
        if vacio is not None:
            raise vacio()
        raise invalido()

    if not re.match(patron, texto):
        raise invalido()

    if exigir_alfabetico and not re.search(r"[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ]", texto):
        raise invalido()

    return texto


def texto_no_vacio(v: Optional[str], *, vacio: Callable[[], Exception]) -> Optional[str]:
    """Valida que el texto tenga contenido sin imponer un patrón."""
    if v is None:
        return None
    texto = v.strip()
    if not texto:
        raise vacio()
    return texto


def texto_opcional(v: Optional[str], *, largo_maximo: Optional[int] = None) -> Optional[str]:
    """Recorta un texto libre y lo deja en `None` si queda vacío."""
    if v is None:
        return None
    texto = v.strip()
    if largo_maximo is not None:
        texto = texto[:largo_maximo]
    return texto or None


def id_positivo(v: Optional[int], *, invalido: Callable[[], Exception]) -> Optional[int]:
    """Valida que un id sea mayor a cero. Tolera `None` en los `*Update`."""
    if v is None:
        return None
    if v <= 0:
        raise invalido()
    return v


def dni_valido(v: Optional[str], *, invalido: Callable[[], Exception]) -> Optional[str]:
    if v is None:
        return None
    texto = v.strip()
    if not texto or not re.match(RE_DNI, texto):
        raise invalido()
    return texto


def email_valido(v: Optional[str], *, invalido: Callable[[], Exception]) -> Optional[str]:
    if v is None:
        return None
    texto = v.strip()
    if not texto or not re.match(RE_EMAIL, texto):
        raise invalido()
    return texto
