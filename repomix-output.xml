    incluir_inactivos: bool = False,
    buscar: Optional[str] = Query(
        None,
        max_length=100,
        description="Busca en nombre y descripción (sin distinguir mayúsculas ni tildes).",
    ),
    orden: OrdenSector = "nombre_asc",
    page: Optional[int] = Query(
        None,
        ge=1,
