import { useState } from "react";
import { Badge, Box, Button, HStack, Stack, Table, Text } from "@chakra-ui/react";

import { useOrdenTabla } from "../../../common/hooks/useOrdenTabla";
import { useValorDebounced } from "../../../common/hooks/useValorDebounced";
import {
  BarraFiltros,
  CampoBusqueda,
  ChipsFiltros,
  EncabezadoOrdenable,
  EstadoVacioFiltrado,
  FiltroSelect,
  chipsDeFiltros,
} from "../../../components/ui/filtros";
import {
  BannerError,
  BotonAccion,
  Celda,
  EncabezadoOscuro,
  EstadoCargando,
  EstadoVacio,
  FilaEncabezado,
  Paginacion,
  Tarjeta,
} from "../../../components/ui/patrones";
import { notificarCambioNotificaciones } from "../../notificaciones/eventoNotificaciones";
import { useProveedores } from "../../proveedores/hooks/useProveedores";
import { useStockAcciones } from "../hooks/useStockAcciones";
import { useStockActual } from "../hooks/useStockActual";
import type { ColumnaOrdenStock, StockInsumoQuimico } from "../types/stock";
import { StockOperacionDialog, type TipoDialogoStock } from "./StockOperacionDialog";

const PAGE_SIZE = 10;

interface DialogoAbierto {
  tipo: TipoDialogoStock;
  insumo: StockInsumoQuimico;
}

function valorDecimal(valor: number | string | null) {
  return valor === null ? "Sin definir" : String(valor);
}

export function StockActualTab() {
  const [busqueda, setBusqueda] = useState("");
  const [estado, setEstado] = useState("");
  const busquedaAplicada = useValorDebounced(busqueda);
  const orden = useOrdenTabla<ColumnaOrdenStock>("nombre_asc", "nombre");
  const stockBajo = estado === "bajo" ? true : estado === "normal" ? false : undefined;
  const {
    stock,
    total,
    page,
    setPage,
    hayVariasPaginas,
    loading,
    error,
    recargar,
  } = useStockActual({ buscar: busquedaAplicada, stockBajo, orden: orden.orden });
  const { proveedores } = useProveedores();
  const { loading: guardando, actualizarMinimo, registrarAjuste, registrarIngreso } = useStockAcciones();
  const [dialogo, setDialogo] = useState<DialogoAbierto | null>(null);

  const cerrarDialogo = () => {
    if (!guardando) setDialogo(null);
  };

  const recargarDespuesDeGuardar = async (accion: () => Promise<void>) => {
    await accion();
    await recargar();
    notificarCambioNotificaciones();
  };

  const limpiarTodo = () => {
    setBusqueda("");
    setEstado("");
    orden.reiniciar();
  };
  const hayFiltros = busqueda.trim() !== "" || estado !== "";
  const etiquetasOrden: Record<ColumnaOrdenStock, string> = {
    nombre: "Producto",
    cantidad: "Stock actual",
    minimo: "Stock mínimo",
  };
  const chips = chipsDeFiltros([
    {
      clave: "busqueda",
      etiqueta: "Búsqueda",
      valor: busqueda,
      recortar: true,
      onQuitar: () => setBusqueda(""),
    },
    {
      clave: "estado",
      etiqueta: "Estado",
      valor: estado === "bajo" ? "Stock bajo" : estado === "normal" ? "Disponible" : "",
      onQuitar: () => setEstado(""),
    },
    {
      clave: "orden",
      etiqueta: "Orden",
      valor: `${etiquetasOrden[orden.columna ?? "nombre"]} ${orden.direccion === "asc" ? "↑" : "↓"}`,
      visible: !orden.esPorDefecto,
      onQuitar: orden.reiniciar,
    },
  ]);

  return (
    <>
      <BarraFiltros
        busqueda={
          <CampoBusqueda
            valor={busqueda}
            onCambio={setBusqueda}
            placeholder="Buscar por producto o unidad..."
          />
        }
        filtros={
          <FiltroSelect
            label="Estado"
            valor={estado}
            onCambio={setEstado}
            opciones={[
              { valor: "bajo", etiqueta: "Stock bajo" },
              { valor: "normal", etiqueta: "Disponible" },
            ]}
          />
        }
      />
      <ChipsFiltros filtros={chips} onLimpiarTodo={limpiarTodo} />

      {error ? <BannerError>{error}</BannerError> : null}
      {loading ? <EstadoCargando>Cargando stock actual...</EstadoCargando> : null}
      {!loading && !error && stock.length === 0 ? (
        hayFiltros ? (
          <EstadoVacioFiltrado onLimpiar={limpiarTodo}>
            No hay productos que coincidan con los filtros aplicados.
          </EstadoVacioFiltrado>
        ) : (
          <EstadoVacio>No hay productos químicos registrados para gestionar.</EstadoVacio>
        )
      ) : null}

      {!loading && !error && stock.length > 0 ? (
        <>
          <Tarjeta display={{ base: "none", md: "block" }}>
            <Table.Root variant="outline" size="sm">
              <Table.Header>
                <FilaEncabezado>
                  <EncabezadoOrdenable columna="nombre" orden={orden}>Producto</EncabezadoOrdenable>
                  <EncabezadoOrdenable columna="cantidad" orden={orden} ancho="angosta">Actual</EncabezadoOrdenable>
                  <EncabezadoOrdenable columna="minimo" orden={orden} ancho="angosta">Mínimo</EncabezadoOrdenable>
                  <EncabezadoOscuro ancho="angosta">Estado</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="accionesAnchas">Acciones</EncabezadoOscuro>
                </FilaEncabezado>
              </Table.Header>
              <Table.Body>
                {stock.map((insumo) => (
                  <Table.Row key={insumo.insumo_quimico_id}>
                    <Celda fontWeight="medium">{insumo.nombre}</Celda>
                    <Celda>{valorDecimal(insumo.cantidad_actual)} {insumo.unidad_simbolo ?? ""}</Celda>
                    <Celda>
                      {valorDecimal(insumo.stock_minimo)}
                      {insumo.stock_minimo !== null ? ` ${insumo.unidad_simbolo ?? ""}` : ""}
                    </Celda>
                    <Celda>
                      <Badge colorPalette={insumo.stock_bajo ? "red" : "green"}>
                        {insumo.stock_bajo ? "Stock bajo" : "Disponible"}
                      </Badge>
                    </Celda>
                    <Celda center>
                      <HStack gap="2" justify="center">
                        <BotonAccion accion="ingreso" label="Registrar ingreso" onClick={() => setDialogo({ tipo: "ingreso", insumo })} />
                        <BotonAccion accion="ajuste" label="Ajustar stock" onClick={() => setDialogo({ tipo: "ajuste", insumo })} />
                        <BotonAccion accion="minimo" label="Configurar stock mínimo" onClick={() => setDialogo({ tipo: "minimo", insumo })} />
                      </HStack>
                    </Celda>
                  </Table.Row>
                ))}
              </Table.Body>
            </Table.Root>
          </Tarjeta>

          <Stack display={{ base: "flex", md: "none" }} gap="3">
            {stock.map((insumo) => (
              <Tarjeta key={insumo.insumo_quimico_id} p="4" borderColor={insumo.stock_bajo ? "red.300" : "border.subtle"}>
                <HStack justify="space-between" align="flex-start" gap="3" mb="3">
                  <Box>
                    <Text fontWeight="bold">{insumo.nombre}</Text>
                    <Text color="fg.muted" fontSize="sm">Actual: {valorDecimal(insumo.cantidad_actual)} {insumo.unidad_simbolo ?? ""}</Text>
                  </Box>
                  <Badge colorPalette={insumo.stock_bajo ? "red" : "green"}>{insumo.stock_bajo ? "Stock bajo" : "Disponible"}</Badge>
                </HStack>
                <Text color="fg.muted" fontSize="sm" mb="3">Mínimo: {valorDecimal(insumo.stock_minimo)}{insumo.stock_minimo !== null ? ` ${insumo.unidad_simbolo ?? ""}` : ""}</Text>
                <Stack direction="row" gap="2" flexWrap="wrap">
                  <Button size="sm" colorPalette="brand" onClick={() => setDialogo({ tipo: "ingreso", insumo })}>Ingreso</Button>
                  <Button size="sm" variant="outline" colorPalette="neutral" onClick={() => setDialogo({ tipo: "ajuste", insumo })}>Ajuste</Button>
                  <Button size="sm" variant="plain" color="brand.fg" onClick={() => setDialogo({ tipo: "minimo", insumo })}>Mínimo</Button>
                </Stack>
              </Tarjeta>
            ))}
          </Stack>

          {hayVariasPaginas ? <Paginacion count={total} pageSize={PAGE_SIZE} page={page} onPageChange={setPage} /> : null}
        </>
      ) : null}

      {dialogo ? (
        <StockOperacionDialog
          key={`${dialogo.tipo}-${dialogo.insumo.insumo_quimico_id}`}
          tipo={dialogo.tipo}
          insumo={dialogo.insumo}
          loading={guardando}
          proveedores={proveedores}
          onClose={cerrarDialogo}
          onIngreso={(cantidad, proveedorId, numeroLote) => recargarDespuesDeGuardar(() => registrarIngreso(dialogo.insumo.insumo_quimico_id, cantidad, proveedorId, numeroLote))}
          onAjuste={(cantidad, operacion, motivo) => recargarDespuesDeGuardar(() => registrarAjuste(dialogo.insumo.insumo_quimico_id, cantidad, operacion, motivo))}
          onMinimo={(minimo) => recargarDespuesDeGuardar(() => actualizarMinimo(dialogo.insumo.insumo_quimico_id, minimo))}
        />
      ) : null}
    </>
  );
}
</file>

<file path="frontend/src/features/insumoQuimico/components/StockOperacionDialog.tsx">
import { useState, type FormEvent } from "react";
import { HStack } from "@chakra-ui/react";
import { DialogContent, DialogRoot, DialogTitle } from "../../../components/ui/dialog";
import { DialogForm } from "../../../common/components/DialogForm";
import {
  AccionesFormulario,
  BannerError,
  BotonCancelar,
  BotonGuardar,
  FormField,
  FormInput,
  FormNativeSelect,
} from "../../../components/ui/patrones";
import type { OperacionAjusteStock, StockInsumoQuimico } from "../types/stock";
import type { Proveedor } from "../../proveedores/types/proveedor";

export type TipoDialogoStock = "ingreso" | "ajuste" | "minimo";

interface StockOperacionDialogProps {
  tipo: TipoDialogoStock;
  insumo: StockInsumoQuimico;
  loading: boolean;
  proveedores: Proveedor[];
  onClose: () => void;
  onIngreso: (cantidad: string, proveedorId: number, numeroLote: string) => Promise<void>;
  onAjuste: (
    cantidad: string,
    operacion: OperacionAjusteStock,
    motivo: string,
  ) => Promise<void>;
  onMinimo: (stockMinimo: string | null) => Promise<void>;
}

const esCantidadPositiva = (valor: string) => Number.isFinite(Number(valor)) && Number(valor) > 0;
const esCantidadNoNegativa = (valor: string) =>
  Number.isFinite(Number(valor)) && Number(valor) >= 0;

export function StockOperacionDialog({
  tipo,
  insumo,
  loading,
  proveedores,
  onClose,
  onIngreso,
  onAjuste,
  onMinimo,
}: StockOperacionDialogProps) {
  const [cantidad, setCantidad] = useState("");
  const [motivo, setMotivo] = useState("");
  const [proveedorId, setProveedorId] = useState("");
  const [numeroLote, setNumeroLote] = useState("");
  const [operacion, setOperacion] = useState<OperacionAjusteStock>("incremento");
  const [minimo, setMinimo] = useState(
    insumo.stock_minimo === null ? "" : String(insumo.stock_minimo),
  );
  const [error, setError] = useState<string | null>(null);

  const titulo =
    tipo === "ingreso"
      ? "Registrar ingreso"
      : tipo === "ajuste"
        ? "Ajustar stock"
        : "Configurar stock mínimo";

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError(null);

    if (tipo === "minimo") {
      if (minimo.trim() && !esCantidadNoNegativa(minimo)) {
        setError("El stock mínimo debe ser un número igual o mayor a cero.");
        return;
      }
    } else if (!esCantidadPositiva(cantidad)) {
      setError("La cantidad debe ser un número mayor a cero.");
      return;
    }

    if (tipo === "ajuste" && !motivo.trim()) {
      setError("Indicá el motivo del ajuste.");
      return;
    }
    if (tipo === "ingreso" && !proveedorId) {
      setError("Seleccioná un proveedor activo.");
      return;
    }
    if (tipo === "ingreso" && !numeroLote.trim()) {
      setError("Indicá el número de lote.");
      return;
    }

    try {
      if (tipo === "ingreso") {
        await onIngreso(cantidad.trim(), Number(proveedorId), numeroLote.trim());
      } else if (tipo === "ajuste") {
        await onAjuste(cantidad.trim(), operacion, motivo.trim());
      } else {
        await onMinimo(minimo.trim() || null);
      }
      onClose();
    } catch (err) {
      setError(err instanceof Error ? err.message : "No se pudo guardar el cambio.");
    }
  };

  return (
    <DialogRoot
      open
      placement="center"
      motionPreset="none"
      closeOnEscape={!loading}
      closeOnInteractOutside={!loading}
      onOpenChange={(detalle) => {
        if (!detalle.open && !loading) onClose();
      }}
    >
      <DialogContent bg="bg.panel" p="6" rounded="lg" boxShadow="dialog" width="420px" maxW="calc(100vw - 32px)">
        <DialogForm onSubmit={handleSubmit}>
          <DialogTitle as="h3" mt={0} mb="1" fontSize="lg" fontWeight="bold" color="fg">
            {titulo}
          </DialogTitle>
          <HStack mb="5" gap="1" color="fg.muted" fontSize="sm">
            <span>{insumo.nombre}</span>
            {insumo.unidad_simbolo ? <span>({insumo.unidad_simbolo})</span> : null}
          </HStack>

          {error ? <BannerError mb="4">{error}</BannerError> : null}

          {tipo === "minimo" ? (
            <FormField label="Stock mínimo" helper="Dejalo vacío si el producto no requiere una alerta.">
              <FormInput
                type="number"
                min="0"
                step="any"
                inputMode="decimal"
                value={minimo}
                onChange={(event) => setMinimo(event.target.value)}
              />
            </FormField>
          ) : (
            <>
              {tipo === "ingreso" ? (
                <FormField label="Producto" required mb="4">
                  <FormInput readOnly value={`${insumo.nombre}${insumo.unidad_simbolo ? ` (${insumo.unidad_simbolo})` : ""}`} />
                </FormField>
              ) : null}
              {tipo === "ajuste" ? (
                <FormField label="Operación" required mb="4">
                  <FormNativeSelect
                    value={operacion}
                    onChange={(event) => setOperacion(event.target.value as OperacionAjusteStock)}
                  >
                    <option value="incremento">Incrementar stock</option>
                    <option value="decremento">Disminuir stock</option>
                  </FormNativeSelect>
                </FormField>
              ) : null}

              <FormField label="Cantidad" required mb="4">
                <FormInput
                  type="number"
                  min="0.000001"
                  step="any"
                  inputMode="decimal"
                  value={cantidad}
                  onChange={(event) => setCantidad(event.target.value)}
                />
              </FormField>

              {tipo === "ingreso" ? (
                <>
                  <FormField label="Proveedor" required mb="4">
                    <FormNativeSelect value={proveedorId} onChange={(event) => setProveedorId(event.target.value)}>
                      <option value="">Seleccioná un proveedor</option>
                      {proveedores.map((proveedor) => (
                        <option key={proveedor.id} value={proveedor.id}>{proveedor.nombre}</option>
                      ))}
                    </FormNativeSelect>
                  </FormField>
                  <FormField label="Número de lote" required>
                    <FormInput value={numeroLote} onChange={(event) => setNumeroLote(event.target.value)} placeholder="Ej.: 000123" />
                  </FormField>
                </>
              ) : (
                <FormField label="Motivo del ajuste" required>
                  <FormInput
                    value={motivo}
                    onChange={(event) => setMotivo(event.target.value)}
                    placeholder="Ej.: corrección de inventario"
                  />
                </FormField>
              )}
            </>
          )}

          <AccionesFormulario>
            <BotonGuardar loading={loading}>Guardar</BotonGuardar>
            <BotonCancelar onClick={onClose} disabled={loading}>
              Cancelar
            </BotonCancelar>
          </AccionesFormulario>
        </DialogForm>
      </DialogContent>
    </DialogRoot>
  );
}
</file>

<file path="frontend/src/features/insumoQuimico/hooks/useLotesStock.ts">
import { useCallback } from "react";

import { useListaPaginada } from "../../../common/hooks/useListaPaginada";
import { listarLotesStockPaginados } from "../services/stockService";
import type { FiltrosLotesStock, LoteStock } from "../types/stock";

export function useLotesStock(
  filtros: Omit<FiltrosLotesStock, "limit" | "offset">,
) {
  const { proveedor_id, insumo_quimico_id, numero_lote } = filtros;
  const cargar = useCallback(
    (page: number, pageSize: number) =>
      listarLotesStockPaginados(page, pageSize, {
        proveedor_id,
        insumo_quimico_id,
        numero_lote,
      }),
    [proveedor_id, insumo_quimico_id, numero_lote],
  );
  const listado = useListaPaginada<LoteStock>({
    cargar,
    dependencias: [proveedor_id, insumo_quimico_id, numero_lote],
    valorInicial: [],
    mensajeError: "No se pudieron obtener los lotes",
  });
  return { lotes: listado.items, ...listado };
}
