<file path="backend/src/incidente/services.py">
import logging
import unicodedata
from datetime import date, datetime
from typing import List, Optional
from sqlalchemy import Select, func, select
from sqlalchemy.orm import Session, selectinload
from src.common.paginacion import paginar
from src.common.persistence import guardar
from src.incidente import models, schemas, exceptions
from src.incidente.constants import EstadoIncidente, TipoIncidente
from src.Equipo.models import Equipo
from src.personal.models import Personal

logger = logging.getLogger(__name__)


# Relaciones que se cargan siempre para poder devolver los nombres en la respuesta.
_RELACIONES = (
    selectinload(models.Incidente.equipo),
    selectinload(models.Incidente.usuario),
    selectinload(models.Incidente.responsable_cierre),
)


def _nombre_completo(persona: Optional[Personal]) -> Optional[str]:
    if persona is None:
        return None
    return f"{persona.nombre} {persona.apellido or ''}".strip()


def _normalizar_texto(texto: str) -> str:
    """Minúsculas y sin tildes, igual que la búsqueda que hacía el frontend:
    'López' y 'lopez' son lo mismo para el filtro de la tabla."""
    return "".join(
        c
        for c in unicodedata.normalize("NFD", texto.lower())
        if unicodedata.category(c) != "Mn"
    )


def _completar_nombres(incidentes: List[models.Incidente]) -> List[models.Incidente]:
    """Las relaciones se cargan a mano para evitar consultas perezosas."""
    for inc in incidentes:
        if inc.equipo:
            inc.equipo_nombre = inc.equipo.nombre
        inc.usuario_nombre = _nombre_completo(inc.usuario)
        inc.responsable_cierre_nombre = _nombre_completo(inc.responsable_cierre)
    return incidentes


def _verificar_equipo(db: Session, equipo_id: Optional[int]) -> None:
    """Verifica que el equipo exista y esté activo (si se especifica)."""
    if equipo_id is None:
        return
    equipo = db.scalar(select(Equipo).where(Equipo.id == equipo_id))
    if equipo is None:
        raise exceptions.EquipoNoEncontrado()
    if not equipo.activo:
        raise exceptions.EquipoInactivo()


def _verificar_usuario(db: Session, usuario_id: int) -> None:
    """Verifica que el usuario exista y esté activo."""
    usuario = db.scalar(select(Personal).where(Personal.id == usuario_id))
    if usuario is None:
        raise exceptions.UsuarioNoEncontrado()
    if not usuario.activo:
        raise exceptions.UsuarioInactivo()


def crear_incidente(db: Session, datos: schemas.IncidenteCreate, usuario_id: int) -> models.Incidente:
    _verificar_equipo(db, datos.equipo_id)
    _verificar_usuario(db, usuario_id)

    incidente = models.Incidente(
        titulo=datos.titulo,
        descripcion=datos.descripcion,
        tipo=datos.tipo,
        equipo_id=datos.equipo_id,
        foto_url=datos.foto_url,
        usuario_id=usuario_id,
        fecha_reporte=datetime.now(),
        estado=EstadoIncidente.ABIERTO.value,
    )
    db.add(incidente)
    return guardar(db, incidente)


def _validar_rango_fechas(
    fecha_desde: Optional[date], fecha_hasta: Optional[date]
) -> None:
    """Rechaza un rango cuya fecha inicial es posterior a la final."""
    if fecha_desde is not None and fecha_hasta is not None and fecha_desde > fecha_hasta:
        raise exceptions.FechaInvalida()


def _aplicar_rango_fechas(
    consulta,
    fecha_desde: Optional[date],
    fecha_hasta: Optional[date],
):
    """Acota la consulta a un rango de fechas de reporte, inclusive.

    Se compara por `func.date(...)`: `fecha_reporte` es un `DateTime` y sin el
    corte por día un `hasta` a las 00:00 se comería el día completo.
    """
    if fecha_desde is not None:
        consulta = consulta.where(
            func.date(models.Incidente.fecha_reporte) >= fecha_desde
        )
    if fecha_hasta is not None:
        consulta = consulta.where(
            func.date(models.Incidente.fecha_reporte) <= fecha_hasta
        )
    return consulta


def _consulta_incidentes(
    estado: Optional[EstadoIncidente],
    tipo: Optional[str],
    equipo_id: Optional[int],
    orden: Optional[str],
) -> Select:
    """Consulta base del listado: filtros en el WHERE y orden estable.

    El desempate por `id` es lo que hace seguro el OFFSET/LIMIT: solo por
    `fecha_reporte` hay filas con la misma fecha y el recorte puede repetir
    u omitir registros entre páginas.
    """
    consulta = select(models.Incidente).options(*_RELACIONES)

    if estado:
        # El router ya convierte el query param con el enum de FastAPI, así que
        # acá llega como `EstadoIncidente`. Se acepta también un `str` suelta
        # para no romper callers que la pasen así.
        valor = estado.value if isinstance(estado, EstadoIncidente) else str(estado)
        consulta = consulta.where(models.Incidente.estado == valor)
    if tipo:
        consulta = consulta.where(models.Incidente.tipo == tipo)
    if equipo_id:
        consulta = consulta.where(models.Incidente.equipo_id == equipo_id)

    if orden == "antiguos":
        # Lo pide la tabla de gestión: los que llevan más tiempo sin
        # resolverse quedan arriba.
        consulta = consulta.order_by(
            models.Incidente.fecha_reporte.asc(), models.Incidente.id.asc()
        )
    else:
        consulta = consulta.order_by(
            models.Incidente.fecha_reporte.desc(), models.Incidente.id.desc()
        )

    return consulta


def listar_incidentes(
    db: Session,
    estado: Optional[EstadoIncidente] = None,
    tipo: Optional[str] = None,
    equipo_id: Optional[int] = None,
    orden: Optional[str] = None,
    buscar: Optional[str] = None,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> List[models.Incidente]:
    """Lista los incidentes, por defecto del más reciente al más viejo.

    Sin `estado` devuelve todos (abiertos y cerrados); con `estado` filtra.
    `orden="antiguos"` invierte el criterio. Es el camino SIN paginar: lo
    usan el tablero y el resumen, que necesitan el conjunto completo.

    `buscar` se aplica con la misma lógica que en el camino paginado: antes
    el router lo descartaba en silencio y quien lo mandaba recibía la lista
    completa sin filtrar.
    `fecha_desde`/`fecha_hasta` acotan por fecha de reporte (inclusive).
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)
    consulta = _consulta_incidentes(estado, tipo, equipo_id, orden)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)
    incidentes = _completar_nombres(list(db.scalars(consulta).all()))
    return _filtrar_por_busqueda(incidentes, buscar)


def _filtrar_por_busqueda(
    incidentes: List[models.Incidente], buscar: Optional[str]
) -> List[models.Incidente]:
    """Deja los incidentes que matchean el término en título, descripción o
    quien reportó (mayúsculas y tildes insensibles).

    SQLite no tiene forma portable de normalizar tildes en SQL (no existe
    `unaccent`), así que el filtro de texto se aplica en Python: el costo
    documentado está en el docstring de `listar_incidentes_paginado`.
    """
    if not (buscar and buscar.strip()):
        return incidentes

    termino = _normalizar_texto(buscar.strip())
    return [
        inc
        for inc in incidentes
        if termino in _normalizar_texto(inc.titulo)
        or termino in _normalizar_texto(inc.descripcion or "")
        or termino in _normalizar_texto(inc.usuario_nombre or "")
    ]


def listar_incidentes_paginado(
    db: Session,
    estado: Optional[EstadoIncidente],
    tipo: Optional[str],
    equipo_id: Optional[int],
    buscar: Optional[str],
    orden: Optional[str],
    page: int,
    page_size: int,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> tuple[List[models.Incidente], int]:
    """Página del listado, recortada por la BASE (COUNT + OFFSET/LIMIT).

    `estado`, `tipo`, `equipo_id`, el `orden` y el rango de fechas van en
    el WHERE/ORDER BY de la consulta, así que sin término de búsqueda la
    página sale entera de SQL y no se cargan más filas que las de la página.

    Limitación de `buscar` (documentada a pedido): la búsqueda es
    insensible a mayúsculas y TILDES, y cubre el nombre de quien reportó.
    SQLite no tiene una forma portable de normalizar tildes en SQL (no
    existe `unaccent`), así que cuando hay término de búsqueda el filtro de
    texto se aplica en Python sobre el conjunto ya acotado por los demás
    filtros: en ese caso sí se cargan todas las filas que cumplen
    estado/tipo/equipo. Es el único caso; sin `buscar` la paginación es
    100% en la base.
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)
    consulta = _consulta_incidentes(estado, tipo, equipo_id, orden)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)

    if not (buscar and buscar.strip()):
        incidentes, total = paginar(db, consulta, page, page_size)
        return _completar_nombres(incidentes), total

    # Camino con búsqueda: ver la limitación en el docstring.
    incidentes = _filtrar_por_busqueda(
        _completar_nombres(list(db.scalars(consulta).all())), buscar
    )

    total = len(incidentes)
    inicio = (page - 1) * page_size
    return incidentes[inicio : inicio + page_size], total


def obtener_incidente(db: Session, incidente_id: int, current_user: Personal) -> models.Incidente:
    incidente = db.scalar(
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()

    # Operador solo ve sus propios incidentes
    if not (current_user.puede_administrar or current_user.es_super_admin):
        if incidente.usuario_id != current_user.id:
            raise exceptions.PermisoDenegado()

    _completar_nombres([incidente])
    return incidente


def listar_mis_incidentes(db: Session, usuario_id: int) -> List[models.Incidente]:
    """Lista los incidentes reportados por un usuario específico (para operadores)."""
    consulta = (
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.usuario_id == usuario_id)
        .order_by(models.Incidente.fecha_reporte.desc(), models.Incidente.id.desc())
    )
    return _completar_nombres(list(db.scalars(consulta).all()))


def listar_mis_incidentes_paginado(
    db: Session, usuario_id: int, page: int, page_size: int
) -> tuple[List[models.Incidente], int]:
    """Página de los incidentes del usuario, recortada por la BASE.

    El filtro es un simple `usuario_id`, así que la consulta sale entera en
    SQL con COUNT + OFFSET/LIMIT y el orden estable de `listar_mis_incidentes`.
    """
    consulta = (
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.usuario_id == usuario_id)
        .order_by(models.Incidente.fecha_reporte.desc(), models.Incidente.id.desc())
    )
    incidentes, total = paginar(db, consulta, page, page_size)
    return _completar_nombres(incidentes), total


def resumen_por_tipo(
    db: Session,
    estado: Optional[EstadoIncidente] = None,
    fecha_desde: Optional[date] = None,
    fecha_hasta: Optional[date] = None,
) -> schemas.IncidenteResumenResponse:
    """Cuenta incidentes por tipo para el indicador del tablero (E7).

    Devuelve los cinco tipos siempre, con 0 si no hay registros. Por
    defecto es el universo de los abiertos (la historia de "incidentes abiertos":
    que ninguno quede reportado y olvidado). `fecha_desde`/`fecha_hasta`
    acotan por fecha de reporte (inclusive).
    """
    _validar_rango_fechas(fecha_desde, fecha_hasta)

    consulta = select(
        models.Incidente.tipo, func.count(models.Incidente.id)
    ).group_by(models.Incidente.tipo)
    consulta = _aplicar_rango_fechas(consulta, fecha_desde, fecha_hasta)
    if estado:
        consulta = consulta.where(models.Incidente.estado == estado.value)

    conteos = {tipo.value: 0 for tipo in TipoIncidente}
    for tipo, cantidad in db.execute(consulta).all():
        if tipo in conteos:
            conteos[tipo] = cantidad

    return schemas.IncidenteResumenResponse(
        estado=estado.value if estado else "todos",
        total=sum(conteos.values()),
        por_tipo=[
            schemas.IncidenteResumenTipo(tipo=t, cantidad=conteos[t])
            for t in (tipo.value for tipo in TipoIncidente)
        ],
    )


def cambiar_estado_incidente(
    db: Session,
    incidente_id: int,
    estado: EstadoIncidente,
    current_user: Personal,
    observacion_cierre: Optional[str] = None,
) -> models.Incidente:
    """Cierra o reabre un incidente.

    Al cerrar se asienta la acción correctiva, cuándo se cerró y quién lo
    resolvió. Al reabrir se limpia esa información para que no quede
    desactualizada. Además, guarda un evento en el historial de incidentes.
    """
    incidente = db.scalar(
        select(models.Incidente)
        .options(*_RELACIONES)
        .where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()

    if incidente.estado == estado.value:
        # Ya está en ese estado: no se pisa la fecha de cierre original.
        # Aun así hay que completar los nombres: sin esto, este camino
        # devolvía los tres campos de nombre en null (son Optional, así que
        # la inconsistencia con el GET pasaba inadvertida).
        return _completar_nombres([incidente])[0]

    estado_anterior = incidente.estado

    if estado == EstadoIncidente.CERRADO:
        _verificar_usuario(db, current_user.id)
        incidente.estado = EstadoIncidente.CERRADO.value
        incidente.fecha_cierre = datetime.now()
        incidente.responsable_cierre_id = current_user.id
        incidente.observacion_cierre = observacion_cierre
        logger.info(
            "Incidente %s cerrado por %s", incidente.id, current_user.id
        )
    else:
        incidente.estado = EstadoIncidente.ABIERTO.value
        incidente.fecha_cierre = None
        incidente.responsable_cierre_id = None
        incidente.observacion_cierre = None
        logger.info("Incidente %s reabierto por %s", incidente.id, current_user.id)

    # Guardar evento en el historial
    db.add(
        models.HistorialIncidente(
            incidente_id=incidente.id,
            estado_anterior=estado_anterior,
            estado_nuevo=estado.value,
            usuario_id=current_user.id,
            observacion=observacion_cierre,
        )
    )

    guardar(db, incidente)

    # refresh deja las relaciones sin cargar: hay que volver a consultarlas.
    return obtener_incidente(db, incidente_id, current_user)


def obtener_historial_incidente(
    db: Session, incidente_id: int, current_user: Personal
) -> schemas.HistorialIncidenteResponse:
    """Obtiene el historial de cierre/reapertura de un incidente.

    Igual que en el detalle, un operador solo ve el historial de sus propios
    incidentes: este endpoint no expone el historial (ni la observación de
    cierre) de incidentes ajenos por ID.
    """
    incidente = db.scalar(
        select(models.Incidente).where(models.Incidente.id == incidente_id)
    )
    if incidente is None:
        raise exceptions.IncidenteNoEncontrado()
    if not (current_user.puede_administrar or current_user.es_super_admin):
        if incidente.usuario_id != current_user.id:
            raise exceptions.PermisoDenegado()

    eventos = db.scalars(
        select(models.HistorialIncidente)
        .where(models.HistorialIncidente.incidente_id == incidente_id)
        .options(selectinload(models.HistorialIncidente.usuario))
        .order_by(models.HistorialIncidente.fecha_evento)
    ).all()

    items = []
    for e in eventos:
        item = schemas.HistorialIncidenteItem.model_validate(e)
        if e.usuario is not None:
            item.usuario_nombre = _nombre_completo(e.usuario)
        items.append(item)

    return schemas.HistorialIncidenteResponse(
        incidente_id=incidente_id,
        eventos=items,
    )
</file>

<file path="frontend/src/features/checklist/components/pages/HistorialChecklistPage.tsx">
import { Fragment, useMemo, useState } from "react";
import { Badge, Box, Field, HStack, Table, Text } from "@chakra-ui/react";
import { LuRefreshCw } from "react-icons/lu";
import { useHistorialChecklists } from "../../hooks/useHistorialChecklists";
import { DetalleChecklistDialog } from "../DetalleChecklistDialog";
import type { HistorialChecklistItem } from "../../types/checklist";
import { useEquipos } from "../../../equipo/hooks/useEquipos";
import { formatoFecha } from "../../../../common/utils/fechas";
import {
  BannerError,
  BotonAccion,
  BotonCancelar,
  BotonTexto,
  Celda,
  EncabezadoOscuro,
  EstadoCargando,
  EstadoVacio,
  FilaEncabezado,
  FormInput,
  FormNativeSelect,
  LabelFiltro,
  PageHeader,
  Paginacion,
  SelectPlaceholder,
  Tarjeta,
  TextoTruncado,
} from "../../../../components/ui/patrones";

const PAGE_SIZE = 10;

function fechaLocalISO(fecha: Date): string {
  const year = fecha.getFullYear();
  const month = String(fecha.getMonth() + 1).padStart(2, "0");
  const day = String(fecha.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

/** Verde/ámbar/rojo del cumplimiento, con los tokens del tema. */
function colorPorcentaje(pct: number): string {
  if (pct >= 80) return "green.600";
  if (pct >= 50) return "orange.400";
  return "red.700";
}

export function HistorialChecklistPage() {
  const [{ hace7DiasISO, hoyISO }] = useState(() => {
    const hoy = new Date();
    return {
      hoyISO: fechaLocalISO(hoy),
      hace7DiasISO: fechaLocalISO(
        new Date(hoy.getTime() - 7 * 24 * 60 * 60 * 1000)
      ),
    };
  });

  const [fechaDesde, setFechaDesde] = useState(hace7DiasISO);
  const [fechaHasta, setFechaHasta] = useState(hoyISO);
  const [equipoSeleccionado, setEquipoSeleccionado] = useState<string>("");
  const [expandidos, setExpandidos] = useState<Set<number>>(new Set());
  const [checklistSeleccionado, setChecklistSeleccionado] =
    useState<HistorialChecklistItem | null>(null);

  const equipoIdFiltro =
    equipoSeleccionado !== "" ? Number(equipoSeleccionado) : undefined;

  const { equipos } = useEquipos();
  const [page, setPage] = useState(1);
  const { historial, loading, error, recargar } = useHistorialChecklists(
    fechaDesde,
    fechaHasta,
    equipoIdFiltro,
    page,
    PAGE_SIZE
  );

  const toggleExpandido = (checklistId: number) => {
    setExpandidos((prev) => {
      const nuevo = new Set(prev);
      if (nuevo.has(checklistId)) {
        nuevo.delete(checklistId);
      } else {
        nuevo.add(checklistId);
      }
      return nuevo;
    });
  };

  // `items` es la página actual; el cumplimiento general y el total vienen
  // calculados sobre TODO el período en el backend.
  const checklists = useMemo(() => historial?.items ?? [], [historial]);
  const total = historial?.total ?? 0;
  const totalPaginas = historial?.total_paginas ?? 1;
  const hayVariasPaginas = totalPaginas > 1;

  // Página fuera de rango: si el rango se acortó (p. ej. un refresco después
  // de que otro usuario cerró checklists) el backend devuelve `items` vacíos
  // con `total > 0`. El ajuste va DURANTE el render — el mismo "recortar, no
  // corregir con un efecto" de `useListaPaginada` — porque un `useEffect`
  // con `setPage` dispara la regla `set-state-in-effect`. Con `page` en las
  // dependencias del hook, la corrección dispara el re-fetch de la última
  // página válida y la tabla nunca queda vacía con la paginación oculta.
  if (
    historial &&
    historial.total > 0 &&
    historial.items.length === 0 &&
    page > totalPaginas
  ) {
    setPage(totalPaginas);
  }

  /** Al cambiar cualquier filtro la página 1 siempre es válida. */
  const cambiarFiltro = (aplicar: () => void) => {
    aplicar();
    setPage(1);
  };

  /** Botón de "Ver/ocultar N incumplidas" dentro de la celda. */
  const botonIncumplidas = (checklistId: number, cantidad: number) => (
    <BotonTexto onClick={() => toggleExpandido(checklistId)}>
      {expandidos.has(checklistId) ? "Ocultar" : `Ver ${cantidad}`}
    </BotonTexto>
  );

  return (
    <Box p="5">
      <PageHeader
        title="Historial de checklists"
        description="Cumplimiento por período, filtrado por rango de fechas y equipo."
        actions={
          <BotonCancelar onClick={recargar}>
            <LuRefreshCw aria-hidden />
            Actualizar
          </BotonCancelar>
        }
      />

      <Tarjeta p="4" mb="6">
        <HStack gap="4" flexWrap="wrap" align="flex-end">
          <Box minW="180px">
            <Field.Root>
              <LabelFiltro>Desde</LabelFiltro>
              <FormInput
                type="date"
                value={fechaDesde}
                onChange={(e) => cambiarFiltro(() => setFechaDesde(e.target.value))}
                w="auto"
              />
            </Field.Root>
          </Box>
          <Box minW="180px">
            <Field.Root>
              <LabelFiltro>Hasta</LabelFiltro>
              <FormInput
                type="date"
                value={fechaHasta}
                onChange={(e) => cambiarFiltro(() => setFechaHasta(e.target.value))}
                w="auto"
              />
            </Field.Root>
          </Box>
          <Box minW="200px">
            <Field.Root>
              <LabelFiltro>Equipo</LabelFiltro>
              <FormNativeSelect
                value={equipoSeleccionado}
                onChange={(e) => cambiarFiltro(() => setEquipoSeleccionado(e.target.value))}
              >
                <SelectPlaceholder value="">
                  Todos los equipos
                </SelectPlaceholder>
                {equipos.map((equipo) => (
                  <option key={equipo.id} value={equipo.id}>
                    {equipo.nombre}
                  </option>
                ))}
              </FormNativeSelect>
            </Field.Root>
          </Box>
        </HStack>
      </Tarjeta>

      {error && <BannerError>{error}</BannerError>}

      {loading && <EstadoCargando>Cargando historial...</EstadoCargando>}

      {!loading && historial && checklists.length === 0 && !error && (
        <EstadoVacio>
          No hay checklists registrados en el rango seleccionado.
        </EstadoVacio>
      )}

      {historial && checklists.length > 0 && (
        <>
          <Text fontSize="sm" color="fg.muted" mb="4">
            Cumplimiento general del período:{" "}
            <Text
              as="span"
              fontWeight="bold"
              color={colorPorcentaje(historial.porcentaje_cumplimiento_general)}
            >
              {historial.porcentaje_cumplimiento_general.toFixed(0)}%
            </Text>
          </Text>

          {/* Mientras se pide la página siguiente la tabla SIGUE montada (sin
              el parpadeo de desmontar/montar): solo se atenúa y se bloquean
              los clicks hasta que llega la respuesta. */}
          <Tarjeta
            opacity={loading ? 0.6 : 1}
            pointerEvents={loading ? "none" : "auto"}
            transition="opacity 0.15s"
          >
            <Table.Root variant="outline" w="100%">
              <Table.Header>
                <FilaEncabezado>
                  <EncabezadoOscuro ancho="media">Fecha</EncabezadoOscuro>
                  <EncabezadoOscuro ancho="media">Equipo</EncabezadoOscuro>
                  <EncabezadoOscuro ancho="angosta">Estado</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">Cumplimiento</EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">
                    Incumplidas
                  </EncabezadoOscuro>
                  <EncabezadoOscuro center ancho="media">
                    Acciones
                  </EncabezadoOscuro>
                </FilaEncabezado>
              </Table.Header>
              <Table.Body>
                {checklists.map((cl) => (
                  <Fragment key={cl.checklist_id}>
                    <Table.Row>
                      <Celda>{formatoFecha(cl.fecha)}</Celda>
                      <Celda>
                        <TextoTruncado texto={cl.equipo_nombre} />
                      </Celda>
                      <Celda>
                        <Badge
                          colorPalette={cl.estado === "cerrado" ? "green" : "orange"}
                          rounded="md"
                          px="2"
                          py="1"
                          textTransform="capitalize"
                          maxW="100%"
                          overflow="hidden"
                          textOverflow="ellipsis"
                        >
                          {cl.estado}
                        </Badge>
                      </Celda>
                      <Celda center>
                        <Text fontWeight="bold" color={colorPorcentaje(cl.porcentaje_cumplimiento)}>
                          {cl.porcentaje_cumplimiento.toFixed(0)}%
                        </Text>
                        <Text fontSize="xs" color="fg.muted">
                          {cl.tareas_completadas}/{cl.total_tareas}
                        </Text>
                      </Celda>
                      <Celda center>
                        {cl.tareas_incumplidas.length === 0 ? (
                          <Text fontSize="sm" color="fg.subtle">
                            —
                          </Text>
                        ) : (
                          botonIncumplidas(cl.checklist_id, cl.tareas_incumplidas.length)
                        )}
                      </Celda>
                      <Celda center>
                        <BotonAccion
                          accion="ver"
                          label="Ver detalle del checklist"
                          onClick={() => setChecklistSeleccionado(cl)}
                        />
                      </Celda>
                    </Table.Row>
                    {expandidos.has(cl.checklist_id) && (
                      <Table.Row>
                        <Table.Cell
                          colSpan={6}
                          color="fg"
                          fontSize="sm"
                          px="4"
                          py="3"
                          borderBottomWidth="1px"
                          borderColor="border.subtle"
                          bg="red.50"
                        >
                          <Text fontSize="sm" fontWeight="bold" color="red.fg" mb="2">
                            Tareas incumplidas:
                          </Text>
                          {cl.tareas_incumplidas.map((t, i) => (
                            <Text key={t.tarea_id ?? i} fontSize="sm" color="fg.muted">
                              • {t.nombre}
                            </Text>
                          ))}
                        </Table.Cell>
                      </Table.Row>
                    )}
                  </Fragment>
                ))}
              </Table.Body>
            </Table.Root>
          </Tarjeta>

          {hayVariasPaginas && (
            <Paginacion
              count={total}
              pageSize={PAGE_SIZE}
              page={page}
              onPageChange={setPage}
            />
          )}

          {checklistSeleccionado && (
            <DetalleChecklistDialog
              isOpen
              checklist={checklistSeleccionado}
              onClose={() => setChecklistSeleccionado(null)}
            />
          )}
        </>
      )}
    </Box>
  );
}
</file>

<file path="frontend/src/features/incidente/components/IncidenteItem.tsx">
import { useNavigate } from "react-router-dom";
import { Badge, Box, HStack, Table, Text } from "@chakra-ui/react";
import { LuCamera, LuTriangleAlert } from "react-icons/lu";
import {
  estadoLabel,
  tipoLabel,
  tipoColor,
} from "../types/incidente";
import type { Incidente } from "../types/incidente";
import { formatoFecha as formatoFechaDia } from "../../../common/utils/fechas";
import { BotonAccion, Celda, TextoTruncado } from "../../../components/ui/patrones";
import { Tooltip } from "../../../components/ui/tooltip";

interface IncidenteItemProps {
  incidente: Incidente;
  onCerrar?: (incidente: Incidente) => void;
  onReabrir?: (incidente: Incidente) => void;
  onVer?: (incidente: Incidente) => void;
  showActions?: boolean;
}

// HU #55: Calcular si pasaron más de 7 días desde el reporte
function llevaMuchoTiempoAbierto(fechaReporte: string): boolean {
  const reporte = new Date(fechaReporte);
  const hoy = new Date();
  const diffTime = hoy.getTime() - reporte.getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays > 7;
}

export function IncidenteItem({
  incidente,
  onCerrar,
  onReabrir,
  onVer,
  showActions = true,
}: IncidenteItemProps) {
  const navigate = useNavigate();
  const cerrado = incidente.estado === "cerrado";

  const handleVer = () => {
    if (onVer) {
      onVer(incidente);
    } else {
      navigate(`/incidentes/${incidente.id}`);
    }
  };

  // Resaltado visual si está abierto y es viejo
  const esViejo = !cerrado && llevaMuchoTiempoAbierto(incidente.fecha_reporte);

  return (
    <Table.Row
      borderBottomWidth="1px"
      borderColor="border.subtle"
      opacity={cerrado ? 0.7 : 1}
      /*
       * Un incidente abierto que lleva más de una semana sin resolverse se
       * marca sin pintar la fila entera: el título pasa a rojo y debajo
       * aparece el texto "Lleva más de 7 días sin resolver". El fondo rojo
       * completo tapaba la jerarquía visual del listado (parecía un error
       * de render antes que un estado).
       */
    >
      {/*
        Solo el día en la tabla: la hora completa queda en el `title`,
        para no perderla del todo. El detalle la muestra completa.
      */}
      <Celda
        p="3"
        whiteSpace="nowrap"
        title={new Date(incidente.fecha_reporte).toLocaleString("es-AR", {
          timeZone: "America/Argentina/Buenos_Aires",
          hour12: false,
        })}
      >
        {formatoFechaDia(incidente.fecha_reporte)}
      </Celda>

      <Celda p="3" maxW="220px">
        <Text
          fontWeight="bold"
          fontSize="15px"
          lineClamp={1}
          color={esViejo ? "red.fg" : "fg"}
          title={incidente.titulo}
        >
          {incidente.titulo}
        </Text>
        {/*
          La descripción no se muestra acá: se lee en el detalle. En la
          lista solo el título, y para los cerrados, la acción correctiva.
        */}
        {cerrado && incidente.observacion_cierre && (
          <Text fontSize="xs" color="fg.subtle" mt="4px" lineClamp={2}>
            <strong>Resolución:</strong> {incidente.observacion_cierre}
          </Text>
        )}
        {esViejo && (
          <HStack gap="1" color="red.fg" fontSize="xs" fontWeight="bold" mt="4px">
            <Box as="span" display="inline-flex" flexShrink={0} aria-hidden>
              <LuTriangleAlert size={12} />
            </Box>
            <Text as="span">Lleva más de 7 días sin resolver</Text>
          </HStack>
        )}
      </Celda>

      <Celda p="3" center>
        {incidente.foto_url ? (
          <Tooltip content="Ver detalle para ver la foto" showArrow openDelay={300} closeDelay={0}>
            <Box
              display="inline-flex"
              color="brand.fg"
              role="img"
              aria-label="Tiene foto adjunta"
            >
              <LuCamera size={20} />
            </Box>
          </Tooltip>
        ) : (
          <Text color="fg.subtle">-</Text>
        )}
      </Celda>

      <Celda p="3">
        {/*
          `maxW` + ellipsis en los badges: con `table-layout: fixed` la columna
          ya no crece para acomodar la etiqueta, y "Falla / Rotura de Equipo"
          se salía de la celda. Con puntos suspensivos el texto largo se
          recorta dentro de la píldora en vez de pisar la columna de al lado.
        */}
        <Badge
          colorPalette={tipoColor(incidente.tipo)}
          borderRadius="md"
          px="2"
          py="1"
          maxW="100%"
          overflow="hidden"
          textOverflow="ellipsis"
        >
          {tipoLabel(incidente.tipo)}
        </Badge>
      </Celda>

      <Celda p="3">
        <Badge
          colorPalette={cerrado ? "green" : "red"}
          borderRadius="md"
          px="3"
          py="1"
          maxW="100%"
          overflow="hidden"
          textOverflow="ellipsis"
        >
          {estadoLabel(incidente.estado)}
        </Badge>
      </Celda>

      <Celda p="3">
        <TextoTruncado
          texto={incidente.usuario_nombre ?? `Usuario #${incidente.usuario_id}`}
        />
      </Celda>

      {showActions && (
        <Celda p="3" center>
          <HStack justify="center" gap="2" flexWrap="wrap" rowGap="2">
            <BotonAccion accion="ver" label="Ver detalle" onClick={handleVer} />
            {cerrado
              ? onReabrir && (
                  <BotonAccion
                    accion="reabrir"
                    label="Reabrir incidente"
                    onClick={() => onReabrir(incidente)}
                  />
                )
              : onCerrar && (
                  <BotonAccion
                    accion="cerrar"
                    label="Cerrar incidente"
                    onClick={() => onCerrar(incidente)}
                  />
                )}
          </HStack>
        </Celda>
      )}
    </Table.Row>
  );
}
</file>

<file path="backend/src/checklist/router.py">
import logging
import os
from datetime import date, datetime
from typing import Optional, List, Union

from fastapi import APIRouter, Depends, Query, File, UploadFile, Form, HTTPException
from sqlalchemy.orm import Session
from werkzeug.utils import secure_filename

from src.common.paginacion import PAGE_SIZE_MAXIMO, PAGE_SIZE_POR_DEFECTO
from src.database import get_db
from src.auth.dependencies import require_operador, require_admin
from src.checklist import schemas, services
from src.config import CARPETA_UPLOADS
from src.personal.models import Personal


logger = logging.getLogger(__name__)

router = APIRouter(prefix="/checklist", tags=["checklist"])

# Ver el checklist del día y el historial de una tarea: requiere poder operar
# (HU "Ver checklist del día", "Marcar tarea con evidencia", "Registrar autoría").
_DEP_OPERAR = [Depends(require_operador)]

# Historial de checklists y consumo acumulado: solo quien administra
# (HU "Consultar historial de checklists" y "Registrar consumo de productos").
_DEP_ADMIN = [Depends(require_admin)]

# Extensiones y tamaño máximo permitido para la evidencia fotográfica.
EXTENSIONES_EVIDENCIA = {".jpg", ".jpeg", ".png", ".webp", ".gif"}
TAMANO_MAX_EVIDENCIA = 5 * 1024 * 1024  # 5 MB


def _guardar_evidencia(evidencia: Optional[UploadFile], tarea_id: int) -> Optional[str]:
    """Guarda la foto de evidencia y devuelve su ruta relativa.

    Sanea el nombre del archivo (evita path traversal) y valida extensión
    y tamaño antes de escribir en disco.
    """
    if evidencia is None or not evidencia.filename:
        return None

    extension = os.path.splitext(evidencia.filename)[1].lower()

    if extension not in EXTENSIONES_EVIDENCIA:
        raise HTTPException(
            status_code=400,
            detail=f"Formato de imagen no permitido ({extension or 'sin extensión'}). "
                   f"Formatos válidos: {', '.join(sorted(EXTENSIONES_EVIDENCIA))}.",
        )

    contenido = evidencia.file.read()
    evidencia.file.seek(0)

    if len(contenido) > TAMANO_MAX_EVIDENCIA:
        raise HTTPException(
            status_code=400,
            detail=f"La evidencia supera el máximo de "
                   f"{TAMANO_MAX_EVIDENCIA // (1024 * 1024)} MB.",
        )

    upload_dir = CARPETA_UPLOADS / "evidencias"
    upload_dir.mkdir(parents=True, exist_ok=True)

    # secure_filename elimina rutas y caracteres peligrosos del nombre original
    nombre_seguro = secure_filename(evidencia.filename) or "evidencia"
    nombre_archivo = (
        f"tarea_{tarea_id}_"
        f"{datetime.now().strftime('%Y%m%d%H%M%S')}_"
        f"{nombre_seguro}"
    )

    # Guardamos la ruta con "/" (no os.sep) para que sea la misma en la base y
    # en la URL, sin importar el sistema operativo donde corre el backend.
    # La carpeta se ancla a CARPETA_UPLOADS (raíz del backend) en lugar del
    # directorio de trabajo: si el server se arranca desde otro lado, con ruta
    # relativa la evidencia se guardaría en un uploads distinto al que sirve
    # GET /uploads y la imagen daría 404.
    ruta_evidencia = f"uploads/evidencias/{nombre_archivo}"
    ruta_absoluta = upload_dir / nombre_archivo

    with open(ruta_absoluta, "wb") as buffer:
        buffer.write(contenido)

    return ruta_evidencia


@router.get("/tareas-del-dia", response_model=schemas.TareasDelDiaResponse, dependencies=_DEP_OPERAR)
def listar_tareas_del_dia(

    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
):
    """Lista plana de las tareas de todos los equipos activos para una fecha,
    con el nombre del plan al que pertenece cada una. Reemplaza el patrón de
    pedir /checklist/hoy una vez por equipo desde el frontend."""
    logger.info(f"Consultando tareas del día para fecha {fecha}")
    return services.listar_tareas_del_dia(db, fecha)


@router.get("/equipo/{equipo_id}", response_model=List[schemas.ChecklistResponse], dependencies=_DEP_OPERAR)
def obtener_checklists_del_equipo(
    equipo_id: int,
    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
):
    """Uno o varios checklists (uno por plan vigente) para un equipo/máquina
    en una fecha puntual."""
    return services.obtener_o_crear_checklists_del_dia(db, equipo_id, fecha)

@router.patch("/tarea/{tarea_id}", response_model=schemas.RegistroTareaResponse, dependencies=_DEP_OPERAR)
def marcar_tarea(
    tarea_id: int,
    completado: bool = Form(...),
    evidencia: Optional[UploadFile] = File(None),

    # NUEVOS CAMPOS PARA EL CONSUMO
    insumo_quimico_id: Optional[int] = Form(None),
    cantidad_consumida: Optional[float] = Form(None, gt=0),
    elemento_limpieza_id: Optional[int] = Form(None),
    fecha: Optional[date] = Query(None),
    db: Session = Depends(get_db),
    # La autoría se toma del token: nunca del cuerpo de la request, para que
    # no se pueda atribuir una tarea a otro usuario (HU "Registrar autoría").
    current_user: Personal = Depends(require_operador),
):
    ruta_evidencia = _guardar_evidencia(evidencia, tarea_id)

    return services.marcar_tarea(
        db=db,
        tarea_id=tarea_id,
        completado=completado,
        usuario_id=current_user.id,
        evidencia_url=ruta_evidencia,
        fecha=fecha,
        insumo_quimico_id=insumo_quimico_id,
        cantidad_consumida=cantidad_consumida,
        elemento_limpieza_id=elemento_limpieza_id,
    )


@router.get("/registro/{registro_id}/historial", response_model=schemas.HistorialRegistroTareaResponse, dependencies=_DEP_OPERAR)
def obtener_historial_registro(registro_id: int, db: Session = Depends(get_db)):
    return services.obtener_historial_registro(db, registro_id)

@router.get(
    "/historial",
    response_model=Union[schemas.HistorialChecklistResponse, schemas.HistorialChecklistPagina],
    dependencies=_DEP_ADMIN,
)
def listar_historial_checklists(
    fecha_desde: date = Query(...),
    fecha_hasta: date = Query(...),
    equipo_id: Optional[int] = Query(None),
    page: Optional[int] = Query(
        None,
        ge=1,
        description="Número de página. Sin este parámetro se devuelve el historial completo del rango.",
    ),
    page_size: int = Query(PAGE_SIZE_POR_DEFECTO, ge=1, le=PAGE_SIZE_MAXIMO),
    db: Session = Depends(get_db),
):
    """Historial de checklists en un rango de fechas, con % de
    cumplimiento y detalle de tareas incumplidas (Historia #13)."""
    return services.listar_historial_checklists(
        db, fecha_desde, fecha_hasta, equipo_id, page, page_size
    )


@router.get(
    "/historial/{checklist_id}",
    response_model=schemas.DetalleChecklistResponse,
    dependencies=_DEP_ADMIN,
)
def obtener_detalle_checklist(
    checklist_id: int,
    db: Session = Depends(get_db),
):
    """Detalle de solo lectura de un checklist incluido en el historial."""
    return services.obtener_detalle_checklist(db, checklist_id)


@router.get("/consumo", response_model=schemas.ConsumoInsumosResponse, dependencies=_DEP_ADMIN)
def listar_consumo(
    fecha_desde: date = Query(...),
    fecha_hasta: date = Query(...),
    db: Session = Depends(get_db),
):
    """Consumo acumulado de productos de limpieza por producto y por fecha
    (Historia #10, criterio de aceptación 4)."""
    return services.listar_consumo_insumos(db, fecha_desde, fecha_hasta)
</file>

