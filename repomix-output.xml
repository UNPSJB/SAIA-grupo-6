                children: [
                  {
                    index: true,
                    element: <Navigate to="/gestion-stock/stock" replace />,
                  },
                  {
                    path: "stock",
                    element: (
                      <ConSuspense>
                        <StockActualTab />
                      </ConSuspense>
                    ),
                  },
                  {
                    path: "movimientos",
                    element: (
                      <ConSuspense>
                        <MovimientosStockTab />
                      </ConSuspense>
                    ),
                  },
                  {
                    path: "lotes",
                    element: (
                      <ConSuspense>
                        <LotesStockTab />
                      </ConSuspense>
                    ),
                  },
                  {
                    path: "consumos",
                    element: (
                      <ConSuspense>
                        <ConsumoInsumosPage />
                      </ConSuspense>
                    ),
                  },
                ],
              },

              // ---------------- PROVEEDORES ----------------
              {
