        db,
        Aptitud,
        "nombre",
        datos.nombre,
        ya_existe=exceptions.AptitudYaExiste,
        etiqueta="aptitud",
        femenina=True,
    )

    nueva = Aptitud(**datos.model_dump())
    db.add(nueva)
    return guardar(db, nueva, _MAPEA_CONFLICTO)


